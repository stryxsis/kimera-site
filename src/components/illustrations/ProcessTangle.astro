---
/**
 * ILL-06 — «il groviglio».
 *
 * Cinque percorsi partono da punti diversi, si incrociano senza nessun ordine
 * e finiscono per convergere in un solo nodo: da lì esce una linea sola. È la
 * pagina Servizi detta in un'immagine — a sinistra il carico che lo studente
 * si trova addosso, a destra ciò che Kimere vende davvero, cioè che quel
 * carico diventi una sequenza.
 *
 * Deliberatamente SENZA testo dentro l'SVG, a differenza di ILL-01 e ILL-02:
 * i nomi degli enti sono contenuto tradotto, e un `<text>` non va a capo — il
 * primo termine italiano più lungo del suo equivalente inglese uscirebbe dal
 * riquadro. Qui l'informazione la portano le schede accanto; questo disegno
 * è decorazione e si dichiara tale (`aria-hidden`), così chi usa uno screen
 * reader non si sente leggere un'immagine che non dice nulla di nuovo.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['tangle', className]}
  viewBox="0 0 480 300"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {/* I cinque percorsi. Nessuno arriva dritto, tutti si incrociano. */}
  <path class="tangle__line" d="M16 40C96 40 66 180 156 175c90-5 50-115 140-95 54 10 76 48 104 70" />
  <path class="tangle__line" d="M16 95c70 0 100-70 165-50 75 23 30 155 120 160 55 3 79-33 99-55" />
  <path class="tangle__line" d="M16 150c60 0 75 85 155 90 90 5 50-145 135-130 50 9 74 28 94 40" />
  <path class="tangle__line" d="M16 205c85 0 65-125 160-110 80 13 60 140 140 145 46 3 70-60 84-90" />
  <path class="tangle__line" d="M16 260c90 0 120-110 190-120 65-10 50-85 120-80 42 4 60 52 74 90" />

  {/* Le cinque partenze: enti diversi, nessuno collegato agli altri. */}
  <circle class="tangle__origin" cx="16" cy="40" r="4.5"></circle>
  <circle class="tangle__origin" cx="16" cy="95" r="4.5"></circle>
  <circle class="tangle__origin" cx="16" cy="150" r="4.5"></circle>
  <circle class="tangle__origin" cx="16" cy="205" r="4.5"></circle>
  <circle class="tangle__origin" cx="16" cy="260" r="4.5"></circle>

  {/* Il punto in cui il groviglio diventa una sequenza sola. */}
  <circle class="tangle__hub" cx="400" cy="150" r="7"></circle>
  <path class="tangle__out" d="M409 150h43"></path>
  <path class="tangle__out" d="m444 142 8 8-8 8"></path>
</svg>

<style>
  .tangle {
    display: block;
    width: 100%;
    height: auto;
  }
  /* Tenui e sottili: il groviglio deve leggersi come rumore, non come dato. */
  .tangle__line {
    stroke: var(--color-teal);
    stroke-width: 1.6;
    opacity: 0.5;
  }
  .tangle__origin {
    stroke: var(--color-teal);
    stroke-width: 1.6;
    /* Il nodo vuoto si buca sul fondo su cui poggia, come in ILL-01. */
    fill: var(--surface-bg);
  }
  /* L'unico elemento pieno del disegno è il punto in cui il caos finisce. */
  .tangle__hub {
    fill: var(--surface-accent);
  }
  .tangle__out {
    stroke: var(--surface-accent);
    stroke-width: 3;
  }
</style>
