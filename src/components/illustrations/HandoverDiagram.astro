---
/**
 * ILL-04 — il modello di collaborazione B2B (pagina Partnerships).
 *
 * Due blocchi e un punto di consegna al centro. Il confine è dichiarato una
 * volta sola e non è negoziabile: voi reclutate nel vostro paese, da lì in poi
 * la pratica è nostra. Su una pagina che parla a chi deve valutare il rischio
 * di una partnership, un confine ambiguo vale meno di nessun diagramma.
 *
 * I due lati sono schede vere e non due elenchi affiancati: qui il diagramma è
 * l'accordo commerciale, ed è l'elemento che deve pesare di più nella pagina.
 * Tutti i colori passano dai token `--surface-*`, così il componente regge sia
 * il fondo chiaro di Partnerships sia la fascia scura dello styleguide senza
 * una variante per superficie.
 */
interface Props {
  theirTitle: string;
  theirItems: string[];
  handover: string;
  ourTitle: string;
  ourItems: string[];
  class?: string;
}

const { theirTitle, theirItems, handover, ourTitle, ourItems, class: className } = Astro.props;
---

<figure class:list={['handover', className]}>
  <div class="handover__side">
    <h3 class="handover__title handover__title--theirs">{theirTitle}</h3>
    <ul class="handover__list">{theirItems.map((item) => <li>{item}</li>)}</ul>
  </div>

  <div class="handover__pivot">
    <span class="handover__node" aria-hidden="true"></span>
    <p class="handover__label">{handover}</p>
  </div>

  {/* Il lato Kimere porta più voci e più peso: è la parte che si sta vendendo. */}
  <div class="handover__side handover__side--ours">
    <h3 class="handover__title">{ourTitle}</h3>
    <ul class="handover__list">{ourItems.map((item) => <li>{item}</li>)}</ul>
  </div>
</figure>

<style>
  .handover {
    display: grid;
    gap: 1rem;
    margin: 0;
    align-items: stretch;
  }

  .handover__side {
    background-color: var(--surface-raised);
    border: 1px solid var(--surface-rule);
    border-radius: var(--radius-xl);
    padding: clamp(1.35rem, 2.4vw, 1.9rem);
  }
  /* Il lato Kimere si stacca dal bordo, non da un colore diverso: resta uno dei
     due blocchi dell'accordo, non un'offerta a parte. */
  .handover__side--ours {
    border-color: var(--surface-rule-strong);
    box-shadow: var(--shadow-card);
  }

  .handover__title {
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }
  /* Il lato del partner è la loro metà del confine, non l'argomento della
     pagina: stessa struttura, un grado di enfasi in meno. */
  .handover__title--theirs {
    color: var(--surface-fg-muted);
  }

  .handover__list {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }
  .handover__list li {
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--surface-fg-soft);
    padding-left: 1.15rem;
    position: relative;
  }
  .handover__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 1px;
    background-color: var(--surface-accent);
  }

  /* Il perno: sotto le 52rem è un filetto orizzontale fra i due blocchi
     impilati, sopra diventa la guida verticale che separa le due colonne. */
  .handover__pivot {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.25rem 0;
  }
  .handover__node {
    flex: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background-color: var(--surface-accent);
    /* l'alone lo tiene visibile anche dove il filetto è quasi trasparente */
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--surface-accent) 18%, transparent);
  }
  .handover__label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }

  @media (min-width: 52rem) {
    .handover {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.15fr);
      gap: 1.5rem;
      align-items: center;
    }
    .handover__pivot {
      flex-direction: column;
      align-self: stretch;
      justify-content: center;
      text-align: center;
      padding: 1.5rem 0.5rem;
      gap: 1.1rem;
      position: relative;
    }
    /* La guida verticale è disegnata, non è un `border`: così il nodo può
       starci sopra al centro invece che accanto. */
    .handover__pivot::before {
      content: '';
      position: absolute;
      inset-block: 0;
      left: 50%;
      width: 1px;
      transform: translateX(-50%);
      background-color: var(--surface-rule);
    }
    .handover__node,
    .handover__label {
      position: relative;
    }
    .handover__label {
      writing-mode: vertical-rl;
    }
  }
</style>
