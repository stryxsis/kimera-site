---
/**
 * ILL-04 — il modello di collaborazione B2B (Partners R2).
 *
 * Due colonne e un punto di consegna al centro. Il confine è dichiarato una
 * volta sola e non è negoziabile: voi reclutate nel vostro paese, da lì in poi
 * la pratica è nostra. Su una pagina che parla a chi deve valutare il rischio
 * di una partnership, un confine ambiguo vale meno di nessun diagramma.
 */
interface Props {
  theirTitle: string;
  theirItems: string[];
  handover: string;
  ourTitle: string;
  ourItems: string[];
  class?: string;
}

const { theirTitle, theirItems, handover, ourTitle, ourItems, class: className } = Astro.props;
---

<figure class:list={['handover', className]}>
  <div class="handover__side">
    <h3 class="label label-muted">{theirTitle}</h3>
    <ul>{theirItems.map((item) => <li>{item}</li>)}</ul>
  </div>

  <div class="handover__pivot">
    <span class="handover__node" aria-hidden="true"></span>
    <p class="handover__label">{handover}</p>
  </div>

  <div class="handover__side">
    <h3 class="label">{ourTitle}</h3>
    <ul>{ourItems.map((item) => <li>{item}</li>)}</ul>
  </div>
</figure>

<style>
  .handover {
    display: grid;
    gap: 1.5rem;
    margin: 0;
  }
  .handover__side ul {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .handover__side li {
    font-size: var(--text-sm);
    color: var(--surface-fg-soft);
    padding-left: 0.95rem;
    position: relative;
  }
  .handover__side li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background-color: var(--color-teal);
  }

  .handover__pivot {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 0;
    border-block: 1px solid var(--surface-rule);
  }
  .handover__node {
    flex: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background-color: var(--surface-accent);
  }
  .handover__label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }

  @media (min-width: 52rem) {
    .handover {
      grid-template-columns: 1fr auto 1fr;
      gap: 2.5rem;
      align-items: start;
    }
    .handover__pivot {
      flex-direction: column;
      align-self: stretch;
      justify-content: center;
      text-align: center;
      padding: 0 1.5rem;
      border-block: 0;
      border-inline: 1px solid var(--surface-rule);
    }
    .handover__label {
      writing-mode: vertical-rl;
    }
  }
</style>
