---
import type { Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';

/**
 * Primo elemento focalizzabile della pagina: salta header e navigazione.
 * Nascosto finché non riceve il focus da tastiera — non `display:none`, che
 * lo toglierebbe anche dall'ordine di tabulazione e lo renderebbe inutile.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<a class="skip-link" href="#main-content">{t.skipToContent}</a>

<style>
  /* Discreto di proposito: chi lo vede lo sta già raggiungendo con Tab, quindi
     non serve gridare — basta essere leggibile. `ink` su `blank` è la stessa
     coppia già verificata come testo corrente in check-contrast.mjs (4.5+),
     non l'oro acceso usato altrove per i richiami che DEVONO saltare all'occhio. */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background-color: var(--color-ink);
    color: var(--color-blank);
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.5rem 0.85rem;
    border-radius: var(--radius-xs);
    text-decoration: none;
  }
  .skip-link:focus {
    left: 0.6rem;
    top: 0.6rem;
    position: fixed;
  }
</style>
