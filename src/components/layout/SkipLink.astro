---
import type { Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';

/**
 * Primo elemento focalizzabile della pagina: salta header e navigazione.
 *
 * ⚠️ Nascosto SEMPRE, anche quando riceve il focus — su richiesta esplicita,
 * consapevole del compromesso: chi usa uno screen reader lo sente e lo attiva
 * comunque (resta nel DOM e nell'albero di accessibilità, non è `display:none`
 * né `aria-hidden`), ma chi naviga da tastiera guardando lo schermo perde
 * l'indicatore visivo di dover essere arrivato lì. Nessun impatto SEO: i motori
 * di ricerca leggono l'HTML, non gli stati `:focus` del CSS.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<a class="skip-link" href="#main-content">{t.skipToContent}</a>

<style>
  /* Stessa tecnica di `.sr-only` usata altrove nel progetto (about.astro,
     partners.astro): un riquadro di 1px, ritagliato al 50% su ogni lato —
     invisibile ma ancora presente per chi usa uno screen reader, a differenza
     di `display:none`/`aria-hidden`, che lo toglierebbero dall'albero di
     accessibilità e lo renderebbero inutile anche per chi ne ha bisogno. */
  .skip-link {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Nessuna comparsa al focus: l'anello di `:focus-visible` (global.css) su un
     riquadro di 1px sarebbe comunque un puntino visibile, quindi va spento qui. */
  .skip-link:focus-visible {
    outline: none;
  }
</style>
