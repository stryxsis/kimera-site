---
import { getPath, type Locale, type RouteKey } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
  currentRouteKey: RouteKey;
}

const { locale, currentRouteKey } = Astro.props;
const t = useTranslations(locale);

// FAQ resta fuori dal menu: si raggiunge dal contesto (sitemap-ia.md §3).
// Tipo dedicato (sottoinsieme di RouteKey) perché solo queste chiavi esistono in t.nav.
//
// ⚠️ `forStudents` e `languageCourses` non hanno ancora una pagina propria
// (routes.ts, 2026-08-11): il link esiste già, la pagina arriva dopo. Servizi
// e Perché l'Italia restano pubblicate e raggiungibili (footer, box della
// home) ma non sono più in questo menu — è il nuovo ordine richiesto, non una
// rimozione delle pagine stesse.
type MenuRouteKey = 'home' | 'about' | 'forStudents' | 'partners' | 'languageCourses';
const items: MenuRouteKey[] = ['home', 'about', 'forStudents', 'partners', 'languageCourses'];
---

<nav class="nav" aria-label={t.nav.primaryLabel}>
  <ul class="nav__list">
    {
      items.map((key) => (
        <li>
          <a
            class="nav__link"
            href={getPath(key, locale)}
            aria-current={key === currentRouteKey ? 'page' : undefined}
          >
            {t.nav[key]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nav__list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__link {
    display: block;
    padding: 0.55rem 0;
    font-family: var(--font-titling);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--surface-fg);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }
  .nav__link:hover {
    color: var(--surface-accent);
  }
  /* La pagina corrente è marcata dal colore E da un filetto: il colore da solo
     non basta come unico veicolo d'informazione (WCAG 1.4.1). */
  .nav__link[aria-current='page'] {
    color: var(--surface-accent);
    border-bottom-color: var(--surface-accent);
  }

  @media (min-width: 64rem) {
    .nav__list {
      flex-direction: row;
      gap: 1.5rem;
    }
    .nav__link {
      padding: 0.15rem 0;
    }
  }
</style>
