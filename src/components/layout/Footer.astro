---
import { getPath, BOOKING_FORM_URL, type Locale } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import Logo from '../brand/Logo.astro';
import LogoMark from '../brand/LogoMark.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer surface-mist">
  <!-- ILL-06 — la rosa dei venti del logo come filigrana, non come texture ripetuta:
       un motivo tassellato su una superficie navy legge come carta da parati.
       Decorativa, quindi aria-hidden e fuori dal flusso. -->
  <LogoMark detail="full" mono class="site-footer__watermark" />

  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <Logo locale={locale} variant="full" />
    </div>

    <nav class="site-footer__nav" aria-label={t.footer.navLabel}>
      <div class="site-footer__col">
        <h2 class="label label-muted">{t.footer.columnKimere}</h2>
        <ul>
          <li><a href={getPath('about', locale)}>{t.nav.about}</a></li>
          <li><a href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer">{t.footer.contact}</a></li>
          <!-- URL social non ancora confermati dal cliente (PROGRESS.md, questione #7) -->
          <li><a href="#" translate="no">Instagram</a></li>
          <li><a href="#" translate="no">LinkedIn</a></li>
          <li><a href="#" translate="no">Facebook</a></li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h2 class="label label-muted">{t.footer.columnStudents}</h2>
        <ul>
          <li><a href={getPath('forStudents', locale)}>{t.nav.forStudents}</a></li>
          <li><a href={getPath('studyInItaly', locale)}>{t.nav.studyInItaly}</a></li>
          <li><a href={getPath('services', locale)}>{t.nav.services}</a></li>
          <li><a href={getPath('faq', locale)}>{t.nav.faq}</a></li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h2 class="label label-muted">{t.footer.columnPartners}</h2>
        <ul>
          <li><a href={getPath('partners', locale)}>{t.nav.partners}</a></li>
          <li><a href="#" translate="no">LinkedIn</a></li>
        </ul>
      </div>

      <div class="site-footer__col">
        <h2 class="label label-muted">{t.footer.columnLegal}</h2>
        <ul>
          <li><a href={getPath('privacy', locale)}>{t.footer.privacy}</a></li>
          <li><a href={getPath('cookies', locale)}>{t.footer.cookies}</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="wrap site-footer__base">
    <!-- Disclaimer legale globale: contenuti informativi, non consulenza (content-map.md ⚖️). -->
    <p class="site-footer__disclaimer">{t.footer.disclaimer}</p>
    <p class="site-footer__copy">
      <span translate="no">&copy; {year} Kimere International Academy &amp; Consulting.</span>
      <span>{t.footer.rightsReserved}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--surface-line);
    padding-block: var(--spacing-section) 2rem;
  }
  .site-footer :global(.site-footer__watermark) {
    /* Sul chiaro la filigrana va scurita, non schiarita: a 0.035 di bianco
       su nebbia sarebbe invisibile. */
    color: var(--color-ink);
    opacity: 0.05;
  }

  .site-footer__inner {
    position: relative;
    display: grid;
    gap: 2.75rem;
  }
  .site-footer__brand {
    max-width: 22rem;
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 2rem 1.5rem;
  }
  .site-footer__col ul {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .site-footer__col a {
    font-family: var(--font-titling);
    font-size: var(--text-sm);
    color: var(--surface-fg-soft);
    text-decoration: none;
  }
  .site-footer__col a:hover {
    color: var(--surface-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__base {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 3rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--surface-rule);
  }
  .site-footer__disclaimer {
    font-size: var(--text-xs);
    color: var(--surface-fg-muted);
    max-width: 46ch;
    margin: 0;
  }
  .site-footer__copy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--surface-fg-muted);
    margin: 0;
  }

  @media (min-width: 60rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
      gap: 4rem;
    }
    .site-footer__base {
      flex-wrap: nowrap;
      align-items: baseline;
    }
  }
</style>
