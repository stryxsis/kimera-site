---
import { getPath, BOOKING_FORM_URL, type Locale, type RouteKey } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import Logo from '../brand/Logo.astro';
import Nav from './Nav.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Button from '../ui/Button.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  /**
   * Per pagine con una hero a piena altezza che deve iniziare esattamente a
   * y=0: l'header non riserva più spazio nel flusso (`position: fixed` invece
   * di `sticky`) e galleggia sopra il primo tratto della hero, che è comunque
   * più alta della barra stessa. Ogni altra pagina resta `sticky` come prima:
   * questa prop cambia SOLO la pagina che la passa, non il comportamento
   * globale dell'header.
   */
  overlay?: boolean;
}

const { locale, routeKey, overlay = false } = Astro.props;
const t = useTranslations(locale);
---

<header class:list={['site-header surface-blank', overlay && 'site-header--overlay']}>
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href={getPath('home', locale)}>
      <Logo locale={locale} />
    </a>

    <!-- Il bottone nasce hidden e viene mostrato dallo script: senza JavaScript
         il pannello resta aperto in colonna invece di diventare irraggiungibile. -->
    <button
      class="site-header__toggle"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="site-menu"
      hidden
    >
      <span class="site-header__bars" aria-hidden="true"></span>
      <span>{t.nav.menu}</span>
    </button>

    <div class="site-header__menu" id="site-menu">
      <Nav locale={locale} currentRouteKey={routeKey} />

      <div class="site-header__actions">
        <LanguageSwitcher currentLocale={locale} currentRouteKey={routeKey} />
        <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" variant="pill" size="sm" arrow>
          {t.cta.bookCall}
        </Button>
      </div>
    </div>
  </div>
</header>

<style>
  /* Sticky con sfondo semitrasparente: nei riferimenti la barra resta sempre
     raggiungibile e il contenuto le scorre sotto. Il blur è un miglioramento
     progressivo — dove manca resta il colore pieno del fallback. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--surface-line);
    background-color: color-mix(in srgb, var(--color-blank) 88%, transparent);
    backdrop-filter: blur(12px);
  }
  @supports not (backdrop-filter: blur(12px)) {
    .site-header {
      background-color: var(--color-blank);
    }
  }
  /* `fixed` invece di `sticky`: rimosso dal flusso, la pagina non gli riserva
     più la propria altezza e la sezione che segue nel markup (la hero) parte
     da y=0 con la barra che le galleggia sopra. `sticky` non basta perché
     resta comunque IN flusso finché non si scorre oltre la propria altezza —
     è esattamente lo spazio vuoto che questa variante deve togliere. */
  .site-header--overlay {
    position: fixed;
    inset-inline: 0;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    /* Il logo compatto (1.1rem + due righe di testo minuscolo) è l'elemento più
       alto della barra: questo padding è quanto basta a non farlo toccare i bordi. */
    padding-block: 0.55rem;
  }
  .site-header__brand {
    text-decoration: none;
    margin-right: auto;
  }

  /*
   * Area toccabile estesa su logo e bottone del menu, SENZA alzare la barra.
   *
   * Misurati su un telefono a 375px erano 70x26 e 89x27: molto sotto i 44px
   * raccomandati, ed è il bottone del menu a pagarla più cara, perché su
   * mobile è l'unico modo di raggiungere la navigazione. Alzare gli elementi
   * risolverebbe il tocco ma rifarebbe crescere la barra, che è esattamente
   * ciò che era stato chiesto di ridurre.
   *
   * Lo pseudo-elemento vive fuori dal flusso: allarga la zona che intercetta
   * il dito senza occupare un pixel di layout. Il bottone e il link sono già
   * `position: relative` per via del contesto, che qui va dichiarato.
   */
  @media (pointer: coarse) {
    .site-header__brand,
    .site-header__toggle {
      position: relative;
    }
    .site-header__brand::after,
    .site-header__toggle::after {
      content: '';
      position: absolute;
      inset-inline: -0.35rem;
      top: 50%;
      height: 2.75rem;
      transform: translateY(-50%);
    }
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: none;
    border: 1px solid var(--surface-line);
    border-radius: var(--radius-pill);
    color: var(--surface-fg);
    font: 600 var(--text-xs) / 1 var(--font-titling);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* Tenuto vicino all'altezza del logo ridotto: altrimenti su mobile è
       questo bottone, e non più il lockup, a dettare l'altezza della barra. */
    padding: 0.42rem 0.8rem;
    cursor: pointer;
  }
  .site-header__bars,
  .site-header__bars::before,
  .site-header__bars::after {
    display: block;
    width: 0.95rem;
    height: 1px;
    background-color: currentColor;
    transition: transform var(--duration-base) var(--ease-out-quart);
  }
  .site-header__bars {
    position: relative;
  }
  .site-header__bars::before,
  .site-header__bars::after {
    content: '';
    position: absolute;
  }
  .site-header__bars::before {
    top: -5px;
  }
  .site-header__bars::after {
    top: 5px;
  }
  [aria-expanded='true'] .site-header__bars {
    background-color: transparent;
  }
  [aria-expanded='true'] .site-header__bars::before {
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded='true'] .site-header__bars::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  .site-header__menu {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    padding-block: 0.5rem 1rem;
  }
  /* data-collapsed lo mette lo script: senza JS questa regola non si attiva mai. */
  .site-header__menu[data-collapsed]:not([data-open]) {
    display: none;
  }

  .site-header__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid var(--surface-rule);
  }
  @media (min-width: 64rem) {
    .site-header__inner {
      flex-wrap: nowrap;
      gap: 2rem;
    }
    .site-header__toggle {
      display: none !important;
    }
    .site-header__menu,
    .site-header__menu[data-collapsed] {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: 2rem;
      width: auto;
      padding-block: 0;
    }
    .site-header__actions {
      padding-top: 0;
      border-top: 0;
      gap: 1rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('site-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
    };

    // La soglia deve combaciare con @media (min-width: 64rem) qui sopra: sopra
    // quella soglia il pannello non deve mai portare data-collapsed, altrimenti
    // la regola mobile ":not([data-open])" (più specifica) vince comunque sulla
    // regola desktop "display: flex" della media query.
    const desktop = window.matchMedia('(min-width: 64rem)');

    const syncWithViewport = (isDesktop: boolean): void => {
      if (isDesktop) {
        toggle.hidden = true;
        menu.removeAttribute('data-collapsed');
        setOpen(false);
      } else {
        toggle.hidden = false;
        menu.setAttribute('data-collapsed', '');
      }
    };

    syncWithViewport(desktop.matches);
    desktop.addEventListener('change', (event) => syncWithViewport(event.matches));

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
