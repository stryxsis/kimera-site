---
/**
 * Bottone / link d'azione.
 *
 * `primary` è oro con testo navy: 6.62 di contrasto, ed è l'unica variante che
 * funziona identica su superficie chiara e scura, perché non dipende dal fondo.
 * `secondary` e `quiet` leggono --surface-* e quindi si ricolorano da sole
 * (accento oro su scuro, teal su chiaro).
 *
 * Renderizza <a> se c'è href, altrimenti <button>. Il testo non è mai
 * un'etichetta di sistema: verbo + risultato (brand-brief.md §5).
 */
interface Props {
  href?: string;
  /**
   * `pill` e `pill-ghost` appartengono al restyle: pastiglia piena navy e sua
   * controparte in bianco con bordo. Non sostituiscono `primary` — le pagine
   * non ancora ristilate continuano a usare l'oro.
   */
  variant?: 'primary' | 'secondary' | 'quiet' | 'pill' | 'pill-ghost';
  size?: 'md' | 'sm' | 'lg';
  type?: 'button' | 'submit';
  disabled?: boolean;
  /** La freccia dei riferimenti. Decorativa: il verbo lo porta già il testo. */
  arrow?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  disabled = false,
  arrow = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
const tagProps = href ? { href } : { type, disabled };
---

<Tag class={classes} {...tagProps} {...rest}>
  <slot />
  {
    arrow && (
      <svg
        class="btn__arrow"
        viewBox="0 0 16 16"
        width="15"
        height="15"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />
      </svg>
    )
  }
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out-quart),
      border-color var(--duration-fast) var(--ease-out-quart),
      color var(--duration-fast) var(--ease-out-quart);
  }

  .btn--md {
    font-size: var(--text-sm);
    padding: 0.85rem 1.45rem;
  }
  .btn--sm {
    font-size: var(--text-xs);
    padding: 0.58rem 1rem;
  }
  .btn--lg {
    font-size: var(--text-base);
    padding: 1rem 1.9rem;
  }

  /* Su un puntatore grossolano — il dito — le altezze disegnate per il mouse
     non bastano: misurate su un telefono a 375px, `btn--md` risulta alta 36px
     e `btn--sm` 34px, sotto i 44 raccomandati da Apple e Google. Si corregge
     con `min-height` e non con più padding, così il testo dentro il bottone
     resta dove il disegno lo vuole e cambia solo l'area toccabile.
     `pointer: coarse` invece di una larghezza: la soglia giusta è il dito, non
     lo schermo — un tablet grande ha lo stesso problema di un telefono. */
  @media (pointer: coarse) {
    /* Tutte le taglie alla stessa soglia, `sm` compresa: «piccolo» è una
       nozione da mouse, e su un telefono il bottone piccolo è quasi sempre
       una CTA di smistamento — sbagliarlo costa quanto sbagliare gli altri. */
    .btn {
      min-height: 2.75rem;
    }
  }

  /* ── Pastiglie del restyle ──────────────────────────────────────────── */
  .btn--pill,
  .btn--pill-ghost {
    font-family: var(--font-titling);
    font-weight: 600;
    border-radius: var(--radius-pill);
    letter-spacing: -0.005em;
  }
  .btn--pill {
    background-color: var(--color-ink);
    color: var(--color-blank);
  }
  .btn--pill:hover {
    background-color: var(--color-ground);
  }
  .btn--pill-ghost {
    background-color: var(--color-blank);
    color: var(--color-ink);
    border-color: var(--color-mist-line);
    box-shadow: var(--shadow-card);
  }
  .btn--pill-ghost:hover {
    border-color: var(--color-ink);
  }

  /* La freccia scorre di poco all'hover: conferma il gesto senza spostare
     il testo, e sparisce per chi ha chiesto meno movimento. */
  .btn__arrow {
    flex: none;
    transition: transform var(--duration-base) var(--ease-out-quart);
  }
  .btn:hover .btn__arrow {
    transform: translateX(3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .btn__arrow {
      transition: none;
    }
    .btn:hover .btn__arrow {
      transform: none;
    }
  }

  /* Oro con testo navy — 6.62, AA. Identico su ogni superficie. */
  .btn--primary {
    background-color: var(--color-gold);
    color: var(--color-ground);
  }
  .btn--primary:hover {
    background-color: var(--color-gold-bright);
  }

  .btn--secondary {
    background-color: transparent;
    color: var(--surface-fg);
    border-color: var(--surface-line);
  }
  .btn--secondary:hover {
    border-color: var(--surface-accent);
    color: var(--surface-accent);
  }

  .btn--quiet {
    background-color: transparent;
    color: var(--surface-accent);
    padding-inline: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }
  .btn--quiet:hover {
    text-decoration-thickness: 2px;
  }

  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .btn:disabled:hover {
    background-color: var(--color-gold);
  }
</style>
