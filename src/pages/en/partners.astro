---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { getPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import { sortedCountryOptions } from '../../lib/countries';
import { describedBy } from '../../lib/field';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Field from '../../components/ui/Field.astro';
import Input from '../../components/ui/Input.astro';
import ChoiceGroup from '../../components/ui/ChoiceGroup.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';
import CorridorFlow from '../../components/illustrations/CorridorFlow.astro';
import HandoverDiagram from '../../components/illustrations/HandoverDiagram.astro';
import MultiStepForm from '../../components/forms/MultiStepForm.astro';

/**
 * Partnerships — l'unica pagina del sito che non parla allo studente. Il lettore
 * è chi dirige un'agenzia di reclutamento estera o un ufficio international: legge
 * volumi, rischio e margine, e ha già respinto una dozzina di partner di
 * destinazione prima di arrivare qui.
 *
 * Tre conseguenze sul progetto della pagina, tutte deliberate.
 *
 * PRIMA: la CTA NON porta al form Google della call studenti. Una richiesta di
 * partnership non è una consulenza da quindici minuti, e mandare un direttore
 * d'agenzia nello stesso imbuto del diciannovenne è il modo più rapido di
 * dichiarare che non si distingue fra i due. Tutte le CTA puntano al form B2B in
 * fondo alla pagina, che qualifica il partner prima della riunione.
 *
 * SECONDA: la due diligence sta PRIMA del form, non dopo. Un'agenzia scopre
 * comunque che Kimere opera da giugno 2026 e non ha accreditamenti; scoprirlo da
 * sé dopo aver letto tre schermate di promesse ferma la trattativa. Dirlo per
 * primi, accanto a ciò che invece si mette per iscritto, la fa proseguire.
 *
 * TERZA: nessun operatore terzo è nominato, da nessuna parte. Il brief chiedeva
 * di citare due catene di studentati per nome: non esiste alcun rapporto con
 * loro, e scriverlo sarebbe pubblicità ingannevole verso il lettore che verifica
 * per mestiere. L'invito è aperto e per categoria (vedi `otherPartners`).
 *
 * Il ritmo delle superfici segue Servizi, che ha lo stesso compito commerciale:
 * bianco → NAVY (il mercato) → bianco (il modello) → nebbia (i vantaggi) →
 * bianco (gli altri interlocutori) → nebbia (come si comincia) → NAVY (il form).
 */
const locale = 'en';
const t = useTranslations(locale);
const { data: content } = await getEntry('partnersPage', locale)!;
const { data: countryNames } = await getEntry('countries', locale)!;
const countries = sortedCountryOptions(countryNames, locale);

/**
 * Form B2B: a differenza di quello studente NON è multi-step — un solo schermo.
 * MultiStepForm riceve un solo `[data-step]` e disattiva da sé la progressione.
 */
const FIELDS = [
  'contact-name',
  'role',
  'agency',
  'country',
  'website',
  'work-email',
  'volume-bracket',
  'destinations-served',
  'interest',
  'notes',
  'privacy-consent',
];
---

<PageLayout
  locale={locale}
  routeKey="partners"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
>
  <div class="partners surface-blank">
    {/* ── Hero B2B ─────────────────────────────────────────────────────── */}
    <section class="wrap hero">
      <div class="hero__intro">
        <Eyebrow class="animate-rise">{content.hero.eyebrow}</Eyebrow>
        <h1 class="heading-display hero__title animate-rise" style="animation-delay:60ms">
          {content.hero.headline}
        </h1>
        <p class="lead-soft hero__lead animate-rise" style="animation-delay:120ms">
          {content.hero.subhead}
        </p>
        <div class="hero__actions animate-rise" style="animation-delay:180ms">
          <Button href="#partner-form" variant="pill" size="lg" arrow>
            {content.hero.ctaPrimary}
          </Button>
          <Button href="#model" variant="pill-ghost" size="lg">
            {content.hero.ctaSecondary}
          </Button>
        </div>
      </div>

      {/* ILL-09 — decorazione: sotto le 64rem sparisce invece di schiacciarsi,
          e non si perde nessuna informazione perché non ne porta. */}
      <div class="hero__art animate-rise" style="animation-delay:240ms">
        <CorridorFlow />
      </div>
    </section>

    {
      /* ── L'opportunità di mercato ───────────────────────────────────────
        Ogni cifra qui è una che «Perché l'Italia» già dichiara con la sua
        fonte. I conteggi di studenti internazionali e di corsi disponibili
        chiesti dal brief sono rimasti fuori: erano già stati esclusi da
        quella pagina perché non verificabili, e un dato che non regge su
        una pagina B2B non è un'imprecisione, è la fine della trattativa. */
    }
    <section class="wrap band" aria-labelledby="market-heading">
      <div class="panel-dark surface-dark">
        <div class="head">
          <Eyebrow tone="gold">{content.market.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="market-heading">{content.market.heading}</h2>
          <p class="lead-soft">{content.market.body}</p>
        </div>

        <ul class="metrics">
          {
            content.market.metrics.map((metric) => (
              <li class="metric">
                <span class="metric__value">{metric.value}</span>
                <span class="metric__label">{metric.label}</span>
              </li>
            ))
          }
        </ul>

        <div class="market__foot">
          <ul class="checklist market__points">
            {content.market.points.map((point) => <li>{point}</li>)}
          </ul>

          <p class="market__links">
            <a class="market__link" href={getPath('studyInItaly', locale)}>
              {content.market.linkLabel}
            </a>
            <a
              class="market__link"
              href={content.market.officialSource}
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.process.officialSource}
              <svg
                viewBox="0 0 14 14"
                width="12"
                height="12"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M5 2h7v7M12 2 3 11" />
              </svg>
            </a>
          </p>
        </div>
      </div>
    </section>

    {
      /* ── Il modello ─────────────────────────────────────────────────────
        Il cuore dell'accordo. ILL-04 disegna il confine, e subito sotto
        stanno gli impegni che lo rendono firmabile — a partire dal solo che
        conta davvero per chi legge: non andiamo a prenderci i vostri
        studenti. Sono impegni che Kimere prende su di sé, non affermazioni
        su terzi, quindi si possono pubblicare. */
    }
    <section class="wrap band" id="model" aria-labelledby="model-heading">
      <div class="head">
        <Eyebrow>{content.model.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="model-heading">{content.model.heading}</h2>
        <p class="lead-soft">{content.model.body}</p>
      </div>

      <HandoverDiagram
        theirTitle={content.model.handover.theirLabel}
        theirItems={content.model.handover.theirItems}
        handover={content.model.handover.handoverLabel}
        ourTitle={content.model.handover.ourLabel}
        ourItems={content.model.handover.ourItems}
      />

      <div class="commitments">
        <h3 class="heading-card commitments__title">{content.model.commitmentsHeading}</h3>
        <ul class="checklist commitments__list">
          {content.model.commitments.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    {
      /* ── I vantaggi ─────────────────────────────────────────────────────
        Stesso schema delle strozzature di Servizi: ogni voce porta la sua
        conseguenza, perché è la conseguenza a costruire il valore. Qui però
        la conseguenza ricade sull'agenzia che legge, non sullo studente —
        ed è quello che la rende un argomento di vendita B2B. */
    }
    <section class="wrap band" aria-labelledby="advantages-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.advantages.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="advantages-heading">{content.advantages.heading}</h2>
          <p class="lead-soft">{content.advantages.body}</p>
        </div>

        <ul class="advantages">
          {
            content.advantages.items.map((item) => (
              <li class="card-soft advantage">
                <span class="icon-badge">
                  <StepIcon name={item.icon} size={26} />
                </span>
                <h3 class="heading-card advantage__title">{item.title}</h3>
                <p class="advantage__body">{item.body}</p>
                <p class="advantage__risk">
                  <span class="advantage__risk-key">{content.advantages.riskLabel}</span>
                  {item.risk}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ── Atenei e operatori dell'housing ───────────────────────────────── */}
    <section class="wrap band" aria-labelledby="other-heading">
      <div class="head">
        <Eyebrow>{content.otherPartners.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="other-heading">{content.otherPartners.heading}</h2>
        <p class="lead-soft">{content.otherPartners.body}</p>
      </div>

      <ul class="others">
        {
          content.otherPartners.items.map((item) => (
            <li class="card-soft other">
              <span class="icon-badge">
                <StepIcon name={item.icon} size={26} />
              </span>
              <h3 class="heading-card other__title">{item.title}</h3>
              <p class="other__body">{item.body}</p>
              <p class="other__looking">
                <span class="other__looking-key">{content.otherPartners.lookingLabel}</span>
                {item.looking}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ── Come si comincia, e la due diligence ──────────────────────────── */}
    <section class="wrap band" aria-labelledby="start-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.howToStart.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="start-heading">{content.howToStart.heading}</h2>
          <p class="lead-soft">{content.howToStart.body}</p>
        </div>

        {/* <ol> e non <ul>: l'ordine è l'informazione, e il numero sta nel
            markup invece che in un contatore CSS così chi usa uno screen
            reader lo sente come parte del passo. */}
        {/* `startstep` e non `step`: quest'ultima è una classe globale che
            azzera i <fieldset> del form più in basso nella stessa pagina, e
            lo scope di Astro non le terrebbe separate. */}
        <ol class="startsteps">
          {
            content.howToStart.steps.map((step, index) => (
              <li class="startstep">
                <div class="startstep__marker">
                  <span class="startstep__num">{String(index + 1).padStart(2, '0')}</span>
                  <h3 class="heading-card startstep__title">{step.title}</h3>
                </div>
                <p class="startstep__body">{step.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="diligence">
          <h3 class="diligence__title">{content.howToStart.dueDiligence.heading}</h3>
          <ul class="checklist checklist--negative diligence__list">
            {content.howToStart.dueDiligence.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {
      /* ── Il form B2B ────────────────────────────────────────────────────
        Un professionista non compila lo stesso modulo di uno studente:
        questo chiede agenzia, paese, sito e volume annuo, cioè quanto basta
        a qualificare l'interlocutore prima di fissare una riunione. */
    }
    <section class="wrap band" id="partner-form" aria-labelledby="partner-form-heading">
      <div class="formband surface-panel">
        <div class="formband__head">
          <Eyebrow tone="blank">{content.form.eyebrow}</Eyebrow>
          <h2 class="heading-section formband__title" id="partner-form-heading">
            {content.form.heading}
          </h2>
          <p class="formband__body">{content.form.body}</p>
        </div>

        <div class="formband__form">
          <MultiStepForm
            name="partner-enquiry"
            action={getPath('thankYou', locale)}
            submitLabel={content.form.ctaLabel}
            fields={FIELDS}
            labels={t.form}
          >
            <fieldset class="step" data-step>
              <legend class="sr-only">{content.form.heading}</legend>

              <Field id="contact-name" label={t.partnerForm.contactName} required>
                <Input
                  id="contact-name"
                  name="contact-name"
                  required
                  describedBy={describedBy('contact-name', { error: true })}
                />
              </Field>

              <Field id="role" label={t.partnerForm.role} required>
                <Input
                  id="role"
                  name="role"
                  required
                  describedBy={describedBy('role', { error: true })}
                />
              </Field>

              <Field id="agency" label={t.partnerForm.agency} required>
                <Input
                  id="agency"
                  name="agency"
                  required
                  describedBy={describedBy('agency', { error: true })}
                />
              </Field>

              <Field id="country" label={t.partnerForm.country} required>
                <Input
                  as="select"
                  id="country"
                  name="country"
                  required
                  describedBy={describedBy('country', { error: true })}
                >
                  <option value=""></option>
                  {countries.map(([code, label]) => <option value={code}>{label}</option>)}
                </Input>
              </Field>

              {/* Il sito aziendale è il campo che qualifica più in fretta di
                  ogni altro: dieci secondi di verifica dicono se l'agenzia
                  esiste davvero e su che mercati lavora. */}
              <Field id="website" label={t.partnerForm.website} optionalLabel={t.form.optional}>
                <Input
                  id="website"
                  name="website"
                  type="url"
                  placeholder={t.partnerForm.websitePlaceholder}
                />
              </Field>

              <Field id="work-email" label={t.partnerForm.workEmail} required>
                <Input
                  id="work-email"
                  name="work-email"
                  type="email"
                  required
                  describedBy={describedBy('work-email', { error: true })}
                />
              </Field>

              <Field id="volume-bracket" label={t.partnerForm.volumeBracket} required>
                <Input
                  as="select"
                  id="volume-bracket"
                  name="volume-bracket"
                  required
                  describedBy={describedBy('volume-bracket', { error: true })}
                >
                  <option value=""></option>
                  <option value="under-10">{t.partnerForm.volumeBracketOptions.under10}</option>
                  <option value="10-50">{t.partnerForm.volumeBracketOptions.from10to50}</option>
                  <option value="50-200">{t.partnerForm.volumeBracketOptions.from50to200}</option>
                  <option value="over-200">{t.partnerForm.volumeBracketOptions.over200}</option>
                </Input>
              </Field>

              <Field
                id="destinations-served"
                label={t.partnerForm.destinationsServed}
                optionalLabel={t.form.optional}
              >
                <Input
                  id="destinations-served"
                  name="destinations-served"
                  placeholder={t.partnerForm.destinationsServedPlaceholder}
                />
              </Field>

              <ChoiceGroup
                id="interest"
                name="interest"
                legend={t.partnerForm.interest}
                required
                options={[
                  {
                    value: 'students-to-italy',
                    label: t.partnerForm.interestOptions.studentsToItaly,
                  },
                  {
                    value: 'structured-partnership',
                    label: t.partnerForm.interestOptions.structuredPartnership,
                  },
                  { value: 'other', label: t.partnerForm.interestOptions.other },
                ]}
              />

              <Field id="notes" label={t.partnerForm.notes} optionalLabel={t.form.optional}>
                <Input
                  as="textarea"
                  id="notes"
                  name="notes"
                  placeholder={t.partnerForm.notesPlaceholder}
                />
              </Field>

              <label class="consent-field">
                <input type="checkbox" name="privacy-consent" required />
                <span>
                  {t.form.privacyConsentPrefix}
                  <a href={getPath('privacy', locale)}>{t.form.privacyConsentLink}</a>.
                </span>
              </label>
            </fieldset>
          </MultiStepForm>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .partners {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 2.5vw, 2rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }
  .hero__title {
    margin-top: 1.4rem;
    max-width: 20ch;
  }
  .hero__lead {
    margin-top: 1.3rem;
    max-width: 58ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }
  /* Il corridoio è decorazione: sotto le 64rem non c'è la seconda colonna e
     sparisce, invece di aggiungere un blocco muto sopra il resto. */
  .hero__art {
    display: none;
  }
  @media (min-width: 64rem) {
    .hero__art {
      display: block;
    }
  }

  /* ── Fasce e intestazioni ─────────────────────────────────────────────── */
  .band {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  /* Le due ancore dell'hero: l'header è sticky e senza questo margine la
     fascia finirebbe sotto la barra. */
  #model,
  #partner-form {
    scroll-margin-top: 6rem;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .head .lead-soft {
    max-width: none;
  }
  .heading-section + p {
    margin-top: 0.75rem;
  }

  /* ── Il mercato (fascia scura) ────────────────────────────────────────── */
  .panel-dark {
    border-radius: var(--radius-2xl);
    padding: clamp(1.75rem, 4vw, 3.25rem);
  }
  /* Le cifre sono il motivo per cui un direttore d'agenzia continua a leggere:
     stanno in fila, grandi, in oro — l'unico posto della pagina dove un numero
     ha più peso della frase che lo accompagna. */
  .metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1 1 min(100%, 13rem);
    min-width: min(100%, 13rem);
    padding: clamp(1.25rem, 2.2vw, 1.6rem);
    background-color: var(--color-panel);
    border: 1px solid var(--color-panel-line);
    border-radius: var(--radius-xl);
  }
  .metric__value {
    font-family: var(--font-titling);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-gold-bright); /* 8.59 sul navy — AAA */
  }
  .metric__label {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--surface-fg-muted);
  }

  .market__foot {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .market__foot {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    }
  }
  .market__points {
    max-width: 72ch;
  }
  .market__links {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    margin: 0;
  }
  /* Su una pagina che vive di numeri il rimando alla fonte non è una cortesia:
     è ciò che la distingue dalle pagine di agenzia che i numeri se li inventano. */
  .market__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--surface-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--surface-rule-strong);
  }
  .market__link:hover {
    color: var(--surface-accent);
    text-decoration-color: currentColor;
  }

  /* ── Il modello ───────────────────────────────────────────────────────── */
  /* Gli impegni stanno attaccati al diagramma, non in fondo alla pagina: sono
     la risposta all'obiezione che il diagramma stesso solleva. */
  .commitments {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.35rem, 2.6vw, 1.9rem) clamp(1.35rem, 2.6vw, 2rem);
    background-color: var(--color-mist);
    border-radius: var(--radius-xl);
  }
  .commitments__list {
    margin-top: 1.1rem;
    max-width: 88ch;
  }

  /* ── I vantaggi ───────────────────────────────────────────────────────── */
  .advantages,
  .others {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .advantage {
    flex: 1 1 min(100%, 19rem);
    min-width: min(100%, 19rem);
  }
  .advantage__title {
    margin-top: 1.15rem;
  }
  .advantage__body {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }
  /* La conseguenza è la parte che vende: staccata da un filetto, con
     l'etichetta nel rosso di sicurezza — che non è un colore di brand. */
  .advantage__risk {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--surface-rule);
    font-size: var(--text-sm);
    color: var(--surface-fg-soft);
  }
  .advantage__risk-key {
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-warning);
  }

  /* ── Gli altri interlocutori ──────────────────────────────────────────── */
  .other {
    flex: 1 1 min(100%, 24rem);
    min-width: min(100%, 24rem);
  }
  .other__title {
    margin-top: 1.15rem;
  }
  .other__body {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }
  .other__looking {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--surface-rule);
    font-size: var(--text-sm);
    color: var(--surface-fg-soft);
  }
  .other__looking-key {
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }

  /* ── Come si comincia ─────────────────────────────────────────────────── */
