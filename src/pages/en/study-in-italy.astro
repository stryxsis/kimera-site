---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { getPath, BOOKING_FORM_URL } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import MediaFrame from '../../components/ui/MediaFrame.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';

/**
 * «Perché l'Italia» — l'unica pagina del sito costruita per il traffico organico.
 * Chi arriva qui non sta valutando Kimere: sta valutando il paese. Quindi la
 * pagina vende prima l'Italia e nomina Kimere solo alla fine, dove il sogno
 * incontra l'amministrazione (`pivot`).
 *
 * Stesso linguaggio visivo della home e di Servizi, con UNA aggiunta: il campo
 * ORO della sezione borse di studio. È l'unico blocco d'oro pieno di tutto il
 * sito, ed è deliberato — l'oro è l'accento del marchio e finora non ha mai
 * fatto da campitura. Qui segna il picco della pagina: il momento in cui il
 * costo, appena mostrato, può azzerarsi. Sull'oro il testo è navy (6.62, AA):
 * l'inchiostro tenue del sistema chiaro NON passa, quindi qui i colori sono
 * dichiarati esplicitamente invece di leggere --surface-fg-muted.
 *
 * Ogni cifra della pagina è una che il sito già dichiara altrove o che una
 * fonte pubblica sostiene, e le due sezioni con più numeri portano il link
 * alla fonte. Nessuna classifica, nessun conteggio di studenti stranieri.
 */
const locale = 'en';
const t = useTranslations(locale);
const { data: content } = await getEntry('studyInItalyPage', locale)!;
---

<PageLayout
  locale={locale}
  routeKey="studyInItaly"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
>
  <div class="study surface-blank">
    {/* ── Hero: l'aggancio emotivo ─────────────────────────────────────── */}
    <section class="wrap hero">
      <div class="hero__intro">
        <Eyebrow class="animate-rise">{content.hero.eyebrow}</Eyebrow>
        <h1 class="heading-display hero__title animate-rise" style="animation-delay:60ms">
          {content.hero.headline}
        </h1>
        <p class="lead-soft hero__lead animate-rise" style="animation-delay:120ms">
          {content.hero.subhead}
        </p>
        <div class="hero__actions animate-rise" style="animation-delay:180ms">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" variant="pill" size="lg" arrow>
            {content.hero.ctaPrimary}
          </Button>
          <Button href={getPath('services', locale)} variant="pill-ghost" size="lg">
            {content.hero.ctaSecondary}
          </Button>
        </div>
        <p class="hero__note animate-rise" style="animation-delay:240ms">
          {t.cta.freeNoObligation}
        </p>
      </div>

      {
        /* Qui la fotografia serve davvero, a differenza della home: la home
          vende un percorso e mostra il percorso, questa vende un paese. Il
          riquadro è già definitivo nelle proporzioni — quando il file arriva
          in public/media/ basta passare `src` e il segnaposto sparisce. */
      }
      <div class="hero__media animate-rise" style="animation-delay:300ms">
        <MediaFrame placeholder={content.hero.imagePlaceholder} ratio="4 / 5" eager />
        <p class="hero__badge">
          <span class="hero__badge-value">{content.hero.badgeValue}</span>
          <span class="hero__badge-label">{content.hero.badgeLabel}</span>
        </p>
      </div>
    </section>

    {/* ── L'eccellenza accademica e la lingua ───────────────────────────── */}
    <section class="wrap band" aria-labelledby="academics-heading">
      <div class="head">
        <Eyebrow>{content.academics.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="academics-heading">{content.academics.heading}</h2>
        <p class="lead-soft">{content.academics.body}</p>
      </div>

      <ul class="cards">
        {
          content.academics.points.map((point) => (
            <li class="card-soft card">
              <span class="icon-badge">
                <StepIcon name={point.icon} size={26} />
              </span>
              <h3 class="heading-card card__title">{point.title}</h3>
              <p class="card__body">{point.body}</p>
            </li>
          ))
        }
      </ul>

      {
        /* La barriera d'ingresso più alta è linguistica, ed è quasi sempre
          immaginaria: va abbattuta con un blocco che si vede da lontano,
          non con una riga in mezzo al testo. */
      }
      <div class="language">
        <div class="language__text">
          <h3 class="heading-section language__title">{content.academics.language.heading}</h3>
          <p class="language__body">{content.academics.language.body}</p>
        </div>
        <ul class="checklist language__list">
          {content.academics.language.points.map((point) => <li>{point}</li>)}
        </ul>
      </div>

      <p class="source">
        <a
          class="source__link"
          href={content.academics.officialSource}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.process.officialSource}
          <svg
            viewBox="0 0 14 14"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 2h7v7M12 2 3 11" />
          </svg>
        </a>
      </p>
    </section>

    {/* ── I costi, in chiaro ────────────────────────────────────────────── */}
    <section class="wrap band" aria-labelledby="costs-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.costs.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="costs-heading">{content.costs.heading}</h2>
          <p class="lead-soft">{content.costs.body}</p>
        </div>

        <ul class="pricing">
          {
            content.costs.rows.map((row) => (
              <li class="card-soft price">
                <span class="price__label">{row.label}</span>
                <span class="price__value">{row.value}</span>
                <span class="price__note">{row.note}</span>
              </li>
            ))
          }
        </ul>

        {
          /* Il disclaimer sta sotto i numeri, non in fondo alla pagina: qui
            è ciò che rende credibili i numeri stessi, non una postilla. */
        }
        <p class="disclaimer">{content.costs.disclaimer}</p>
      </div>
    </section>

    {/* ── Il jolly: le borse di studio ──────────────────────────────────── */}
    <section class="wrap band" aria-labelledby="scholarships-heading">
      <div class="jackpot">
        <div class="head jackpot__head">
          <Eyebrow tone="solid">{content.scholarships.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="scholarships-heading">{content.scholarships.heading}</h2>
          <p class="lead-soft">{content.scholarships.body}</p>
        </div>

        <ul class="cards">
          {
            content.scholarships.benefits.map((benefit) => (
              <li class="card-soft card">
                <h3 class="heading-card">{benefit.title}</h3>
                <p class="card__body">{benefit.body}</p>
              </li>
            ))
          }
        </ul>

        <p class="jackpot__note">{content.scholarships.note}</p>
      </div>
    </section>

    {/* ── Lavorare e restare ────────────────────────────────────────────── */}
    <section class="wrap band" aria-labelledby="future-heading">
      <div class="head">
        <Eyebrow>{content.future.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="future-heading">{content.future.heading}</h2>
        <p class="lead-soft">{content.future.body}</p>
      </div>

      <ul class="cards">
        {
          content.future.points.map((point) => (
            <li class="card-soft card">
              <span class="icon-badge">
                <StepIcon name={point.icon} size={26} />
              </span>
              <h3 class="heading-card card__title">{point.title}</h3>
              <p class="card__body">{point.body}</p>
            </li>
          ))
        }
      </ul>

      <p class="source">
        <a
          class="source__link"
          href={content.future.officialSource}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.process.officialSource}
          <svg
            viewBox="0 0 14 14"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 2h7v7M12 2 3 11" />
          </svg>
        </a>
      </p>
    </section>

    {
      /* ── Il pivot ────────────────────────────────────────────────────────
        Dopo cinque sezioni che vendono il paese, questa riporta i piedi per
        terra e consegna il lettore a Servizi. È l'unico punto della pagina
        in cui si parla di Kimere, ed è deliberato: chi arriva da una ricerca
        organica scappa se la prima cosa che legge è un'offerta. */
    }
    <section class="wrap band" aria-labelledby="pivot-heading">
      <div class="finalcta surface-panel">
        <Eyebrow tone="blank">{content.pivot.eyebrow}</Eyebrow>
        <h2 class="heading-section finalcta__title" id="pivot-heading">{content.pivot.heading}</h2>
        <p class="finalcta__body">{content.pivot.body}</p>
        <p class="finalcta__actions">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" size="lg" arrow>
            {content.pivot.ctaPrimary}
          </Button>
          <Button href={getPath('services', locale)} variant="secondary" size="lg">
            {content.pivot.ctaSecondary}
          </Button>
        </p>
        <p class="finalcta__note">{t.cta.freeNoObligation}</p>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .study {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--spacing-section);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
  .hero__title {
    margin-top: 1.4rem;
    max-width: 17ch;
  }
  .hero__lead {
    margin-top: 1.4rem;
    max-width: 52ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }
  .hero__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 1.15rem;
  }

  /* La pastiglia sospesa sull'immagine, dai riferimenti scelti dal cliente.
     Porta UN dato solo, il più seducente della pagina — se ne portasse tre
     tornerebbe a essere una didascalia. */
  .hero__media {
    position: relative;
  }
  .hero__badge {
    position: absolute;
    left: clamp(-0.5rem, 1vw, 1.25rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: clamp(0.9rem, 2vw, 1.15rem) clamp(1.1rem, 2.4vw, 1.5rem);
    background-color: var(--color-blank);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-float);
    max-width: 15rem;
  }
  .hero__badge-value {
    font-family: var(--font-titling);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-teal-ink);
  }
  .hero__badge-label {
    font-size: var(--text-xs);
    line-height: 1.35;
    color: var(--color-ink-muted);
  }

  /* ── Fasce e intestazioni ─────────────────────────────────────────────── */
  .band {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .head .lead-soft {
    max-width: none;
  }
  .heading-section + p {
    margin-top: 0.75rem;
  }

  /* ── Griglia di schede, condivisa da tre sezioni ──────────────────────── */
  .cards {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    flex: 1 1 min(100%, 17rem);
    min-width: min(100%, 17rem);
  }
  .card__title {
    margin-top: 1.15rem;
  }
  .card__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }

  /* ── Il blocco sulla lingua ───────────────────────────────────────────── */
  /* Due colonne piene, non un'intestazione spinta a metà: a sinistra
     l'argomento, a destra le tre condizioni. Entrambe portano contenuto. */
  .language {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    background-color: var(--color-mist-deep);
    border-radius: var(--radius-2xl);
  }
  @media (min-width: 60rem) {
    .language {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .language__title {
    max-width: 18ch;
  }
  .language__body {
    margin-top: 0.9rem;
    color: var(--surface-fg-soft);
  }
  .language__list {
    align-self: center;
  }

  /* ── I costi ──────────────────────────────────────────────────────────── */
  .pricing {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .price {
    flex: 1 1 min(100%, 17rem);
    min-width: min(100%, 17rem);
    gap: 0.5rem;
  }
  .price__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }
  .price__value {
    font-family: var(--font-titling);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .price__note {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    padding-top: 0.75rem;
    border-top: 1px solid var(--surface-rule);
  }
  .disclaimer {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.2rem, 2.5vw, 1.75rem);
    border-left: 3px solid var(--color-teal-ink);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background-color: var(--color-mist-deep);
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--surface-fg-soft);
  }

  /* ── Il campo oro ─────────────────────────────────────────────────────── */
  /* L'unico blocco d'oro pieno del sito. Sull'oro il navy ha 6.62 (AA) ma
     l'inchiostro tenue NON passa: tutti i colori sono dichiarati qui invece
     di ereditare da --surface-*, che qui darebbe una coppia fuori soglia. */
  .jackpot {
    border-radius: var(--radius-2xl);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    background-color: var(--color-gold);
    color: var(--color-ground);
  }
  .jackpot__head .lead-soft {
    color: var(--color-ground);
  }
  .jackpot__note {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding-top: clamp(1.1rem, 2vw, 1.5rem);
    border-top: 1px solid var(--color-gold-deep);
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-ground);
    max-width: 78ch;
  }

  /* ── Il rimando alla fonte ────────────────────────────────────────────── */
  /* Su una pagina che vive di numeri, la fonte non è una cortesia: è ciò che
     la distingue dalle pagine di agenzia che i numeri se li inventano. */
  .source {
    margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
  }
  .source__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-mist-line);
  }
  .source__link:hover {
    color: var(--color-teal-ink);
    text-decoration-color: currentColor;
  }

  /* ── Il pivot ─────────────────────────────────────────────────────────── */
  .finalcta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.15rem;
    border-radius: var(--radius-2xl);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .finalcta__title {
    max-width: 24ch;
  }
  /* Più largo del solito: qui non c'è una riga di rassicurazione ma
     l'argomento che regge tutta la pagina. */
  .finalcta__body {
    color: var(--surface-fg-muted);
    max-width: 68ch;
  }
  .finalcta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 0.85rem;
  }
  .finalcta__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
  }
</style>
