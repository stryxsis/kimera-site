---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { BOOKING_FORM_URL } from '../../i18n/routes';
import { useTranslations, renderEmphasis } from '../../i18n/utils';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';
import ProcessTangle from '../../components/illustrations/ProcessTangle.astro';

/**
 * Servizi — ristilata sullo stesso linguaggio della home (fondo chiaro, fasce
 * arrotondate, grottesca geometrica, pastiglie), ma con una struttura diversa
 * perché ha un compito diverso: la home orienta, questa vende.
 *
 * Il ritmo delle superfici è deliberato e alterna per non appiattirsi su una
 * pagina lunga: bianco → NAVY (il carico) → bianco → nebbia (i livelli) →
 * bianco (il premium) → nebbia (l'alloggio) → bianco (i limiti) → NAVY (la
 * conversione). L'unico blocco scuro nella prima metà è il problema: è la
 * sezione che deve pesare, e il navy è il colore del marchio, non un effetto.
 *
 * Nessun prezzo, da nessuna parte: la cifra si dice in call sulla situazione
 * reale. È una scelta commerciale del cliente, non una lacuna da colmare.
 *
 * Come la home, questa pagina non usa <Section>: quel componente appartiene al
 * sistema originale (fasce a piena larghezza, superfici scure).
 */
const locale = 'en';
const t = useTranslations(locale);
const { data: content } = await getEntry('servicesPage', locale)!;

const allPackages = await getCollection('packages', (entry) => entry.id.startsWith(`${locale}/`));
const packages = allPackages.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  locale={locale}
  routeKey="services"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
>
  <div class="services surface-blank">
    {/* ── Hero ─────────────────────────────────────────────────────────── */}
    <section class="wrap hero">
      <div class="hero__inner">
        <Eyebrow class="animate-rise">{content.hero.eyebrow}</Eyebrow>
        <h1 class="heading-display hero__title animate-rise" style="animation-delay:60ms">
          {content.hero.headline}
        </h1>
        <p class="lead-soft hero__lead animate-rise" style="animation-delay:120ms">
          {content.hero.subhead}
        </p>
        <div class="hero__actions animate-rise" style="animation-delay:180ms">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" variant="pill" size="lg" arrow>
            {content.hero.ctaPrimary}
          </Button>
          <Button href="#levels" variant="pill-ghost" size="lg">
            {content.hero.ctaSecondary}
          </Button>
        </div>
        <p class="hero__note animate-rise" style="animation-delay:240ms">
          {t.cta.freeNoObligation}
        </p>
      </div>
    </section>

    {
      /* ── Il carico, prima di offrire qualsiasi cosa ──────────────────────
        Chi non vede il problema non compra la soluzione: questa sezione
        esiste per mostrare il carico reale PRIMA dei livelli. Ogni voce
        porta la sua conseguenza, perché è la conseguenza a costruire il
        valore — e ognuna è una procedura già documentata in /process/,
        non un allarme inventato per far paura. */
    }
    <section class="wrap band" aria-labelledby="gauntlet-heading">
      <div class="panel-dark surface-dark">
        <div class="gauntlet__top">
          <div class="head">
            <Eyebrow tone="gold">{content.bottlenecks.eyebrow}</Eyebrow>
            <h2 class="heading-section" id="gauntlet-heading">{content.bottlenecks.heading}</h2>
            <p class="lead-soft">{content.bottlenecks.body}</p>
          </div>
          <div class="gauntlet__art"><ProcessTangle /></div>
        </div>

        <ul class="gauntlet">
          {
            content.bottlenecks.items.map((item) => (
              <li class="bottleneck">
                <span class="icon-badge">
                  <StepIcon name={item.icon} size={26} />
                </span>
                <h3 class="heading-card bottleneck__title">{item.title}</h3>
                {/* Il copy EN marca i termini burocratici italiani con *asterischi*
                    (docs/glossary.md): senza renderEmphasis finirebbero a video così. */}
                <p class="bottleneck__body" set:html={renderEmphasis(item.body)} />
                <p class="bottleneck__risk">
                  <span class="bottleneck__risk-key">{content.bottlenecks.riskLabel}</span>
                  {item.risk}
                </p>
              </li>
            ))
          }
        </ul>

        <p class="gauntlet__note">{content.bottlenecks.note}</p>
      </div>
    </section>

    {/* ── Il metodo: perché un portale di upload non basta ──────────────── */}
    <section class="wrap band" aria-labelledby="method-heading">
      <div class="head">
        <Eyebrow>{content.method.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="method-heading">{content.method.heading}</h2>
        <p class="lead-soft">{content.method.body}</p>
      </div>

      <ul class="principles">
        {
          content.method.principles.map((principle) => (
            <li class="card-soft principle">
              <span class="icon-badge">
                <StepIcon name={principle.icon} size={26} />
              </span>
              <h3 class="heading-card principle__title">{principle.title}</h3>
              <p class="principle__body">{principle.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      /* ── I tre livelli, senza listino ───────────────────────────────────
        Il tabellone è la traduzione visiva della strategia di prezzo: si
        vede la scala, non la cifra. L'unico modo per avere il numero è il
        bottone sotto la colonna — ed è esattamente il punto in cui nasce
        l'obiezione, quindi la risposta («perché non c'è un listino») sta
        subito sotto invece che in fondo alla pagina. */
    }
    <section class="wrap band" id="levels" aria-labelledby="levels-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.levels.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="levels-heading">{content.levels.heading}</h2>
          <p class="lead-soft">{content.levels.body}</p>
        </div>

        <ul class="levels">
          {
            packages.map((pkg) => {
              const featured = pkg.data.key === content.levels.featuredKey;
              return (
                <li class:list={['card-soft', 'level', featured && 'level--featured']}>
                  {featured && <span class="level__flag">{content.levels.featuredLabel}</span>}
                  <h3 class="heading-card level__name">{pkg.data.name}</h3>
                  <p class="level__tagline">{pkg.data.tagline}</p>

                  <p class="level__coverage">
                    <span class="level__coverage-key">{t.packages.included}</span>
                    {pkg.data.coverage}
                  </p>
                  <ul class="checklist level__list">
                    {pkg.data.includes.map((item) => (
                      <li set:html={renderEmphasis(item)} />
                    ))}
                  </ul>

                  <p class="level__cta">
                    <Button
                      href={BOOKING_FORM_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      variant={featured ? 'pill' : 'pill-ghost'}
                      size="sm"
                      arrow
                    >
                      {content.levels.ctaLabel}
                    </Button>
                  </p>
                </li>
              );
            })
          }
        </ul>

        <div class="noprices">
          <h3 class="heading-card noprices__title">{content.levels.whyNoPrices.heading}</h3>
          <p class="noprices__body">{content.levels.whyNoPrices.body}</p>
        </div>
      </div>
    </section>

    {/* ── Il livello a copertura piena, aperto ──────────────────────────── */}
    <section class="wrap band" aria-labelledby="premium-heading">
      <div class="head">
        <Eyebrow>{content.premium.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="premium-heading">{content.premium.heading}</h2>
        <p class="lead-soft">{content.premium.body}</p>
      </div>

      <ul class="pillars">
        {
          content.premium.pillars.map((pillar) => (
            <li class="card-soft pillar">
              <span class="icon-badge">
                <StepIcon name={pillar.icon} size={26} />
              </span>
              <h3 class="heading-card pillar__title">{pillar.title}</h3>
              <p class="pillar__body">{pillar.body}</p>
              <ul class="checklist pillar__list">
                {pillar.items.map((item) => (
                  <li set:html={renderEmphasis(item)} />
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <p class="premium__cta">
        <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" variant="pill" arrow>
          {content.premium.ctaLabel}
        </Button>
      </p>
    </section>

    {
      /* ── L'alloggio ─────────────────────────────────────────────────────
        È l'aggancio più forte della pagina, e per questo è anche quello con
        il rischio più alto: qui NON si dichiara nessuna partnership. Kimere
        non ha contratti firmati con reti di studentati, e scriverlo sarebbe
        pubblicità ingannevole oltre che in contraddizione con /housing/, che
        dichiara di non essere un'agenzia immobiliare. Il vantaggio si regge
        su ciò che si fa davvero — dove si indirizza la ricerca, cosa si
        legge prima della firma, cosa si registra — e i limiti stanno dentro
        la stessa sezione, non nascosti a fondo pagina. */
    }
    <section class="wrap band" aria-labelledby="housing-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.housing.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="housing-heading">{content.housing.heading}</h2>
          <p class="lead-soft">{content.housing.body}</p>
        </div>

        <ul class="barriers">
          {
            content.housing.barriers.map((barrier) => (
              <li class="card-soft barrier">
                <h3 class="heading-card barrier__title">{barrier.title}</h3>
                <p class="barrier__body">{barrier.body}</p>
              </li>
            ))
          }
        </ul>

        <div class="response">
          <h3 class="heading-card">{content.housing.responseHeading}</h3>
          <ul class="checklist response__list">
            {content.housing.response.map((item) => <li set:html={renderEmphasis(item)} />)}
          </ul>
        </div>

        <div class="housing__limits">
          <h3 class="housing__limits-title">{content.housing.limitsHeading}</h3>
          <ul class="checklist checklist--negative housing__limits-list">
            {content.housing.limits.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {/* ── I limiti, dichiarati ──────────────────────────────────────────── */}
    <section class="wrap band" aria-labelledby="limits-heading">
      <div class="head">
        <h2 class="heading-section" id="limits-heading">{content.notIncluded.heading}</h2>
      </div>
      <ul class="checklist checklist--negative limits__list">
        {content.notIncluded.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {/* ── Conversione ──────────────────────────────────────────────────── */}
    <section class="wrap band" aria-labelledby="cta-heading">
      <div class="finalcta surface-panel">
        <Eyebrow tone="blank">{content.finalCta.eyebrow}</Eyebrow>
        <h2 class="heading-section finalcta__title" id="cta-heading">{content.finalCta.heading}</h2>
        <p class="finalcta__body">{content.finalCta.body}</p>
        <p class="finalcta__actions">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" size="lg" arrow>
            {content.finalCta.ctaLabel}
          </Button>
        </p>
        <p class="finalcta__note">{t.cta.freeNoObligation}</p>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  /* Il fondo chiaro vale per tutta la pagina, non solo per le sezioni: il
     <body> del sistema originale è navy e si vedrebbe agli estremi. */
  .services {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────
     A colonna sola e centrato: qui non c'è un'illustrazione da affiancare
     come nella home, e un titolo di questa lunghezza spinto a sinistra con
     mezza pagina vuota a destra è esattamente il difetto già corretto. */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 2.5vw, 2rem);
  }
  .hero__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    max-width: 64rem;
    margin-inline: auto;
  }
  .hero__title {
    margin-top: 1.4rem;
    max-width: 24ch;
  }
  .hero__lead {
    margin-top: 1.2rem;
    max-width: 64ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }
  .hero__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 1.15rem;
  }

  /* ── Fasce e intestazioni ─────────────────────────────────────────────── */
  .band {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  /* L'ancora del bottone secondario dell'hero: l'header è sticky e senza
     questo margine la fascia finirebbe sotto la barra. */
  #levels {
    scroll-margin-top: 6rem;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  /* Il lead non è chiuso in un contenitore più stretto della griglia che gli
     sta sotto: usa la stessa larghezza disponibile. */
  .head .lead-soft {
    max-width: none;
  }
  /* Un titolo grande ha bisogno di più aria sotto di sé che sopra: il `gap`
     uniforme ne dava la stessa in entrambi i punti e sotto restava stretto. */
  .heading-section + p {
    margin-top: 0.75rem;
  }

  /* ── Il carico (fascia scura) ─────────────────────────────────────────── */
  .panel-dark {
    border-radius: var(--radius-2xl);
    padding: clamp(1.75rem, 4vw, 3.25rem);
  }
  .gauntlet__top {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .gauntlet__top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
  .gauntlet__top .head {
    margin-bottom: 0;
  }
  /* Il groviglio è decorazione: sotto i 48rem sparisce invece di schiacciarsi,
     e non si perde nessuna informazione perché non ne porta. */
  .gauntlet__art {
    display: none;
  }
  @media (min-width: 48rem) {
    .gauntlet__art {
      display: block;
    }
  }

  .gauntlet {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: clamp(1.75rem, 3.5vw, 2.75rem) 0 0;
    padding: 0;
    list-style: none;
  }
  /* La controparte scura di .card-soft: sul navy una scheda bianca spaccherebbe
     la fascia, e l'ombra non si vede comunque — qui separa il bordo. */
  .bottleneck {
    display: flex;
    flex-direction: column;
    flex: 1 1 min(100%, 17rem);
    min-width: min(100%, 17rem);
    background-color: var(--color-panel);
    border: 1px solid var(--color-panel-line);
    border-radius: var(--radius-xl);
    padding: clamp(1.35rem, 2.4vw, 1.75rem);
  }
  /* .icon-badge nasce per il fondo chiaro (nebbia + teal): sul navy va
     ricolorata, o diventa un quadrato bianco sparato in mezzo alla fascia. */
  .bottleneck .icon-badge {
    background-color: var(--color-panel-line);
    color: var(--color-gold-bright);
  }
  .bottleneck__title {
    margin-top: 1.1rem;
  }
  .bottleneck__body {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }
  /* La conseguenza è la parte che vende: staccata da un filetto, con
     l'etichetta nel rosso di sicurezza — che non è un colore di brand. */
  .bottleneck__risk {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--surface-rule);
    font-size: var(--text-sm);
    color: var(--surface-fg-soft);
  }
  .bottleneck__risk-key {
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-warning);
  }
  .gauntlet__note {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--surface-fg-soft);
    max-width: 72ch;
  }

  /* ── Il metodo ────────────────────────────────────────────────────────── */
  .principles,
  .pillars,
  .levels,
  .barriers {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Base larga apposta: con quattro voci una base stretta ne metterebbe tre
     in fila e una sola sotto, larga il doppio. Due e due sta insieme. */
  .principle {
    flex: 1 1 min(100%, 27rem);
    min-width: min(100%, 27rem);
  }
  .principle__title {
    margin-top: 1.15rem;
  }
  .principle__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }

  /* ── I livelli ────────────────────────────────────────────────────────── */
  .level {
    position: relative;
    flex: 1 1 min(100%, 18rem);
    min-width: min(100%, 18rem);
  }
  /* Il livello a copertura piena si stacca da bordo e ombra, non da un colore
     diverso: resta una delle tre colonne, non un'offerta a parte. */
  .level--featured {
    border-color: var(--color-ink);
    box-shadow: var(--shadow-float);
  }
  .level__flag {
    position: absolute;
    top: -0.8rem;
    right: 1.25rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-ink);
    color: var(--color-blank); /* 15.37 — AAA */
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }
  .level__tagline {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }
  .level__coverage {
    display: grid;
    gap: 0.3rem;
    font-size: var(--text-sm);
    margin-top: 1.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--surface-rule);
  }
  .level__coverage-key {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }
  .level__list {
    flex: 1;
    margin-top: 0.9rem;
  }
  .level__cta {
    margin-top: 1.5rem;
  }

  /* La risposta all'obiezione sta dove l'obiezione nasce: sotto i bottoni. */
  .noprices {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.35rem, 2.6vw, 1.9rem) clamp(1.35rem, 2.6vw, 2rem);
    background-color: var(--color-blank);
    border: 1px solid var(--color-mist-line);
    border-radius: var(--radius-xl);
  }
  .noprices__body {
    color: var(--surface-fg-muted);
    margin-top: 0.75rem;
  }

  /* ── Il premium ───────────────────────────────────────────────────────── */
  .pillar {
    flex: 1 1 min(100%, 20rem);
    min-width: min(100%, 20rem);
  }
  .pillar__title {
    margin-top: 1.15rem;
  }
  .pillar__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }
  .pillar__list {
    margin-top: 1.1rem;
  }
  .premium__cta {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* ── L'alloggio ───────────────────────────────────────────────────────── */
  .barrier {
    flex: 1 1 min(100%, 17rem);
    min-width: min(100%, 17rem);
  }
  .barrier__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }
  .response {
    margin-top: 1.15rem;
    padding: clamp(1.35rem, 2.4vw, 1.9rem);
    background-color: var(--color-blank);
    border: 1px solid var(--color-mist-line);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
  }
  .response__list {
    margin-top: 1.1rem;
  }
  /* I limiti stanno dentro la sezione che fa la promessa, non in fondo alla
     pagina: è ciò che rende credibile tutto il blocco sopra. */
  .housing__limits {
    margin-top: 1.15rem;
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.2rem, 2.5vw, 1.75rem);
    border-left: 3px solid var(--color-teal-ink);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background-color: var(--color-mist-deep);
  }
  .housing__limits-title {
    font-family: var(--font-titling);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .housing__limits-list {
    margin-top: 0.5rem;
  }

  /* ── I limiti generali ────────────────────────────────────────────────── */
  .limits__list {
    max-width: 82ch;
  }

  /* ── CTA finale ───────────────────────────────────────────────────────── */
  .finalcta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.15rem;
    border-radius: var(--radius-2xl);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .finalcta__title {
    max-width: 26ch;
  }
  .finalcta__body {
    color: var(--surface-fg-muted);
    max-width: 56ch;
  }
  .finalcta__actions {
    margin-top: 0.85rem;
  }
  .finalcta__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
  }
</style>
