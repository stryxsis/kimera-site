---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getPath } from '../../i18n/routes';
import { renderEmphasis } from '../../i18n/utils';

const locale = 'en';
const { data: content } = await getEntry('servicesPage', locale)!;

const allPackages = await getCollection('packages', (entry) => entry.id.startsWith(`${locale}/`));
const sortedPackages = allPackages.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout locale={locale} routeKey="services" title={content.intro.heading}>
  <p>{content.intro.body}</p>
  <p>{content.comparisonNote}</p>

  {
    sortedPackages.map((pkg) => (
      <article>
        <h2>{pkg.data.name}</h2>
        <p>{pkg.data.tagline}</p>
        <ul>
          {pkg.data.includes.map((item) => (
            <li set:html={renderEmphasis(item)} />
          ))}
        </ul>
        <p>
          <a href={`${getPath('book', locale)}?level=${pkg.data.key}`}>{content.ctaLabel}</a>
        </p>
      </article>
    ))
  }

  <section>
    <h2>{content.whyNoPrices.heading}</h2>
    <p>{content.whyNoPrices.body}</p>
  </section>

  <section>
    <h2>{content.notIncluded.heading}</h2>
    <ul>
      {content.notIncluded.items.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <p>
    <a href={getPath('book', locale)}>{content.ctaLabel}</a>
  </p>
</PageLayout>
