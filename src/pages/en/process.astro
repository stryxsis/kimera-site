---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getPath } from '../../i18n/routes';
import { useTranslations, renderEmphasis } from '../../i18n/utils';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import RouteMap from '../../components/illustrations/RouteMap.astro';

/**
 * La pagina cardine (brand-brief.md §2): l'arma di credibilità principale del
 * sito. Ogni passo segue lo stesso schema — cosa succede, chi decide, quanto
 * tempo, cosa può andare storto, cosa fa Kimere — e la ripetizione della
 * struttura è essa stessa un segnale di metodo, non una scelta estetica.
 */
const locale = 'en';
const t = useTranslations(locale);
const { data: content } = await getEntry('processPage', locale)!;

const allSteps = await getCollection('processSteps', (entry) => entry.id.startsWith(`${locale}/`));
const sortedSteps = allSteps.sort((a, b) => a.data.order - b.data.order);
const beforeDeparture = sortedSteps.filter((s) => s.data.phase === 'before-departure');
const afterArrival = sortedSteps.filter((s) => s.data.phase === 'after-arrival');

const toStop = (s: (typeof sortedSteps)[number]) => ({
  label: s.data.title,
  key: s.data.keyMoment,
});
---

<PageLayout locale={locale} routeKey="process" title={content.intro.heading}>
  <Section surface="light" labelledby="process-intro">
    <p class="block-lead" id="process-intro">{content.intro.body}</p>

    <div class="routemap-wrap">
      <RouteMap
        locale={locale}
        title={content.routeMap.caption}
        pivot={content.routeMap.pivot}
        stopsBefore={beforeDeparture.map(toStop)}
        stopsAfter={afterArrival.map(toStop)}
      />
    </div>
  </Section>

  <Section labelledby="before-departure-heading">
    <h2 class="block-heading" id="before-departure-heading">{content.beforeDeparturePhaseLabel}</h2>

    <ol class="steps">
      {
        beforeDeparture.map((step) => (
          <li class:list={['step', step.data.keyMoment && 'step--key']}>
            <div class="step__head">
              <span class="step__index">{String(step.data.order).padStart(2, '0')}</span>
              <h3 class="step__title">{step.data.title}</h3>
            </div>
            <p class="step__body" set:html={renderEmphasis(step.data.whatHappens)} />

            <dl class="kv-list step__meta">
              <div class="kv-row">
                <dt>{t.process.whoDecides}</dt>
                <dd>{step.data.whoDecides}</dd>
              </div>
              <div class="kv-row">
                <dt>{t.process.timing}</dt>
                <dd>{step.data.timing}</dd>
              </div>
            </dl>

            {step.data.whatCanGoWrong && (
              <p class="step__warning">
                <span class="label">{t.process.whatCanGoWrong}</span>
                {step.data.whatCanGoWrong}
              </p>
            )}

            <p class="step__does">
              <span class="label">{t.process.whatKimereDoes}</span>
              <span set:html={renderEmphasis(step.data.whatKimereDoes)} />
            </p>

            {step.data.officialSource && (
              <Button href={step.data.officialSource} variant="quiet" size="sm" rel="noopener">
                {t.process.officialSource} ↗
              </Button>
            )}
          </li>
        ))
      }
    </ol>
  </Section>

  <Section surface="light" labelledby="after-arrival-heading">
    <h2 class="block-heading" id="after-arrival-heading">{content.afterArrivalPhaseLabel}</h2>

    <ol class="steps">
      {
        afterArrival.map((step) => (
          <li class:list={['step', step.data.keyMoment && 'step--key']}>
            <div class="step__head">
              <span class="step__index">{String(step.data.order).padStart(2, '0')}</span>
              <h3 class="step__title">{step.data.title}</h3>
            </div>
            <p class="step__body" set:html={renderEmphasis(step.data.whatHappens)} />

            <dl class="kv-list step__meta">
              <div class="kv-row">
                <dt>{t.process.whoDecides}</dt>
                <dd>{step.data.whoDecides}</dd>
              </div>
              <div class="kv-row">
                <dt>{t.process.timing}</dt>
                <dd>{step.data.timing}</dd>
              </div>
            </dl>

            {step.data.whatCanGoWrong && (
              <p class="step__warning">
                <span class="label">{t.process.whatCanGoWrong}</span>
                {step.data.whatCanGoWrong}
              </p>
            )}

            <p class="step__does">
              <span class="label">{t.process.whatKimereDoes}</span>
              <span set:html={renderEmphasis(step.data.whatKimereDoes)} />
            </p>

            {step.data.officialSource && (
              <Button href={step.data.officialSource} variant="quiet" size="sm" rel="noopener">
                {t.process.officialSource} ↗
              </Button>
            )}
          </li>
        ))
      }
    </ol>
  </Section>

  <Section size="lg" labelledby="process-cta">
    <div class="closing-cta">
      <p class="closing-cta__note" id="process-cta">{content.disclaimer}</p>
      <Button href={getPath('book', locale)}>{content.ctaLabel}</Button>
    </div>
  </Section>
</PageLayout>

<style>
  .routemap-wrap {
    margin-top: 2.25rem;
  }

  .steps {
    margin: 2.75rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2.25rem;
  }
  .step {
    padding-bottom: 2.25rem;
    border-bottom: 1px solid var(--surface-rule);
  }
  .step:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  /* Le due tappe che l'analisi cita come le più convincenti (visto, permesso
     entro 8 giorni): un bordo d'accento più marcato, nessun testo inventato. */
  .step--key {
    border-left: 3px solid var(--surface-accent);
    padding-left: 1.25rem;
  }

  .step__head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }
  .step__index {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--surface-accent);
    line-height: 1;
  }
  .step__title {
    font-size: var(--text-xl);
  }
  .step__body {
    margin-top: 0.85rem;
    max-width: var(--container-prose);
    color: var(--surface-fg-soft);
  }
  .step__meta {
    margin-top: 1.1rem;
    max-width: 34rem;
  }
  .step__warning,
  .step__does {
    margin-top: 1.1rem;
    max-width: var(--container-prose);
    font-size: var(--text-sm);
  }
  .step__warning {
    color: var(--surface-fg-muted);
  }
  .step__does {
    color: var(--surface-fg-soft);
  }
  .step__warning .label,
  .step__does .label {
    display: block;
    margin-bottom: 0.3rem;
  }
  .step :global(.btn--quiet) {
    margin-top: 1rem;
  }
</style>
