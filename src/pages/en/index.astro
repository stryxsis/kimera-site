---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { getPath, BOOKING_FORM_URL, type RouteKey } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';

/**
 * Home — uno smistatore, non una vetrina.
 *
 * L'analisi strategica aggiornata dà a Kimere quattro destinatari con bisogni
 * quasi disgiunti: studente che ha scelto, studente indeciso, ateneo, agenzia.
 * Una home che parlasse a tutti e quattro contemporaneamente non parlerebbe a
 * nessuno, quindi la pagina fa una cosa sola per due volte: sopra la piega
 * separa B2C da B2B con due bottoni, subito sotto separa i quattro problemi con
 * quattro box. Tutto il resto della pagina è materiale di supporto a quella
 * decisione, non un secondo argomento di vendita.
 *
 * Tre scelte deliberate che vale la pena non dimenticare.
 *
 * PRIMA: nessun prezzo. I price point esistono nell'analisi ($1.000 / $200 /
 * $180) ma la decisione confermata è di tenerli fuori dal sito — la cifra si
 * dice in call. La «consulenza strategica» si nomina come prodotto, mai come
 * importo.
 *
 * SECONDA: due dei quattro box puntano a destinazioni provvisorie ma REALI, non
 * a pagine che non esistono. Studente indeciso → il form di qualificazione;
 * ateneo → il form B2B, dove è stata aggiunta l'opzione «seminario gratuito».
 * Quando esisteranno /orientamento/ e /universita/ basta cambiare la mappa
 * ROUTES_BY_AUDIENCE qui sotto: il contenuto non contiene URL.
 *
 * TERZA: il tono è più giovane e diretto di quello delle altre pagine (ToV da
 * startup, richiesto dall'analisi §3) ma il sistema visivo è invariato — navy,
 * oro, griglie e componenti restano quelli approvati.
 */
const locale = 'en';
const t = useTranslations(locale);
const { data: content } = await getEntry('homePage', locale)!;

/**
 * Dove porta ciascun box del bivio. La mappa sta QUI e non nel JSON di contenuto:
 * un URL scritto a mano dentro un file di contenuto è un link morto che nessun
 * controllo intercetta, mentre `getPath()` rompe la build se la route non esiste.
 *
 * `student-abroad` puntava provvisoriamente a Servizi; dal 2026-08-11 la pagina
 * «Per gli studenti» esiste ed è la destinazione vera di quel box — è scritta
 * per esattamente quel lettore e finisce nel questionario.
 *
 * `student-undecided` e `university` restano provvisori — puntano ai due form
 * invece che a pagine dedicate, che non esistono ancora. Sono imbuti funzionanti,
 * non vicoli ciechi: chi arriva dal box «lavoro per un'università» trova nel
 * form l'opzione «il seminario online gratuito» già in cima all'elenco. Il box
 * dell'indeciso NON viene dirottato su «Per gli studenti» perché la sua etichetta
 * promette una prenotazione: cambiare destinazione senza cambiare etichetta
 * sarebbe una promessa mancata, e l'etichetta è testo approvato dal cliente.
 */
const ROUTES_BY_AUDIENCE = {
  'student-abroad': { route: 'forStudents' as RouteKey },
  'student-undecided': { external: BOOKING_FORM_URL },
  university: { route: 'partners' as RouteKey, hash: '#partner-form' },
  agency: { route: 'partners' as RouteKey },
} satisfies Record<string, { route?: RouteKey; hash?: string; external?: string }>;

function hrefFor(audience: keyof typeof ROUTES_BY_AUDIENCE) {
  const target = ROUTES_BY_AUDIENCE[audience];
  if ('external' in target) return target.external;
  return getPath(target.route, locale) + ('hash' in target ? target.hash : '');
}

/** Un link esterno va aperto in una scheda nuova e isolato da questa pagina. */
function isExternal(href: string) {
  return href.startsWith('http');
}
---

<PageLayout
  locale={locale}
  routeKey="home"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
  heroOverlay
>
  <div class="home surface-blank">
    {
      /* ── Hero cinematica ────────────────────────────────────────────────
        Il video (la Terra che si avvicina fino a restare per metà sotto
        l'inquadratura) va per i suoi 6,2 secondi da solo; a circa due
        secondi dalla fine lo scrim scurisce l'immagine e il testo entra
        sfalsato. Il fotogramma finale È la composizione: il video non va in
        loop, si ferma lì e il titolo resta sopra il cielo, con la Terra in
        basso.

        Tutta la regia è un miglioramento progressivo, e lo stato di partenza
        del CSS è quello con il TESTO VISIBILE. Senza JavaScript, con
        prefers-reduced-motion, con il video mancante o con l'autoplay
        bloccato, la hero è comunque leggibile — nessuna di queste condizioni
        può lasciare la prima schermata vuota. */
    }
    <section class="stage surface-dark" data-hero aria-labelledby="hero-title">
      <script is:inline>
        /* Arma la sequenza PRIMA che il testo venga dipinto: da un attributo
           messo dopo, il titolo comparirebbe per un fotogramma e poi
           spirirebbe. `currentScript.parentElement` esiste già qui perché il
           tag di apertura della sezione è stato letto; i figli no. */
        (function () {
          var stage = document.currentScript.parentElement;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          stage.setAttribute('data-hero-state', 'armed');
          /* Rete di sicurezza indipendente dal bundle: se lo script principale
             non arriva mai, il testo non può restare invisibile per sempre. */
          setTimeout(function () {
            if (stage.getAttribute('data-hero-state') === 'armed') {
              stage.setAttribute('data-hero-state', 'revealed');
            }
          }, 8000);
        })();
      </script>

      {
        /* Decorativo: l'informazione è tutta nel testo accanto, quindi è
          `aria-hidden` e non ha bisogno di sottotitoli. Muto sempre — un
          video con audio non parte da solo su nessun browser, e non dovrebbe.
          La traccia audio è stata rimossa anche dal file: era da 2 kbps e non
          è mai stata riprodotta.

          NIENTE `src` NEL MARKUP, ed è la correzione più importante di questa
          hero. Con `src` + `preload="auto"` il browser cominciava a scaricare
          l'intero video insieme a CSS e font: su rete mobile la banda è una
          sola, e il risultato era che ci metteva molto e spesso arrivava dopo
          che il testo era già entrato (con lo scrim al 78% davanti, quindi
          invisibile). Ora la sorgente la sceglie e la carica lo script, che
          può decidere la variante giusta e rinunciare del tutto se la
          connessione non regge.

          `poster` invece resta nel markup: sono 32 KB, si dipinge subito, e
          copre l'attesa con l'immagine vera invece che col gradiente. È anche
          l'unica cosa che vede chi non ha JavaScript. */
      }
      <video
        class="stage__video"
        data-hero-video
        data-src-wide="/media/hero-earth.mp4"
        data-src-portrait="/media/hero-earth-portrait.mp4"
        poster="/media/hero-earth-poster.webp"
        muted
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"></video>

      <div class="stage__scrim" aria-hidden="true"></div>

      <div class="wrap stage__inner">
        <div class="stage__content">
          <div class="reveal" style="--i:0"><Eyebrow tone="gold">{content.hero.eyebrow}</Eyebrow></div>
          <h1 class="heading-display stage__title reveal" style="--i:1" id="hero-title">
            {content.hero.headline}
          </h1>
          <p class="stage__lead reveal" style="--i:2">{content.hero.subhead}</p>
          <div class="stage__actions reveal" style="--i:3">
            <Button href="#routing" size="lg" arrow>
              {content.hero.ctaStudent}
            </Button>
            <Button href={getPath('partners', locale)} variant="secondary" size="lg">
              {content.hero.ctaInstitution}
            </Button>
          </div>
          <p class="stage__note reveal" style="--i:4">{t.cta.freeNoObligation}</p>
        </div>
      </div>
    </section>

    {
      /* ── Il bivio ───────────────────────────────────────────────────────
        Il centro di gravità della pagina. I box sono divisi per PROBLEMA e
        non per prodotto: il visitatore riconosce la propria situazione senza
        dover dedurre quale servizio gli spetti. `audience` è una chiave, e
        l'href lo risolve ROUTES_BY_AUDIENCE qui sopra. */
    }
    <section class="wrap band" id="routing" aria-labelledby="routing-heading">
      <div class="head">
        <Eyebrow>{content.routing.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="routing-heading">{content.routing.heading}</h2>
        <p class="lead-soft">{content.routing.body}</p>
      </div>

      <ul class="routes">
        {
          content.routing.boxes.map((box) => {
            const href = hrefFor(box.audience);
            const external = isExternal(href);
            return (
              <li class="card-soft route">
                <span class="icon-badge">
                  <StepIcon name={box.icon} size={26} />
                </span>
                <h3 class="heading-card route__title">{box.title}</h3>
                <p class="route__body">{box.body}</p>
                <p class="route__cta">
                  <Button
                    href={href}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                    variant="pill-ghost"
                    size="sm"
                    arrow
                  >
                    {box.ctaLabel}
                  </Button>
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>

    {
      /* ── I superpoteri ──────────────────────────────────────────────────
        Il differenziante vero secondo l'analisi: non la tecnologia (dove
        Kimere perde contro chiunque abbia una dashboard) ma il team
        multiculturale. Le sette lingue NON stanno qui: stanno nel blocco
        dei corsi, dove sono un prodotto invece di un vanto. */
    }
    <section class="wrap band" aria-labelledby="strengths-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.strengths.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="strengths-heading">{content.strengths.heading}</h2>
          <p class="lead-soft">{content.strengths.body}</p>
        </div>

        <ul class="strengths">
          {
            content.strengths.points.map((point) => (
              <li class="card-soft strength">
                <span class="icon-badge">
                  <StepIcon name={point.icon} size={26} />
                </span>
                <h3 class="heading-card strength__title">{point.title}</h3>
                <p class="strength__body">{point.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      /* ── Zero burocrazia ────────────────────────────────────────────────
        I pain point che fermano davvero: soldi e documenti, non ammissione.
        Il riquadro `limit` alla fine è OBBLIGATORIO e non è prudenza
        eccessiva: l'analisi dice che Kimere «bypassa» la procedura CIMEA,
        ma l'attestato di comparabilità lo rilascia CIMEA o l'ateneo e
        nessun privato può renderlo superfluo. Promettere il contrario
        farebbe arrivare lo studente con una domanda respinta — e il
        vantaggio vero (traduzione in casa, pratica seguita) si regge da sé. */
    }
    <section class="wrap band" aria-labelledby="bureaucracy-heading">
      <div class="head">
        <Eyebrow>{content.bureaucracy.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="bureaucracy-heading">{content.bureaucracy.heading}</h2>
        <p class="lead-soft">{content.bureaucracy.body}</p>
      </div>

      <ul class="hurdles">
        {
          content.bureaucracy.items.map((item) => (
            <li class="card-soft hurdle">
              <span class="icon-badge">
                <StepIcon name={item.icon} size={26} />
              </span>
              <h3 class="heading-card hurdle__title">{item.title}</h3>
              <p class="hurdle__body">{item.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="limit">
        <h3 class="limit__title">{content.bureaucracy.limitHeading}</h3>
        <p class="limit__body">{content.bureaucracy.limitBody}</p>
        <a
          class="limit__link"
          href={content.bureaucracy.officialSource}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.process.officialSource}
          <svg
            viewBox="0 0 14 14"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 2h7v7M12 2 3 11" />
          </svg>
        </a>
      </div>
    </section>

    {
      /* ── Il canale B2B ──────────────────────────────────────────────────
        Il seminario gratuito è il lead magnet più pulito dell'analisi, e la
        CTA di questo blocco NON è «contattaci»: è la prenotazione del
        seminario. Su navy perché è la seconda conversione della pagina e
        deve pesare quanto la prima. */
    }
    <section class="wrap band" aria-labelledby="universities-heading">
      <div class="panel-dark surface-dark">
        <div class="unis">
          <div class="head unis__head">
            <Eyebrow tone="gold">{content.forUniversities.eyebrow}</Eyebrow>
            <h2 class="heading-section" id="universities-heading">
              {content.forUniversities.heading}
            </h2>
            <p class="lead-soft">{content.forUniversities.body}</p>
          </div>

          <div class="seminar">
            <h3 class="heading-card seminar__title">{content.forUniversities.seminarHeading}</h3>
            <p class="seminar__body">{content.forUniversities.seminarBody}</p>
            <ul class="checklist seminar__list">
              {content.forUniversities.seminarPoints.map((point) => <li>{point}</li>)}
            </ul>
            <p class="seminar__cta">
              <Button href={`${getPath('partners', locale)}#partner-form`} variant="pill" arrow>
                {content.forUniversities.ctaLabel}
              </Button>
            </p>
          </div>
        </div>
      </div>
    </section>

    {
      /* ── I corsi di lingua ──────────────────────────────────────────────
        Il ponte che mostra l'ecosistema a 360°. Le sette lingue sono
        esattamente quelle dell'analisi: l'italiano NON è nell'elenco e non
        va aggiunto per deduzione. */
    }
    <section class="wrap band" aria-labelledby="languages-heading">
      <div class="panel-soft langs">
        <div class="langs__text">
          <Eyebrow>{content.languageCourses.eyebrow}</Eyebrow>
          <h2 class="heading-section langs__title" id="languages-heading">
            {content.languageCourses.heading}
          </h2>
          <p class="langs__body">{content.languageCourses.body}</p>
          <p class="langs__cta">
            <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" variant="pill" arrow>
              {content.languageCourses.ctaLabel}
            </Button>
          </p>
        </div>

        <div class="langs__list">
          <p class="langs__label">{content.languageCourses.languagesLabel}</p>
          {/* Pastiglie e non elenco puntato: sette voci brevi lette come
              catalogo, che è quello che sono. */}
          <ul class="chips">
            {content.languageCourses.languages.map((language) => <li class="chip">{language}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {
      /* ── Conversione ────────────────────────────────────────────────────
        Per chi ha scrollato tutto senza cliccare nessun box: molto
        interessato, ma non si è riconosciuto in nessuna delle quattro
        caselle. `surveyNote` cita il sondaggio preliminare, che è ciò che
        distingue questa consulenza da una call di vendita. */
    }
    <section class="wrap band" aria-labelledby="cta-heading">
      <div class="finalcta surface-panel">
        <Eyebrow tone="blank">{content.finalCta.eyebrow}</Eyebrow>
        <h2 class="heading-section finalcta__title" id="cta-heading">{content.finalCta.heading}</h2>
        <p class="finalcta__body">{content.finalCta.body}</p>
        <p class="finalcta__actions">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" size="lg" arrow>
            {content.finalCta.ctaLabel}
          </Button>
        </p>
        <p class="finalcta__note">{content.finalCta.surveyNote}</p>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  /* Il fondo bianco vale per tutta la pagina, non solo per le sezioni: il
     <body> del sistema originale è navy e si vedrebbe agli estremi. */
  .home {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Hero cinematica ──────────────────────────────────────────────────── */
  .stage {
    position: relative;
    display: grid;
    align-items: center;
    overflow: clip;
    /* `isolation` chiude il contesto di sovrapposizione: gli z-index interni
       non possono passare sopra l'header sticky, che ha z-index 50. */
    isolation: isolate;
    /* `100vh` è il fallback per i browser senza `svh`. NON riscrivere questo
       come due `min-height` sulla stessa regola: il minificatore di Astro
       tratta la seconda dichiarazione come sostituzione della prima invece che
       come fallback progressivo ed elimina la riga in `vh` dal CSS finale,
       lasciando i browser senza `svh` (Safari < 15.4) senza altezza minima.
       `@supports` non viene toccato dal minificatore, quindi resta l'unico
       modo sicuro di scrivere questa coppia. */
    min-height: 100vh;
    /* Sotto il video, e visibile prima che il primo fotogramma sia decodificato:
       senza questo la prima schermata lampeggia bianca su connessione lenta. */
    background:
      radial-gradient(120% 85% at 50% 118%, #12406e 0%, #071f3d 52%, #030d1a 100%),
      var(--color-ground);
  }
  /* L'header è sticky e occupa spazio reale nel flusso: con `100svh` la barra
     di stato mobile che appare/scompare non fa più tremolare l'altezza
     dell'hero mentre si scorre, cosa che `100vh` da solo farebbe su iOS. */
  @supports (min-height: 100svh) {
    .stage {
      min-height: 100svh;
    }
  }
  .stage__video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Il ritaglio verticale su mobile è severo (il video è 16:9): centrato è
       l'unica posizione che non taglia né il cielo né la Terra in modo asimmetrico. */
    object-position: center;
  }

  /*
   * Lo strato che scurisce. Due livelli, e i valori NON sono a occhio: sopra il
   * video passa del testo di cui non conosciamo i pixel sottostanti, quindi il
   * contrasto deve essere garantito nel caso peggiore — un fotogramma bianco puro.
   *
   * Il fondo uniforme al 78% è la soglia sotto cui il testo tenue smetterebbe di
   * passare l'AA (verificato in scripts/check-contrast.mjs): a quel valore anche
   * --surface-fg-muted su bianco pieno dà 4.64, e il titolo 7.68. Il gradiente
   * aggiunge profondità in alto (fino all'86%) senza scendere mai sotto quella
   * soglia, così il testo è al sicuro in qualunque punto finisca — anche su un
   * viewport basso dove il blocco è più alto della fascia scura.
   *
   * In riproduzione l'opacità è 0: il video si vede pieno, ed è lì che sta
   * l'effetto. Lo scrim entra solo al momento della rivelazione.
   */
  .stage__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgb(7 31 61 / 0.36) 0%,
        rgb(7 31 61 / 0.16) 46%,
        rgb(7 31 61 / 0) 72%
      ),
      rgb(7 31 61 / 0.78);
    opacity: 1;
    transition: opacity 1100ms var(--ease-out-quart);
  }
  [data-hero-state='armed'] .stage__scrim {
    opacity: 0;
  }
  [data-hero-state='revealed'] .stage__scrim {
    opacity: 1;
  }

  .stage__inner {
    position: relative;
    z-index: 2;
    /* Asimmetrico di proposito: dentro un'area centrata, il padding inferiore
       più generoso spinge il testo in alto e libera la metà bassa, che è dove
       il video lascia la Terra. */
    padding-block: clamp(3rem, 9vh, 6rem) clamp(5rem, 20vh, 12rem);
  }
  .stage__content {
    display: grid;
    justify-items: center;
    text-align: center;
    max-width: 62rem;
    margin-inline: auto;
  }
  .stage__title {
    margin-top: 1.4rem;
    max-width: 22ch;
  }
  .stage__lead {
    margin-top: 1.3rem;
    max-width: 58ch;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--surface-fg-soft);
  }
  .stage__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }
  .stage__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 1.15rem;
  }

  /*
   * La rivelazione. Lo stato senza attributo è quello VISIBILE: è ciò che vede
   * chi non ha JavaScript, chi ha chiesto meno movimento e chi riceve un errore
   * sul video. `armed` nasconde, `revealed` riporta — e solo su questa seconda
   * transizione c'è il ritardo sfalsato, così l'ingresso è orchestrato e
   * l'uscita di scena istantanea.
   *
   * `pointer-events: none` mentre è nascosto evita che un bottone invisibile sia
   * cliccabile; il fuoco da tastiera è gestito nello script, che rivela tutto
   * appena il fuoco entra nella sezione.
   */
  [data-hero-state='armed'] .reveal {
    opacity: 0;
    transform: translateY(1.75rem);
    pointer-events: none;
  }
  [data-hero-state='revealed'] .reveal {
    opacity: 1;
    transform: none;
    transition:
      opacity 800ms var(--ease-out-quart),
      transform 800ms var(--ease-out-quart);
    transition-delay: calc(var(--i, 0) * 130ms);
  }

  /* ── Fasce e intestazioni ─────────────────────────────────────────────── */
  .band {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  /* L'ancora del bottone primario dell'hero: l'header è sticky e senza questo
     margine la fascia finirebbe sotto la barra. */
  #routing {
    scroll-margin-top: 6rem;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .head .lead-soft {
    max-width: none;
  }
  .heading-section + p {
    margin-top: 0.75rem;
  }

  /* ── Il bivio ─────────────────────────────────────────────────────────── */
  .routes,
  .strengths,
  .hurdles {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Base larga apposta: con quattro box una base stretta ne metterebbe tre in
     fila e uno solo sotto, largo il triplo. Due e due sta insieme, e a schermo
     grande i quattro entrano comunque in riga. */
  .route {
    flex: 1 1 min(100%, 21rem);
