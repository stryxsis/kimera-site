<script>
  /**
   * Regia della hero cinematica.
   *
   * Un solo compito: decidere QUANDO passare da `armed` a `revealed`. Tutto il
   * resto (che cosa si muove e con quale ritardo) è nel CSS, dove il browser lo
   * gestisce meglio di qualsiasi timer.
   *
   * Il principio è che il testo non può mai restare invisibile. Ogni cosa che
   * può andare storta — autoplay bloccato da una politica di risparmio dati,
   * video 404, rete lenta, scheda in background che congela `timeupdate` — ha
   * la sua uscita di sicurezza, e sopra tutte c'è un tetto temporale assoluto.
   */
  const stage = document.querySelector<HTMLElement>('[data-hero]');
  const video = stage?.querySelector<HTMLVideoElement>('[data-hero-video]');

  if (stage) {
    /**
     * Il ritmo del video: veloce per la maggior parte della corsa, poi un
     * rallentamento verso la fine che accompagna lo zoom mentre si assesta —
     * non è un semplice arrivo, è un respiro prima di fermarsi. `playbackRate`
     * non tocca `currentTime`/`duration`: sono sempre secondi di VIDEO, quindi
     * `LEAD_IN` e tutto il resto della logica sotto restano corretti a ogni
     * velocità, cambiata o no.
     */
    const FAST_RATE = 1.6;
    const SLOW_RATE = 0.5;
    /** Quanti secondi (di video) prima della fine comincia il rallentamento. */
    const SLOWDOWN_WINDOW = 2.6;
    /** Quanto prima della fine comincia la rivelazione del testo. */
    const LEAD_IN = 2.4;
    /**
     * Quanto si aspetta che il video abbia abbastanza buffer per partire.
     * Scaduto questo, la regia si annulla: il testo entra e il download viene
     * interrotto. Prima si aspettava lo stesso tempo ma il download proseguiva,
     * e il video finiva per riprodursi dietro allo scrim opaco — cioè si
     * pagavano i byte senza che si vedesse niente. Su rete mobile era la
     * situazione normale, non il caso limite.
     */
    const BUFFER_DEADLINE = 2500;
    /** Tetto assoluto: oltre questo il testo entra comunque. */
    const HARD_DEADLINE = 7000;

    const timers: number[] = [];
    let revealed = false;
    let rateLoop = 0;

    const reveal = () => {
      if (revealed) return;
      revealed = true;
      timers.forEach((id) => window.clearTimeout(id));
      window.cancelAnimationFrame(rateLoop);
      stage.setAttribute('data-hero-state', 'revealed');
      window.removeEventListener('scroll', reveal);
    };

    /**
     * Aggiorna `playbackRate` fotogramma per fotogramma: un `timeupdate` non
     * basta, scatta troppo di rado per una rampa che si deve sentire liscia.
     * `smoothstep` (3t²-2t³) invece di una rampa lineare: parte e arriva
     * piatta, così il cambio di velocità non si sente come uno scatto.
     */
    const rampPlaybackRate = (v: HTMLVideoElement) => {
      const end = v.duration;
      if (Number.isFinite(end) && end > 0) {
        const remaining = end - v.currentTime;
        const t = Math.max(0, Math.min(1, 1 - remaining / SLOWDOWN_WINDOW));
        const eased = t * t * (3 - 2 * t);
        v.playbackRate = FAST_RATE + (SLOW_RATE - FAST_RATE) * eased;
      }
      if (!v.paused && !v.ended) rateLoop = window.requestAnimationFrame(() => rampPlaybackRate(v));
    };

    /**
     * Porta il video sull'ultimo fotogramma senza riprodurlo. È la composizione
     * che il disegno vuole (la Terra in basso), e serve in due casi: quando
     * l'utente ha chiesto meno movimento e quando l'autoplay viene rifiutato.
     */
    const showLastFrame = () => {
      const end = video?.duration;
      if (video && Number.isFinite(end) && end! > 0) {
        video.currentTime = Math.max(0, end! - 0.04);
      }
    };

    /**
     * Interrompe lo scaricamento del video e libera quello già preso. Senza
     * questo, rinunciare alla regia non impedirebbe al file di continuare ad
     * arrivare: su una connessione a consumo sarebbero megabyte spesi per una
     * cosa che non si vedrà: lo scrim, a quel punto, è di nuovo opaco.
     */
    const abortVideo = () => {
      if (!video) return;
      video.removeAttribute('src');
      video.load();
    };

    /**
     * Quando NON vale la pena scaricare il video. Il risparmio dati esplicito
     * dell'utente e le connessioni lente sono un no secco: la hero funziona
     * senza, perché il poster e il gradiente sono già la composizione.
     * `navigator.connection` non esiste su Safari, e va bene — in quel caso si
     * prova, e se la banda non basta interviene comunque BUFFER_DEADLINE.
     */
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } })
      .connection;
    const frugal =
      window.matchMedia('(prefers-reduced-data: reduce)').matches ||
      !!conn?.saveData ||
      /(^|-)2g$/.test(conn?.effectiveType ?? '');

    // `armed` lo mette lo script inline nella sezione, e solo se il sistema non
    // ha chiesto di ridurre le animazioni. Se non c'è, il testo è già a schermo.
    const armed = stage.getAttribute('data-hero-state') === 'armed';

    if (!video || !armed || frugal) {
      // Nessuna regia da fare. Il poster resta a schermo e il testo è visibile:
      // non si scarica un video da mezzo megabyte per non riprodurlo.
      reveal();
    } else {
      /*
       * La sorgente si sceglie qui, non nel markup. Su un telefono in verticale
       * `object-fit: cover` mostra solo la fascia centrale del 16:9, quindi la
       * variante già ritagliata 9:16 fa vedere esattamente la stessa immagine
       * pesando un terzo. `matchMedia` è affidabile; l'attributo `media` su
       * <source> lo è molto meno, e non viene rivalutato.
       */
      const portrait = window.matchMedia('(max-width: 48rem) and (orientation: portrait)').matches;
      const src = portrait ? video.dataset.srcPortrait : video.dataset.srcWide;
      if (!src) {
        reveal();
      } else {
        timers.push(window.setTimeout(reveal, HARD_DEADLINE));

        video.addEventListener('timeupdate', () => {
          const end = video.duration;
          if (!Number.isFinite(end) || end <= 0) return;
          if (video.currentTime >= end - LEAD_IN) reveal();
        });
        video.addEventListener('ended', reveal);
        video.addEventListener('error', () => {
          abortVideo();
          reveal();
        });

        // Chi scorre ha già deciso di andare avanti, e chi arriva con il tabulatore
        // sta per mettere il fuoco su un bottone: in entrambi i casi la regia salta.
        const bail = () => {
          if (!revealed) abortVideo();
          reveal();
        };
        window.addEventListener('scroll', bail, { once: true, passive: true });
        stage.addEventListener('pointerdown', bail, { once: true });
        stage.addEventListener('focusin', bail, { once: true });

        /*
         * Si parte solo quando c'è abbastanza buffer. `canplay` è il primo
         * momento in cui il browser dice di poter mostrare qualcosa in
         * movimento; prima si chiamava `play()` immediatamente e il video
         * partiva a singhiozzo o non partiva affatto.
         */
        let started = false;
        const start = () => {
          if (started || revealed) return;
          started = true;
          // `play()` restituisce una promise: se il browser rifiuta l'autoplay
          // (iOS in risparmio energetico, per esempio) non resta un video fermo
          // sul primo fotogramma con la hero vuota sopra.
          video.play().then(
            () => {
              video.playbackRate = FAST_RATE;
              rateLoop = window.requestAnimationFrame(() => rampPlaybackRate(video));
            },
            () => {
              showLastFrame();
              reveal();
            },
          );
        };

        video.addEventListener('canplay', start, { once: true });
        timers.push(
          window.setTimeout(() => {
            if (!started) {
              abortVideo();
              reveal();
            }
          }, BUFFER_DEADLINE),
        );

        video.src = src;
        video.load();
      }
    }
  }
</script>
