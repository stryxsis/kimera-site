---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { BOOKING_FORM_URL } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';

/**
 * Corsi di lingua e traduzioni — l'area che l'analisi (§3) chiede esplicitamente,
 * e l'unica pagina che tiene insieme le due cose che Kimere fa con le STESSE
 * persone: insegnare le lingue e tradurre i documenti. Non è un servizio
 * accessorio, è il solo vantaggio competitivo dell'azienda che non dipenda da
 * accordi con terzi — e quindi l'unico che si può dimostrare oggi.
 *
 * Quattro cose da non dimenticare quando si torna qui.
 *
 * PRIMA: il blocco `documents` separa in modo esplicito COSA FA KIMERE da COSA
 * RESTA AGLI ENTI, ed è la parte più importante della pagina. Il brief chiede
 * per la terza volta di scrivere che Kimere «bypassa» la procedura CIMEA: non si
 * può, e qui meno che mai, perché è la pagina che vende quel servizio. La
 * traduzione e la legalizzazione sono passaggi che Kimere gestisce davvero in
 * casa; l'attestato di comparabilità lo rilascia CIMEA o lo valuta l'ateneo e
 * resta dov'è. Separarle non indebolisce l'offerta: la rende verificabile.
 *
 * SECONDA: le lingue sono OTTO e devono restare identiche a quelle di home e Chi
 * siamo. Il brief ne elenca sette perché ricopia l'analisi, che è precedente
 * alla conferma del cliente sull'italiano (2026-08-11).
 *
 * TERZA: due porte e non una in fondo alla pagina. Chi arriva con un diploma da
 * tradurre entro venerdì e chi vuole imparare il tedesco per settembre hanno
 * intenti opposti, e devono riconoscere il proprio prima di cliccare. Portano
 * allo stesso modulo Google, che chiede da sé di che cosa si tratta: i due
 * moduli interni sono stati rimossi su richiesta del cliente (2026-08-11).
 *
 * QUARTA: nessun caricamento di file, qui e nel modulo di destinazione. La
 * scansione di un diploma o di un passaporto è un dato personale, e la si
 * scambia su un canale concordato — non la si raccoglie con un modulo pubblico.
 *
 * Ritmo delle superfici: bianco → nebbia (l'academy) → bianco (i documenti) →
 * nebbia (il confronto) → NAVY (la CTA).
 */
const locale = 'en';
const t = useTranslations(locale);
const { data: content } = await getEntry('languageCoursesPage', locale)!;
---

<PageLayout
  locale={locale}
  routeKey="languageCourses"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
>
  <div class="languages surface-blank">
    {/* ── Hero: la doppia promessa ─────────────────────────────────────── */}
    <section class="wrap band band--first">
      <div class="masthead surface-panel">
        <Eyebrow tone="gold" class="animate-rise">{content.hero.eyebrow}</Eyebrow>
        <h1 class="heading-display masthead__title animate-rise" style="animation-delay:60ms">
          {content.hero.headline}
        </h1>
        <p class="lead-soft masthead__lead animate-rise" style="animation-delay:120ms">
          {content.hero.subhead}
        </p>
        {/* Le due porte già sopra la piega: l'urgenza e la pianificazione
            arrivano su questa pagina con intenti opposti. */}
        <div class="masthead__actions animate-rise" style="animation-delay:180ms">
          <Button href="#quote-form" size="lg" arrow>{content.hero.ctaDocuments}</Button>
          <Button href="#course-form" variant="secondary" size="lg" arrow>
            {content.hero.ctaCourses}
          </Button>
        </div>
        <p class="masthead__note animate-rise" style="animation-delay:240ms">
          {content.hero.reassurance}
        </p>
      </div>
    </section>

    {/* ── L'academy ─────────────────────────────────────────────────────── */}
    <section class="wrap band" id="academy" aria-labelledby="academy-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.academy.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="academy-heading">{content.academy.heading}</h2>
          <p class="lead-soft">{content.academy.body}</p>
        </div>

        {/* Le stesse otto pastiglie della home e di Chi siamo, di proposito:
            sono la stessa affermazione sulla stessa azienda. */}
        <div class="langs">
          <p class="langs__label">{content.academy.languagesLabel}</p>
          <ul class="chips">
            {content.academy.languages.map((language) => <li class="chip">{language}</li>)}
          </ul>
        </div>

        <ul class="cards">
          {
            content.academy.points.map((point) => (
              <li class="card-soft card">
                <span class="icon-badge">
                  <StepIcon name={point.icon} size={26} />
                </span>
                <h3 class="heading-card card__title">{point.title}</h3>
                <p class="card__body">{point.body}</p>
              </li>
            ))
          }
        </ul>

        <div class="section-action">
          <Button href="#course-form" variant="pill" arrow>{content.academy.ctaLabel}</Button>
        </div>
      </div>
    </section>

    {
      /* ── I documenti ────────────────────────────────────────────────────
        Il blocco più importante della pagina. Le due colonne «cosa facciamo
        noi» / «cosa resta agli enti» sono la versione onesta di quello che il
        brief chiama bypass: la traduzione e la legalizzazione sono davvero
        nostre, l'attestato di comparabilità no e non lo sarà mai. Chi
        confonde le due cose arriva con la domanda respinta. */
    }
    <section class="wrap band" id="documents" aria-labelledby="documents-heading">
      <div class="head">
        <Eyebrow>{content.documents.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="documents-heading">{content.documents.heading}</h2>
        <p class="lead-soft">{content.documents.body}</p>
      </div>

      {/* `docstep` e non `step`: quest'ultima è una classe globale che azzera i
          <fieldset> dei moduli più in basso nella stessa pagina, e lo scope di
          Astro non le terrebbe separate. */}
      <ol class="docsteps">
        {
          content.documents.steps.map((step, index) => (
            <li class="docstep">
              <div class="docstep__marker">
                <span class="docstep__num">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="heading-card docstep__title">{step.title}</h3>
              </div>
              <p class="docstep__body">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="split">
        <div class="split__col split__col--ours">
          <h3 class="split__title">{content.documents.handledHeading}</h3>
          <ul class="checklist">
            {content.documents.handled.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="split__col split__col--theirs">
          <h3 class="split__title">{content.documents.institutionsHeading}</h3>
          <ul class="checklist checklist--negative">
            {content.documents.institutions.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="limit">
        <h3 class="limit__title">{content.documents.limitHeading}</h3>
        <p class="limit__body">{content.documents.limitBody}</p>
        <a
          class="limit__link"
          href={content.documents.officialSource}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.process.officialSource}
          <svg
            viewBox="0 0 14 14"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 2h7v7M12 2 3 11"></path>
          </svg>
        </a>
      </div>

      <div class="section-action">
        <Button href="#quote-form" variant="pill" arrow>{content.documents.ctaLabel}</Button>
      </div>
    </section>

    {/* ── Il confronto ──────────────────────────────────────────────────── */}
    <section class="wrap band" id="comparison" aria-labelledby="comparison-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.comparison.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="comparison-heading">{content.comparison.heading}</h2>
          <p class="lead-soft">{content.comparison.body}</p>
        </div>

        <div class="versus">
          <div class="card-soft versus__col">
            <h3 class="versus__title">{content.comparison.traditionalLabel}</h3>
            <ul class="checklist checklist--negative">
              {content.comparison.traditional.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="card-soft versus__col versus__col--ours">
            <h3 class="versus__title">{content.comparison.kimereLabel}</h3>
            <ul class="checklist">
              {content.comparison.kimere.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>

        {/* Nessun «mai respinto»: nessuno controlla la commissione che legge il
            fascicolo. Si dice quale causa di rigetto si toglie di mezzo. */}
        <p class="note">{content.comparison.note}</p>
      </div>
    </section>

    {
      /* ── La conversione ─────────────────────────────────────────────────
        I due moduli interni sono stati rimossi (2026-08-11, richiesta del
        cliente): la raccolta contatti passa tutta dal modulo Google, che è
        già l'imbuto del resto del sito.

        Le due porte restano, e non è ridondanza: sono i due intenti opposti
        con cui si arriva su questa pagina — l'urgenza di un documento da
        tradurre e la pianificazione di un corso — e il lettore deve
        riconoscere il proprio prima di cliccare. Portano allo stesso modulo,
        che chiede da sé di che cosa si tratta.

        ⚠️ Gli id `quote-form` e `course-form` NON si possono rinominare: ci
        puntano le due CTA dell'hero, quella dell'academy e quella del blocco
        documenti. Sono ancore interne, e nessun controllo del build le
        verifica. */
    }
    <section class="wrap band" id="forms" aria-labelledby="forms-heading">
      <div class="ctaband surface-panel">
        <div class="ctaband__head">
          <Eyebrow tone="blank">{content.forms.eyebrow}</Eyebrow>
          <h2 class="heading-section ctaband__title" id="forms-heading">
            {content.forms.heading}
          </h2>
          <p class="ctaband__body">{content.forms.body}</p>
        </div>

        <div class="doors">
          <div class="door" id="quote-form" aria-labelledby="quote-heading">
            <h3 class="heading-card door__title" id="quote-heading">
              {content.forms.quote.heading}
            </h3>
            <p class="door__body">{content.forms.quote.body}</p>
            <Button
              href={BOOKING_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              size="lg"
              arrow
            >
              {content.forms.quote.ctaLabel}
            </Button>
          </div>

          <div class="door" id="course-form" aria-labelledby="course-heading">
            <h3 class="heading-card door__title" id="course-heading">
              {content.forms.course.heading}
            </h3>
            <p class="door__body">{content.forms.course.body}</p>
            <Button
              href={BOOKING_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              variant="secondary"
              size="lg"
              arrow
            >
              {content.forms.course.ctaLabel}
            </Button>
          </div>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .languages {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Fasce e intestazioni ─────────────────────────────────────────────── */
  .band {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  .band--first {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  /* Le ancore delle due porte: l'header è fisso e senza questo margine la
     fascia finirebbe sotto la barra. */
  #forms,
  #quote-form,
  #course-form {
    scroll-margin-top: 6rem;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .head .lead-soft {
    max-width: none;
  }
  .section-action {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .masthead {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.15rem;
    border-radius: var(--radius-2xl);
    padding: clamp(2.75rem, 7vw, 5.5rem) clamp(1.5rem, 4vw, 3rem);
  }
  .masthead__title {
    max-width: 19ch;
  }
  .masthead__lead {
    max-width: 64ch;
  }
  .masthead__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 1rem;
  }
  .masthead__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    max-width: 48ch;
    margin: 0;
  }

  /* ── Le pastiglie delle lingue ────────────────────────────────────────
     Identiche a quelle di home e Chi siamo, di proposito: otto voci brevi
     lette come catalogo, che è quello che sono. */
  .langs {
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .langs__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    padding: 0.5rem 0.95rem;
    background-color: var(--color-blank);
    border: 1px solid var(--color-mist-line);
    border-radius: var(--radius-pill);
    font-family: var(--font-titling);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  /* ── Schede ───────────────────────────────────────────────────────────── */
  .cards {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    flex: 1 1 min(100%, 19rem);
    min-width: min(100%, 19rem);
  }
  .card__title {
    margin-top: 1.15rem;
  }
  .card__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }

  /* ── I quattro passi del documento ────────────────────────────────────
     Prefisso `docstep` e non `step`: `.step` è una classe globale che azzera i
     <fieldset> dei due moduli, che stanno nella stessa pagina e quindi portano
     lo stesso attributo di scope — le regole si sovrapporrebbero. */
  .docsteps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docstep {
    display: grid;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2.5vw, 1.6rem) 0;
    border-top: 1px solid var(--surface-rule);
  }
  @media (min-width: 60rem) {
    .docstep {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2.5rem);
      align-items: start;
    }
  }
  .docstep__marker {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }
  .docstep__num {
    flex: none;
    font-family: var(--font-titling);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-mist-deep);
  }
  .docstep__body {
    color: var(--surface-fg-muted);
    margin: 0;
  }

  /* ── Cosa è nostro e cosa resta agli enti ─────────────────────────────
     Affiancate e di pari peso: è questa coppia, non una frase, a spiegare
     che cosa Kimere può davvero togliere di mezzo e cosa no. */
  .split {
    display: grid;
    gap: clamp(1.15rem, 2.5vw, 1.75rem);
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  @media (min-width: 56rem) {
    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .split__col {
    padding: clamp(1.35rem, 2.6vw, 1.9rem) clamp(1.35rem, 2.6vw, 2rem);
    border-radius: var(--radius-xl);
    background-color: var(--color-mist);
  }
  .split__col--ours {
    border-left: 3px solid var(--color-teal-ink);
    border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
  }
  .split__col--theirs {
    border-left: 3px solid var(--color-mist-line);
    border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
  }
  .split__title {
    font-family: var(--font-titling);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.9rem;
  }

  /* ── Il limite su CIMEA ───────────────────────────────────────────────── */
  .limit {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.35rem, 2.6vw, 1.9rem) clamp(1.35rem, 2.6vw, 2rem);
    border-left: 3px solid var(--color-teal-ink);
    border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
    background-color: var(--color-mist);
    max-width: 78rem;
  }
  .limit__title {
    font-family: var(--font-titling);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .limit__body {
    margin: 0.7rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--surface-fg-soft);
    max-width: none;
  }
  .limit__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-mist-line);
  }
  .limit__link:hover {
    color: var(--color-teal-ink);
    text-decoration-color: currentColor;
  }

  /* ── Il confronto ─────────────────────────────────────────────────────── */
  .versus {
    display: grid;
    gap: 1.15rem;
    align-items: stretch;
  }
  @media (min-width: 56rem) {
    .versus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .versus__col--ours {
    border-color: var(--color-teal-ink);
  }
  .versus__title {
    font-family: var(--font-titling);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 0.9rem;
  }
  .note {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--surface-fg-soft);
    max-width: none;
  }

  /* ── La CTA finale ────────────────────────────────────────────────────
     Su navy come la CTA finale delle altre pagine. Le due porte restano
     affiancate: devono vedersi insieme, altrimenti chi scorre trova la prima
     e non sa che esiste la seconda. */
  .ctaband {
    border-radius: var(--radius-2xl);
    padding: clamp(2rem, 5vw, 3.5rem);
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .ctaband__head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .ctaband__title {
    max-width: 24ch;
  }
  .ctaband__body {
    color: var(--surface-fg-muted);
    max-width: 62ch;
  }
  .doors {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    align-items: stretch;
  }
  @media (min-width: 56rem) {
    .doors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Il bottone va in fondo alla scheda anche quando i due testi hanno lunghezze
     diverse: due CTA non allineate leggono come due offerte di peso diverso. */
  .door {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.85rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background-color: var(--color-ground);
    border: 1px solid var(--color-panel-line);
    border-radius: var(--radius-xl);
  }
  .door__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin: 0 0 auto;
    padding-bottom: 0.75rem;
  }

</style>
