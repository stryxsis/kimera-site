---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { getPath } from '../../i18n/routes';
import { renderEmphasis } from '../../i18n/utils';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';

const locale = 'en';
const { data: content } = await getEntry('housingPage', locale)!;
---

<PageLayout locale={locale} routeKey="housing" title={content.intro.heading}>
  <Section surface="light">
    <p class="block-lead">{content.intro.body}</p>
  </Section>

  <Section>
    <div class="callout">
      <h2 class="callout__title">{content.visaParadox.heading}</h2>
      <p class="callout__body">{content.visaParadox.body}</p>
    </div>
  </Section>

  <Section surface="light" labelledby="scam-heading">
    <div class="callout callout--warning">
      <h2 class="callout__title" id="scam-heading">{content.scamWarning.heading}</h2>
      <p class="callout__body">{content.scamWarning.body}</p>
    </div>
    <ul class="checklist checklist--negative warning-signs">
      {content.scamWarning.warningSigns.map((sign) => <li>{sign}</li>)}
    </ul>
  </Section>

  <section class="two-col surface-panel">
    <div class="wrap two-col__grid">
      <div class="two-col__cell">
        <h2 class="block-heading" id="whatwedo-heading">{content.whatWeDo.heading}</h2>
        <ul class="checklist">
          {content.whatWeDo.items.map((item) => <li set:html={renderEmphasis(item)} />)}
        </ul>
      </div>

      <div class="two-col__cell">
        <h2 class="block-heading" id="whatwedont-heading">{content.whatWeDontDo.heading}</h2>
        <ul class="checklist checklist--negative">
          {content.whatWeDontDo.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Section surface="light" labelledby="costs-heading">
    <h2 class="block-heading" id="costs-heading">{content.costsByCity.heading}</h2>
    <dl class="kv-list costs-list">
      {
        content.costsByCity.cities.map((c) => (
          <div class="kv-row">
            <dt>{c.city}</dt>
            <dd>{c.range}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section labelledby="eu-heading">
    <h2 class="block-heading" id="eu-heading">{content.euSection.heading}</h2>
    <p class="block-lead">{content.euSection.body}</p>
  </Section>

  <Section surface="light" size="lg">
    <div class="closing-cta">
      <Button href={getPath('book', locale)}>{content.ctaLabel}</Button>
    </div>
  </Section>
</PageLayout>

<style>
  /* Il confronto affiancato "cosa facciamo / cosa non facciamo" esiste solo
     qui: non è un pattern generico del design system, è specifico di questa
     pagina. Una sola superficie pannello, due colonne separate da un filetto. */
  .two-col {
    padding-block: var(--spacing-section);
  }
  .two-col__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 56rem) {
    .two-col__grid {
      grid-template-columns: 1fr 1fr;
      gap: 0 3.5rem;
    }
    .two-col__cell:first-child {
      padding-right: 1.75rem;
      border-right: 1px solid var(--surface-rule);
    }
    .two-col__cell:last-child {
      padding-left: 1.75rem;
    }
  }

  .warning-signs {
    max-width: var(--container-prose);
    margin-top: 1.5rem;
  }

  .costs-list {
    max-width: 34rem;
  }
</style>
