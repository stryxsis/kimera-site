---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { getPath, BOOKING_FORM_URL } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';
import GlobeMesh from '../../components/illustrations/GlobeMesh.astro';
import MediaFrame from '../../components/ui/MediaFrame.astro';

/**
 * Chi siamo — la pagina più strategica del sito e quella con meno materiale a
 * disposizione: nessuno storico, nessun cliente da citare, nessuna fotografia
 * del team, una società non ancora formalizzata. In un settore dove studenti e
 * atenei hanno paura di affidarsi a entità senza volto, è normalmente il punto
 * in cui la fiducia si rompe.
 *
 * La risposta non è riempire quel vuoto con qualcosa di finto: è cambiare
 * l'oggetto della prova. Invece di dimostrare dimensione e anzianità — che non
 * ci sono — la pagina dimostra COME è fatta l'azienda, e argomenta che quella
 * forma (una rete di professionisti indipendenti in più paesi) è la ragione per
 * cui funziona, non un ripiego in attesa di diventare grandi.
 *
 * Tre scelte che vale la pena non dimenticare.
 *
 * PRIMA: il navy in apertura e chiusura. Senza fotografie il peso lo devono
 * portare tipografia e colore, e il navy è il colore del marchio — la pagina
 * risulta incorniciata invece che vuota. Ritmo simmetrico:
 * NAVY → bianco → nebbia → bianco → nebbia → bianco → NAVY.
 *
 * SECONDA: ILL-10 non è una mappa del mondo. Il brief chiedeva pin luminosi su
 * una mappa, ma dei pin dichiarano una presenza in paesi precisi e l'analisi
 * dice soltanto «più paesi» senza nominarne nessuno. Un reticolo astratto dice
 * «distribuito» senza dire dove — che è quanto si può sostenere oggi.
 *
 * TERZA: due riquadri di limite sono OBBLIGATORI e non sono prudenza eccessiva.
 * `match.honestNote` impedisce di promettere una copertura di nazionalità
 * universale che non esiste; `languages.limitBody` impedisce di promettere che
 * CIMEA si possa scavalcare — cosa che nessun privato può fare, e che farebbe
 * arrivare lo studente con una domanda respinta.
 */
const locale = 'it';
const t = useTranslations(locale);
const { data: content } = await getEntry('aboutPage', locale)!;
---

<PageLayout
  locale={locale}
  routeKey="about"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
>
  <div class="about surface-blank">
    {/* ── Hero: il manifesto ───────────────────────────────────────────── */}
    <section class="wrap band band--first">
      <div class="masthead surface-panel">
        <Eyebrow tone="gold" class="animate-rise">{content.hero.eyebrow}</Eyebrow>
        <h1 class="heading-display masthead__title animate-rise" style="animation-delay:60ms">
          {content.hero.headline}
        </h1>
        <p class="lead-soft masthead__lead animate-rise" style="animation-delay:120ms">
          {content.hero.subhead}
        </p>
        <div class="masthead__actions animate-rise" style="animation-delay:180ms">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" size="lg" arrow>
            {content.hero.ctaPrimary}
          </Button>
          <Button href="#match" variant="secondary" size="lg">
            {content.hero.ctaSecondary}
          </Button>
        </div>
      </div>
    </section>

    {
      /* ── Il match culturale ─────────────────────────────────────────────
        L'asso nella manica dell'analisi, e la prima sezione dopo l'hero
        perché è l'argomento che l'utente non ha già sentito da nessun
        concorrente. La nota finale non è una postilla difensiva: senza di
        essa il blocco promette un connazionale per ognuna delle ~190
        nazionalità possibili, e la promessa si rompe alla prima call. */
    }
    <section class="wrap band" id="match" aria-labelledby="match-heading">
      <div class="head">
        <Eyebrow>{content.match.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="match-heading">{content.match.heading}</h2>
        <p class="lead-soft">{content.match.body}</p>
      </div>

      <ul class="cards">
        {
          content.match.points.map((point) => (
            <li class="card-soft card">
              <span class="icon-badge">
                <StepIcon name={point.icon} size={26} />
              </span>
              <h3 class="heading-card card__title">{point.title}</h3>
              <p class="card__body">{point.body}</p>
            </li>
          ))
        }
      </ul>

      <p class="honest">{content.match.honestNote}</p>
    </section>

    {
      /* ── La rete globale ────────────────────────────────────────────────
        Come è composta l'azienda. Il reticolo di ILL-10 sta accanto ai tre
        fatti strutturali, non sopra di essi: il disegno è decorazione e
        l'informazione resta nel testo. Sotto, le persone — che è la parte
        che il lettore stava cercando quando ha cliccato «Chi siamo». */
    }
    <section class="wrap band" aria-labelledby="network-heading">
      <div class="panel-soft">
        <div class="network__top">
          <div class="head network__head">
            <Eyebrow>{content.network.eyebrow}</Eyebrow>
            <h2 class="heading-section" id="network-heading">{content.network.heading}</h2>
            <p class="lead-soft">{content.network.body}</p>
          </div>
          {/* Sotto le 60rem sparisce invece di schiacciarsi: non porta
              informazione, quindi non se ne perde nessuna. */}
          <div class="network__art"><GlobeMesh /></div>
        </div>

        <ul class="cards network__points">
          {
            content.network.points.map((point) => (
              <li class="card-soft card">
                <span class="icon-badge">
                  <StepIcon name={point.icon} size={26} />
                </span>
                <h3 class="heading-card card__title">{point.title}</h3>
                <p class="card__body">{point.body}</p>
              </li>
            ))
          }
        </ul>

        {
          /* Le persone. Il layout è quello definitivo: MediaFrame tiene già le
            proporzioni giuste e mostra un segnaposto dichiarato finché i file
            non arrivano in public/media/. Appena si valorizzano `photo` e
            `video` nel JSON i segnaposto spariscono da soli, senza toccare
            questo template. */
        }
        <div class="team">
          <div class="team__top">
            <div class="team__head">
              <h3 class="heading-section team__heading">{content.network.team.heading}</h3>
              <p class="team__body">{content.network.team.body}</p>
            </div>

            <figure class="team__intro">
              <MediaFrame
                video={content.network.team.intro.video}
                src={content.network.team.intro.poster}
                captions={content.network.team.intro.captions}
                captionsLang={locale}
                placeholder={content.network.team.intro.videoPlaceholder}
                ratio="16 / 9"
              />
              <figcaption class="team__intro-caption">
                <span class="team__intro-title">{content.network.team.intro.heading}</span>
                {content.network.team.intro.caption}
              </figcaption>
            </figure>
          </div>

          <ul class="team__grid">
            {
              content.network.team.members.map((member) => (
                <li class="member">
                  <MediaFrame
                    src={member.photo}
                    alt={member.photoAlt}
                    placeholder={member.photoPlaceholder}
                    ratio="4 / 5"
                  />
                  <div class="member__text">
                    {/* Il nome compare solo quando c'è: finché manca il consenso
                        della persona, la scheda parte dal ruolo — che è vero
                        comunque e si può pubblicare da subito. */}
                    {member.name && <p class="member__name">{member.name}</p>}
                    <p class="member__role">{member.role}</p>
                    <p class="member__bio">{member.bio}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {
      /* ── Le lingue e i servizi in casa ──────────────────────────────────
        Le pastiglie sono lo stesso elenco della home, e devono restare
        identiche: sono la stessa affermazione sulla stessa azienda. Il
        riquadro finale è il limite su CIMEA — obbligatorio, per le ragioni
        scritte in cima al file. */
    }
    <section class="wrap band" aria-labelledby="languages-heading">
      <div class="head">
        <Eyebrow>{content.languages.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="languages-heading">{content.languages.heading}</h2>
        <p class="lead-soft">{content.languages.body}</p>
      </div>

      <div class="langs">
        <p class="langs__label">{content.languages.languagesLabel}</p>
        <ul class="chips">
          {content.languages.languages.map((language) => <li class="chip">{language}</li>)}
        </ul>
      </div>

      <ul class="cards">
        {
          content.languages.inHouse.map((item) => (
            <li class="card-soft card">
              <span class="icon-badge">
                <StepIcon name={item.icon} size={26} />
              </span>
              <h3 class="heading-card card__title">{item.title}</h3>
              <p class="card__body">{item.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="limit">
        <h3 class="limit__title">{content.languages.limitHeading}</h3>
        <p class="limit__body">{content.languages.limitBody}</p>
        <a
          class="limit__link"
          href={content.languages.officialSource}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.process.officialSource}
          <svg
            viewBox="0 0 14 14"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 2h7v7M12 2 3 11" />
          </svg>
        </a>
      </div>
    </section>

    {/* ── Sempre connessi ──────────────────────────────────────────────── */}
    <section class="wrap band" aria-labelledby="connected-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.connected.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="connected-heading">{content.connected.heading}</h2>
          <p class="lead-soft">{content.connected.body}</p>
        </div>

        {/* Niente icone qui: le portano già tre sezioni sopra, e questa è la
            più breve della pagina — un elenco a filetti si legge meglio. */}
        <ul class="rules">
          {
            content.connected.points.map((point) => (
              <li class="rule">
                <h3 class="heading-card rule__title">{point.title}</h3>
                <p class="rule__body">{point.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      /* ── I limiti, dichiarati ───────────────────────────────────────────
        Non è nel brief di questa pagina, ed è tenuto comunque: Chi siamo è
        la pagina dove un lettore diffidente va a cercare cosa NON si può
        fare, e su un sito che tratta visti e bonifici internazionali
        toglierlo sarebbe una regressione, non una semplificazione. */
    }
    <section class="wrap band" aria-labelledby="limits-heading">
      <div class="head">
        <h2 class="heading-section" id="limits-heading">{content.limits.heading}</h2>
      </div>
      <ul class="checklist checklist--negative limits__list">
        {content.limits.items.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    {
      /* ── Conversione, sdoppiata ─────────────────────────────────────────
        Mai un vicolo cieco in fondo alla pagina, e mai lo stesso imbuto per
        due lettori diversi: lo studente va al questionario, l'ateneo al form
        B2B, dove l'opzione «seminario gratuito» è già in cima all'elenco. */
    }
    <section class="wrap band" aria-labelledby="cta-heading">
      <div class="finalcta surface-panel">
        <Eyebrow tone="blank">{content.finalCta.eyebrow}</Eyebrow>
        <h2 class="heading-section finalcta__title" id="cta-heading">
          {content.finalCta.heading}
        </h2>
        <p class="finalcta__body">{content.finalCta.body}</p>

        <div class="doors">
          <div class="door">
            <Button
              href={BOOKING_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              size="lg"
              arrow
            >
              {content.finalCta.studentLabel}
            </Button>
            <p class="door__note">{content.finalCta.studentNote}</p>
          </div>

          <div class="door">
            <Button
              href={`${getPath('partners', locale)}#partner-form`}
              variant="secondary"
              size="lg"
              arrow
            >
              {content.finalCta.institutionLabel}
            </Button>
            <p class="door__note">{content.finalCta.institutionNote}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .about {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Fasce e intestazioni ─────────────────────────────────────────────── */
  .band {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  .band--first {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  /* L'ancora del bottone secondario dell'hero: l'header è sticky e senza questo
     margine la fascia finirebbe sotto la barra. */
  #match {
    scroll-margin-top: 6rem;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .head .lead-soft {
    max-width: none;
  }
  .heading-section + p {
    margin-top: 0.75rem;
  }

  /* ── Hero ─────────────────────────────────────────────────────────────
     Senza fotografie il peso istituzionale lo portano tipografia e colore:
     campo navy pieno, titolo grande, testo centrato. */
  .masthead {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.15rem;
    border-radius: var(--radius-2xl);
    padding: clamp(2.75rem, 7vw, 5.5rem) clamp(1.5rem, 4vw, 3rem);
  }
  .masthead__title {
    max-width: 18ch;
  }
  .masthead__lead {
    max-width: 64ch;
  }
  .masthead__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  /* ── Griglia di schede, condivisa da tre sezioni ──────────────────────── */
  .cards {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    flex: 1 1 min(100%, 19rem);
    min-width: min(100%, 19rem);
  }
  .card__title {
    margin-top: 1.15rem;
  }
  .card__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }

  /* Il limite del match culturale: bordo d'accento, non una nota in corpo 10.
     È ciò che rende credibile la promessa del blocco qui sopra. */
  .honest {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.2rem, 2.5vw, 1.75rem);
    border-left: 3px solid var(--color-teal-ink);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background-color: var(--color-mist);
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--surface-fg-soft);
  }

  /* ── La rete globale ──────────────────────────────────────────────────── */
  .network__top {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .network__top {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }
  .network__head {
    margin-bottom: 0;
  }
  .network__art {
    display: none;
  }
  @media (min-width: 60rem) {
    .network__art {
      display: block;
      max-width: 24rem;
      margin-inline: auto;
    }
  }
  .network__points {
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  /* ── Le persone ───────────────────────────────────────────────────────── */
  .team {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--surface-rule);
  }
  /* Intestazione a sinistra e video a destra: due colonne entrambe piene,
     non un titolo spinto a metà pagina con il vuoto accanto. */
  .team__top {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 64rem) {
    .team__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }
  .team__heading {
    max-width: 18ch;
  }
  .team__body {
    margin-top: 0.75rem;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--surface-fg-muted);
  }
  .team__intro {
    margin: 0;
  }
  .team__intro-caption {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.9rem;
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
  }
  .team__intro-title {
    font-family: var(--font-titling);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  /* Contenitore più stretto della griglia qui sopra: a piena larghezza tre
     ritratti 4:5 diventerebbero tre colonne altissime. */
  .team__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: center;
    gap: 1.15rem;
    max-width: 62rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }
  .member {
    display: flex;
    flex-direction: column;
    flex: 1 1 min(100%, 15rem);
    min-width: min(100%, 15rem);
    background-color: var(--color-blank);
    border: 1px solid var(--color-mist-line);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    /* il ritratto arriva a filo dei bordi della scheda */
    overflow: hidden;
  }
  /* MediaFrame arrotonda il proprio riquadro: dentro una scheda già
     arrotondata quel raggio si vedrebbe come un doppio bordo. `:global` perché
     l'elemento lo rende un componente figlio e non porta lo scope di questa
     pagina — stesso motivo per cui la filigrana del footer sta in global.css. */
  .member :global(.media) {
    border-radius: 0;
  }
  .member__text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: clamp(1.1rem, 2.2vw, 1.4rem);
  }
  .member__name {
    font-family: var(--font-titling);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0;
  }
  /* Senza nome il ruolo è il titolo della scheda e ne prende il peso; con il
     nome scala a etichetta d'accento sotto di esso. */
  .member__role {
    font-family: var(--font-titling);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--color-ink);
    margin: 0;
  }
  .member__name + .member__role {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }
  .member__bio {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin: 0.35rem 0 0;
  }

  /* ── Le lingue ────────────────────────────────────────────────────────── */
  /* Pastiglie e non elenco puntato: otto voci brevi lette come catalogo, che è
     quello che sono. Identiche a quelle della home, di proposito. */
  .langs {
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .langs__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    padding: 0.5rem 0.95rem;
    background-color: var(--color-mist);
    border: 1px solid var(--color-mist-line);
    border-radius: var(--radius-pill);
    font-family: var(--font-titling);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  /* Il limite su CIMEA. Stesso trattamento del gemello in home: dichiarare
     cosa NON si può fare è ciò che rende credibile il blocco sopra. */
  .limit {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.35rem, 2.6vw, 1.9rem) clamp(1.35rem, 2.6vw, 2rem);
    border-left: 3px solid var(--color-teal-ink);
    border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
    background-color: var(--color-mist);
    max-width: 78rem;
  }
  .limit__title {
    font-family: var(--font-titling);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .limit__body {
    margin: 0.7rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--surface-fg-soft);
  }
  .limit__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-mist-line);
  }
  .limit__link:hover {
    color: var(--color-teal-ink);
    text-decoration-color: currentColor;
  }

  /* ── Sempre connessi ──────────────────────────────────────────────────── */
  .rules {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rule {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) 0;
    border-top: 1px solid var(--surface-rule);
  }
  .rule:last-child {
    padding-bottom: 0;
  }
  @media (min-width: 60rem) {
    .rule {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2.5rem);
      align-items: start;
    }
  }
