---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { BOOKING_FORM_URL } from '../../i18n/routes';
import { useTranslations, renderEmphasis } from '../../i18n/utils';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';

/**
 * Per gli studenti — la pagina B2C, e l'unica del sito che deve vendere.
 * Il lettore ha vent'anni, non teme l'esame di ammissione: teme le scartoffie,
 * i soldi e la lingua. Ogni blocco toglie una di quelle tre paure e poi lo
 * consegna al questionario, che è l'unico ingresso all'imbuto.
 *
 * Quattro cose da non dimenticare quando si torna qui.
 *
 * PRIMA: il prezzo è scoperto, e solo qui. È una deroga esplicita del cliente
 * (2026-08-11) alla regola «nessun prezzo sul sito», e vale SOLO per la
 * Consulenza Strategica Base: i tre livelli di `packages` e la home restano
 * senza listino. Il senso è filtrare — chi arriva alla call sa già la cifra.
 *
 * SECONDA: `pricing.notIncluded` non è una postilla legale, è la ragione per cui
 * il prezzo si può pubblicare senza mentire. Una sessione pagata non è il
 * pacchetto di relocation e non garantisce un'ammissione, e dirlo PRIMA del
 * pagamento è la differenza tra un contatto qualificato e un rimborso.
 *
 * TERZA: `pricing.billingNote` sta accanto alla cifra e non in fondo alla
 * pagina. La cifra è in dollari, il lettore italiano è un consumatore e nessuno
 * qui può dedurre il regime IVA di Kimere: la nota dice la valuta e rimanda
 * l'importo definitivo a una conferma scritta, che è vero e non inventa nulla.
 *
 * QUARTA: il limite su CIMEA è lo stesso di home e Chi siamo. Il brief chiedeva
 * di dire che Kimere «bypassa» la procedura: non si può — l'attestato di
 * comparabilità lo rilascia CIMEA o l'ateneo — e su questa pagina meno che mai,
 * perché è quella su cui il lettore decide se pagare.
 *
 * Ritmo delle superfici, come in Chi siamo: NAVY → bianco → nebbia → bianco →
 * nebbia → NAVY. Senza fotografie il peso lo portano tipografia e colore.
 */
const locale = 'it';
const t = useTranslations(locale);
const { data: content } = await getEntry('forStudentsPage', locale)!;

/**
 * `audience` è una chiave, non un URL (stessa regola della home). Qui le due
 * destinazioni sono ancore di questa stessa pagina: chi viene dall'estero vuole
 * vedere cosa gli togliamo di mano, chi è indeciso vuole sapere come funziona
 * (e quanto costa) la consulenza. Mandarli entrambi al modulo salterebbe
 * esattamente l'argomento che li convince.
 */
const PATH_TARGETS = {
  international: '#lifelines',
  undecided: '#pricing',
} satisfies Record<(typeof content.identikit.paths)[number]['audience'], string>;
---

<PageLayout
  locale={locale}
  routeKey="forStudents"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
>
  <div class="students surface-blank">
    {/* ── Hero: la promessa emotiva, non l'elenco dei servizi ──────────── */}
    <section class="wrap band band--first">
      <div class="masthead surface-panel">
        <Eyebrow tone="gold" class="animate-rise">{content.hero.eyebrow}</Eyebrow>
        <h1 class="heading-display masthead__title animate-rise" style="animation-delay:60ms">
          {content.hero.headline}
        </h1>
        <p
          class="lead-soft masthead__lead animate-rise"
          style="animation-delay:120ms"
          set:html={renderEmphasis(content.hero.subhead)}
        />
        <div class="masthead__actions animate-rise" style="animation-delay:180ms">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" size="lg" arrow>
            {content.hero.ctaPrimary}
          </Button>
          <Button href="#lifelines" variant="secondary" size="lg">
            {content.hero.ctaSecondary}
          </Button>
        </div>
        <p class="masthead__note animate-rise" style="animation-delay:240ms">
          {content.hero.reassurance}
        </p>
      </div>
    </section>

    {
      /* ── Identikit: auto-segmentazione ─────────────────────────────────
        Due lettori con quasi nulla in comune da chiedere. Le due schede
        hanno lo stesso peso visivo di proposito: chi legge deve riconoscere
        la propria, non dedurre quale sia quella «giusta». */
    }
    <section class="wrap band" id="identikit" aria-labelledby="identikit-heading">
      <div class="head">
        <Eyebrow>{content.identikit.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="identikit-heading">{content.identikit.heading}</h2>
        <p class="lead-soft">{content.identikit.body}</p>
      </div>

      <ul class="paths">
        {
          content.identikit.paths.map((path) => (
            <li class="card-soft path">
              <span class="icon-badge">
                <StepIcon name={path.icon} size={26} />
              </span>
              <h3 class="heading-card path__title">{path.title}</h3>
              <p class="path__body" set:html={renderEmphasis(path.body)} />
              <ul class="checklist path__points">
                {path.points.map((point) => (
                  <li set:html={renderEmphasis(point)} />
                ))}
              </ul>
              <div class="path__action">
                <Button href={PATH_TARGETS[path.audience]} variant="secondary" arrow>
                  {path.ctaLabel}
                </Button>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    {
      /* ── «Salvavita»: i pain point tecnici, uno per uno ────────────────
        Nessuna cifra, nessuna soglia e nessuna scadenza che il sito non
        dichiari già altrove con la sua fonte: è la pagina su cui un genitore
        che finanzia farà i propri controlli. */
    }
    <section class="wrap band" id="lifelines" aria-labelledby="lifelines-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.lifelines.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="lifelines-heading">{content.lifelines.heading}</h2>
          <p class="lead-soft">{content.lifelines.body}</p>
        </div>

        <ul class="cards">
          {
            content.lifelines.items.map((item) => (
              <li class="card-soft card">
                <span class="icon-badge">
                  <StepIcon name={item.icon} size={26} />
                </span>
                <h3 class="heading-card card__title">{item.title}</h3>
                <p class="card__body" set:html={renderEmphasis(item.body)} />
              </li>
            ))
          }
        </ul>

        <p class="note" set:html={renderEmphasis(content.lifelines.note)} />
        <a
          class="source"
          href={content.lifelines.officialSource}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.process.officialSource}
          <svg
            viewBox="0 0 14 14"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 2h7v7M12 2 3 11"></path>
          </svg>
        </a>
      </div>
    </section>

    {
      /* ── Documenti: il vantaggio competitivo vero ───────────────────────
        Il riquadro finale è obbligatorio: dice che il requisito CIMEA non
        sparisce. Vedi la quarta nota in cima al file. */
    }
    <section class="wrap band" id="documents" aria-labelledby="documents-heading">
      <div class="head">
        <Eyebrow>{content.documents.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="documents-heading">{content.documents.heading}</h2>
        <p class="lead-soft">{content.documents.body}</p>
      </div>

      <ul class="cards">
        {
          content.documents.items.map((item) => (
            <li class="card-soft card">
              <span class="icon-badge">
                <StepIcon name={item.icon} size={26} />
              </span>
              <h3 class="heading-card card__title">{item.title}</h3>
              <p class="card__body" set:html={renderEmphasis(item.body)} />
            </li>
          ))
        }
      </ul>

      <div class="limit">
        <h3 class="limit__title">{content.documents.limitHeading}</h3>
        <p class="limit__body" set:html={renderEmphasis(content.documents.limitBody)} />
        <a
          class="source"
          href={content.documents.officialSource}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.process.officialSource}
          <svg
            viewBox="0 0 14 14"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 2h7v7M12 2 3 11"></path>
          </svg>
        </a>
      </div>
    </section>

    {
      /* ── Il prezzo, scoperto ───────────────────────────────────────────
        La cifra sta in una scheda bianca dentro la fascia nebbia, non su un
        campo navy: due blocchi scuri consecutivi (questo e la CTA finale)
        toglierebbero peso proprio alla CTA. La nota sulla fatturazione sta
        DENTRO la scheda, sotto il bottone, dove la legge chi sta per
        cliccare — non in fondo alla pagina, dove non la legge nessuno. */
    }
    <section class="wrap band" id="pricing" aria-labelledby="pricing-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.pricing.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="pricing-heading">{content.pricing.heading}</h2>
          <p class="lead-soft">{content.pricing.body}</p>
        </div>

        <div class="price">
          <div class="card-soft price__card">
            <p class="price__plan">{content.pricing.planName}</p>
            <p class="price__value">{content.pricing.price}</p>
            <p class="price__unit">{content.pricing.priceUnit}</p>
            <Button
              href={BOOKING_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="price__cta"
              arrow
            >
              {content.pricing.ctaLabel}
            </Button>
            <p class="price__billing" set:html={renderEmphasis(content.pricing.billingNote)} />
          </div>

          <div class="price__detail">
            <h3 class="heading-card price__subhead">{content.pricing.stepsHeading}</h3>
            <ol class="steps-numbered price__steps">
              {
                content.pricing.steps.map((step) => (
                  <li>
                    <span class="price__step-title">{step.title}</span>
                    <span set:html={renderEmphasis(step.body)} />
                  </li>
                ))
              }
            </ol>

            <div class="price__lists">
              <div class="price__list">
                <h3 class="price__list-title">{content.pricing.includedHeading}</h3>
                <ul class="checklist">
                  {content.pricing.included.map((item) => <li set:html={renderEmphasis(item)} />)}
                </ul>
              </div>

              <div class="price__list">
                <h3 class="price__list-title">{content.pricing.notIncludedHeading}</h3>
                <ul class="checklist checklist--negative">
                  {
                    content.pricing.notIncluded.map((item) => (
                      <li set:html={renderEmphasis(item)} />
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Il questionario, unico ingresso all'imbuto ────────────────────── */}
    <section class="wrap band" aria-labelledby="cta-heading">
      <div class="finalcta surface-panel">
        <Eyebrow tone="blank">{content.finalCta.eyebrow}</Eyebrow>
        <h2 class="heading-section finalcta__title" id="cta-heading">
          {content.finalCta.heading}
        </h2>
        <p class="finalcta__body" set:html={renderEmphasis(content.finalCta.body)} />
        <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" size="lg" arrow>
          {content.finalCta.ctaLabel}
        </Button>
        <p class="finalcta__note">{content.finalCta.note}</p>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .students {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Fasce e intestazioni ─────────────────────────────────────────────── */
  .band {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  .band--first {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  /* Le ancore delle due schede dell'identikit: l'header è fisso e senza questo
     margine la fascia finirebbe sotto la barra. */
  #lifelines,
  #pricing {
    scroll-margin-top: 6rem;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .head .lead-soft {
    max-width: none;
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .masthead {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.15rem;
    border-radius: var(--radius-2xl);
    padding: clamp(2.75rem, 7vw, 5.5rem) clamp(1.5rem, 4vw, 3rem);
  }
  .masthead__title {
    max-width: 17ch;
  }
  .masthead__lead {
    max-width: 64ch;
  }
  .masthead__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 1rem;
  }
  .masthead__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    max-width: 46ch;
    margin: 0;
  }

  /* ── Identikit ────────────────────────────────────────────────────────
     Due schede di pari peso, e più larghe delle card ordinarie: ognuna porta
     un elenco, e a 19rem le voci andrebbero a capo ogni due parole. */
  .paths {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .path {
    flex: 1 1 min(100%, 26rem);
    min-width: min(100%, 26rem);
  }
  .path__title {
    margin-top: 1.15rem;
  }
  .path__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }
  .path__points {
    margin-top: 1.15rem;
  }
  /* L'azione va in fondo alla scheda anche quando i due elenchi hanno lunghezze
     diverse: due bottoni non allineati leggono come due offerte diverse. */
  .path__action {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  /* ── Griglie di schede, condivise da due sezioni ──────────────────────── */
  .cards {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    flex: 1 1 min(100%, 19rem);
    min-width: min(100%, 19rem);
  }
  .card__title {
    margin-top: 1.15rem;
  }
  .card__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }

  .note {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--surface-fg-soft);
    max-width: 82ch;
  }

  /* Rimando alla fonte ufficiale: ogni affermazione procedurale ne porta uno. */
  .source {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-mist-line);
  }
  .source:hover {
    color: var(--color-teal-ink);
    text-decoration-color: currentColor;
  }

  /* ── Il limite su CIMEA ───────────────────────────────────────────────── */
  .limit {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.35rem, 2.6vw, 1.9rem) clamp(1.35rem, 2.6vw, 2rem);
    border-left: 3px solid var(--color-teal-ink);
    border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
    background-color: var(--color-mist);
    max-width: 78rem;
  }
  .limit__title {
    font-family: var(--font-titling);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .limit__body {
    margin: 0.7rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--surface-fg-soft);
    max-width: 88ch;
  }

  /* ── Il prezzo ────────────────────────────────────────────────────────
     Scheda a sinistra e dettaglio a destra: la cifra resta sempre visibile
     accanto a ciò che la giustifica, invece di stare in cima e farsi
     dimenticare mentre si legge il resto. */
  .price {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .price {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    }
    .price__card {
      position: sticky;
      top: 6rem;
    }
  }
  .price__card {
    text-align: center;
    align-items: center;
  }
  .price__plan {
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-accent);
    margin: 0;
  }
  /* L'oro su bianco è 2.33 e non può portare testo: la cifra è navy. */
  .price__value {
    font-family: var(--font-titling);
    font-size: var(--text-5xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin: 0.5rem 0 0;
  }
  .price__unit {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin: 0.35rem 0 0;
  }
  .price__cta {
    width: 100%;
    margin-top: 1.5rem;
  }
  .price__billing {
    margin: 1.1rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-mist-line);
    font-size: var(--text-xs);
    line-height: 1.6;
    text-align: left;
    color: var(--surface-fg-muted);
  }
  .price__subhead {
    margin-bottom: 0.5rem;
  }
  .price__steps {
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  .price__step-title {
    display: block;
    font-family: var(--font-titling);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    margin-bottom: 0.3rem;
  }
  .price__lists {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }
  @media (min-width: 46rem) {
    .price__lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .price__list-title {
    font-family: var(--font-titling);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
  }

  /* ── CTA finale ───────────────────────────────────────────────────────── */
  .finalcta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.15rem;
    border-radius: var(--radius-2xl);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .finalcta__title {
    max-width: 22ch;
  }
  .finalcta__body {
    color: var(--surface-fg-muted);
    max-width: 58ch;
  }
  .finalcta__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    max-width: 46ch;
    margin: 0;
  }
</style>
