---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { getPath, BOOKING_FORM_URL, type RouteKey } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';

/**
 * Home — uno smistatore, non una vetrina.
 *
 * L'analisi strategica aggiornata dà a Kimere quattro destinatari con bisogni
 * quasi disgiunti: studente che ha scelto, studente indeciso, ateneo, agenzia.
 * Una home che parlasse a tutti e quattro contemporaneamente non parlerebbe a
 * nessuno, quindi la pagina fa una cosa sola per due volte: sopra la piega
 * separa B2C da B2B con due bottoni, subito sotto separa i quattro problemi con
 * quattro box. Tutto il resto della pagina è materiale di supporto a quella
 * decisione, non un secondo argomento di vendita.
 *
 * Tre scelte deliberate che vale la pena non dimenticare.
 *
 * PRIMA: nessun prezzo. I price point esistono nell'analisi ($1.000 / $200 /
 * $180) ma la decisione confermata è di tenerli fuori dal sito — la cifra si
 * dice in call. La «consulenza strategica» si nomina come prodotto, mai come
 * importo.
 *
 * SECONDA: due dei quattro box puntano a destinazioni provvisorie ma REALI, non
 * a pagine che non esistono. Studente indeciso → il form di qualificazione;
 * ateneo → il form B2B, dove è stata aggiunta l'opzione «seminario gratuito».
 * Quando esisteranno /orientamento/ e /universita/ basta cambiare la mappa
 * ROUTES_BY_AUDIENCE qui sotto: il contenuto non contiene URL.
 *
 * TERZA: il tono è più giovane e diretto di quello delle altre pagine (ToV da
 * startup, richiesto dall'analisi §3) ma il sistema visivo è invariato — navy,
 * oro, griglie e componenti restano quelli approvati.
 */
const locale = 'it';
const t = useTranslations(locale);
const { data: content } = await getEntry('homePage', locale)!;

/**
 * Dove porta ciascun box del bivio. La mappa sta QUI e non nel JSON di contenuto:
 * un URL scritto a mano dentro un file di contenuto è un link morto che nessun
 * controllo intercetta, mentre `getPath()` rompe la build se la route non esiste.
 *
 * `student-undecided` e `university` sono provvisori — puntano ai due form
 * invece che a pagine dedicate, che non esistono ancora. Sono imbuti funzionanti,
 * non vicoli ciechi: chi arriva dal box «lavoro per un'università» trova nel
 * form l'opzione «il seminario online gratuito» già in cima all'elenco.
 */
const ROUTES_BY_AUDIENCE = {
  'student-abroad': { route: 'services' as RouteKey },
  'student-undecided': { external: BOOKING_FORM_URL },
  university: { route: 'partners' as RouteKey, hash: '#partner-form' },
  agency: { route: 'partners' as RouteKey },
} satisfies Record<string, { route?: RouteKey; hash?: string; external?: string }>;

function hrefFor(audience: keyof typeof ROUTES_BY_AUDIENCE) {
  const target = ROUTES_BY_AUDIENCE[audience];
  if ('external' in target) return target.external;
  return getPath(target.route, locale) + ('hash' in target ? target.hash : '');
}

/** Un link esterno va aperto in una scheda nuova e isolato da questa pagina. */
function isExternal(href: string) {
  return href.startsWith('http');
}
---

<PageLayout
  locale={locale}
  routeKey="home"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
>
  <div class="home surface-blank">
    {
      /* ── Hero ───────────────────────────────────────────────────────────
        A colonna sola e centrato, senza illustrazione: il primo evento
        visivo della pagina devono essere i quattro box, non un disegno che
        ci competa. L'hero fa il bivio grossolano e si toglie di mezzo. */
    }
    <section class="wrap hero">
      <div class="hero__inner">
        <Eyebrow class="animate-rise">{content.hero.eyebrow}</Eyebrow>
        <h1 class="heading-display hero__title animate-rise" style="animation-delay:60ms">
          {content.hero.headline}
        </h1>
        <p class="lead-soft hero__lead animate-rise" style="animation-delay:120ms">
          {content.hero.subhead}
        </p>
        <div class="hero__actions animate-rise" style="animation-delay:180ms">
          <Button href="#routing" variant="pill" size="lg" arrow>
            {content.hero.ctaStudent}
          </Button>
          <Button href={getPath('partners', locale)} variant="pill-ghost" size="lg">
            {content.hero.ctaInstitution}
          </Button>
        </div>
        <p class="hero__note animate-rise" style="animation-delay:240ms">
          {t.cta.freeNoObligation}
        </p>
      </div>
    </section>

    {
      /* ── Il bivio ───────────────────────────────────────────────────────
        Il centro di gravità della pagina. I box sono divisi per PROBLEMA e
        non per prodotto: il visitatore riconosce la propria situazione senza
        dover dedurre quale servizio gli spetti. `audience` è una chiave, e
        l'href lo risolve ROUTES_BY_AUDIENCE qui sopra. */
    }
    <section class="wrap band" id="routing" aria-labelledby="routing-heading">
      <div class="head">
        <Eyebrow>{content.routing.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="routing-heading">{content.routing.heading}</h2>
        <p class="lead-soft">{content.routing.body}</p>
      </div>

      <ul class="routes">
        {
          content.routing.boxes.map((box) => {
            const href = hrefFor(box.audience);
            const external = isExternal(href);
            return (
              <li class="card-soft route">
                <span class="icon-badge">
                  <StepIcon name={box.icon} size={26} />
                </span>
                <h3 class="heading-card route__title">{box.title}</h3>
                <p class="route__body">{box.body}</p>
                <p class="route__cta">
                  <Button
                    href={href}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                    variant="pill-ghost"
                    size="sm"
                    arrow
                  >
                    {box.ctaLabel}
                  </Button>
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>

    {
      /* ── I superpoteri ──────────────────────────────────────────────────
        Il differenziante vero secondo l'analisi: non la tecnologia (dove
        Kimere perde contro chiunque abbia una dashboard) ma il team
        multiculturale. Le sette lingue NON stanno qui: stanno nel blocco
        dei corsi, dove sono un prodotto invece di un vanto. */
    }
    <section class="wrap band" aria-labelledby="strengths-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.strengths.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="strengths-heading">{content.strengths.heading}</h2>
          <p class="lead-soft">{content.strengths.body}</p>
        </div>

        <ul class="strengths">
          {
            content.strengths.points.map((point) => (
              <li class="card-soft strength">
                <span class="icon-badge">
                  <StepIcon name={point.icon} size={26} />
                </span>
                <h3 class="heading-card strength__title">{point.title}</h3>
                <p class="strength__body">{point.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      /* ── Zero burocrazia ────────────────────────────────────────────────
        I pain point che fermano davvero: soldi e documenti, non ammissione.
        Il riquadro `limit` alla fine è OBBLIGATORIO e non è prudenza
        eccessiva: l'analisi dice che Kimere «bypassa» la procedura CIMEA,
        ma l'attestato di comparabilità lo rilascia CIMEA o l'ateneo e
        nessun privato può renderlo superfluo. Promettere il contrario
        farebbe arrivare lo studente con una domanda respinta — e il
        vantaggio vero (traduzione in casa, pratica seguita) si regge da sé. */
    }
    <section class="wrap band" aria-labelledby="bureaucracy-heading">
      <div class="head">
        <Eyebrow>{content.bureaucracy.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="bureaucracy-heading">{content.bureaucracy.heading}</h2>
        <p class="lead-soft">{content.bureaucracy.body}</p>
      </div>

      <ul class="hurdles">
        {
          content.bureaucracy.items.map((item) => (
            <li class="card-soft hurdle">
              <span class="icon-badge">
                <StepIcon name={item.icon} size={26} />
              </span>
              <h3 class="heading-card hurdle__title">{item.title}</h3>
              <p class="hurdle__body">{item.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="limit">
        <h3 class="limit__title">{content.bureaucracy.limitHeading}</h3>
        <p class="limit__body">{content.bureaucracy.limitBody}</p>
        <a
          class="limit__link"
          href={content.bureaucracy.officialSource}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.process.officialSource}
          <svg
            viewBox="0 0 14 14"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 2h7v7M12 2 3 11" />
          </svg>
        </a>
      </div>
    </section>

    {
      /* ── Il canale B2B ──────────────────────────────────────────────────
        Il seminario gratuito è il lead magnet più pulito dell'analisi, e la
        CTA di questo blocco NON è «contattaci»: è la prenotazione del
        seminario. Su navy perché è la seconda conversione della pagina e
        deve pesare quanto la prima. */
    }
    <section class="wrap band" aria-labelledby="universities-heading">
      <div class="panel-dark surface-dark">
        <div class="unis">
          <div class="head unis__head">
            <Eyebrow tone="gold">{content.forUniversities.eyebrow}</Eyebrow>
            <h2 class="heading-section" id="universities-heading">
              {content.forUniversities.heading}
            </h2>
            <p class="lead-soft">{content.forUniversities.body}</p>
          </div>

          <div class="seminar">
            <h3 class="heading-card seminar__title">{content.forUniversities.seminarHeading}</h3>
            <p class="seminar__body">{content.forUniversities.seminarBody}</p>
            <ul class="checklist seminar__list">
              {content.forUniversities.seminarPoints.map((point) => <li>{point}</li>)}
            </ul>
            <p class="seminar__cta">
              <Button href={`${getPath('partners', locale)}#partner-form`} variant="pill" arrow>
                {content.forUniversities.ctaLabel}
              </Button>
            </p>
          </div>
        </div>
      </div>
    </section>

    {
      /* ── I corsi di lingua ──────────────────────────────────────────────
        Il ponte che mostra l'ecosistema a 360°. Le sette lingue sono
        esattamente quelle dell'analisi: l'italiano NON è nell'elenco e non
        va aggiunto per deduzione. */
    }
    <section class="wrap band" aria-labelledby="languages-heading">
      <div class="panel-soft langs">
        <div class="langs__text">
          <Eyebrow>{content.languageCourses.eyebrow}</Eyebrow>
          <h2 class="heading-section langs__title" id="languages-heading">
            {content.languageCourses.heading}
          </h2>
          <p class="langs__body">{content.languageCourses.body}</p>
          <p class="langs__cta">
            <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" variant="pill" arrow>
              {content.languageCourses.ctaLabel}
            </Button>
          </p>
        </div>

        <div class="langs__list">
          <p class="langs__label">{content.languageCourses.languagesLabel}</p>
          {/* Pastiglie e non elenco puntato: sette voci brevi lette come
              catalogo, che è quello che sono. */}
          <ul class="chips">
            {content.languageCourses.languages.map((language) => <li class="chip">{language}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {
      /* ── Conversione ────────────────────────────────────────────────────
        Per chi ha scrollato tutto senza cliccare nessun box: molto
        interessato, ma non si è riconosciuto in nessuna delle quattro
        caselle. `surveyNote` cita il sondaggio preliminare, che è ciò che
        distingue questa consulenza da una call di vendita. */
    }
    <section class="wrap band" aria-labelledby="cta-heading">
      <div class="finalcta surface-panel">
        <Eyebrow tone="blank">{content.finalCta.eyebrow}</Eyebrow>
        <h2 class="heading-section finalcta__title" id="cta-heading">{content.finalCta.heading}</h2>
        <p class="finalcta__body">{content.finalCta.body}</p>
        <p class="finalcta__actions">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" size="lg" arrow>
            {content.finalCta.ctaLabel}
          </Button>
        </p>
        <p class="finalcta__note">{content.finalCta.surveyNote}</p>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  /* Il fondo bianco vale per tutta la pagina, non solo per le sezioni: il
     <body> del sistema originale è navy e si vedrebbe agli estremi. */
  .home {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────
     Centrato e a colonna sola: senza illustrazione accanto, un titolo di
     questa misura spinto a sinistra lascerebbe mezza pagina vuota — ed è il
     difetto già corretto altrove. Qui serve anche a un secondo scopo: il
     primo evento visivo della home devono essere i quattro box. */
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 2.5vw, 2rem);
  }
  .hero__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    max-width: 60rem;
    margin-inline: auto;
  }
  .hero__title {
    margin-top: 1.4rem;
    max-width: 22ch;
  }
  .hero__lead {
    margin-top: 1.3rem;
    max-width: 62ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }
  .hero__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 1.15rem;
  }

  /* ── Fasce e intestazioni ─────────────────────────────────────────────── */
  .band {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  /* L'ancora del bottone primario dell'hero: l'header è sticky e senza questo
     margine la fascia finirebbe sotto la barra. */
  #routing {
    scroll-margin-top: 6rem;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .head .lead-soft {
    max-width: none;
  }
  .heading-section + p {
    margin-top: 0.75rem;
  }

  /* ── Il bivio ─────────────────────────────────────────────────────────── */
  .routes,
  .strengths,
  .hurdles {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Base larga apposta: con quattro box una base stretta ne metterebbe tre in
     fila e uno solo sotto, largo il triplo. Due e due sta insieme, e a schermo
     grande i quattro entrano comunque in riga. */
  .route {
    flex: 1 1 min(100%, 21rem);
    min-width: min(100%, 21rem);
  }
  .route__title {
    margin-top: 1.15rem;
  }
  .route__body {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }
  .route__cta {
    margin-top: 1.5rem;
  }

  /* ── I superpoteri ────────────────────────────────────────────────────── */
  .strength {
    flex: 1 1 min(100%, 19rem);
    min-width: min(100%, 19rem);
  }
  .strength__title {
    margin-top: 1.15rem;
  }
  .strength__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }

  /* ── Zero burocrazia ──────────────────────────────────────────────────── */
  .hurdle {
    flex: 1 1 min(100%, 19rem);
    min-width: min(100%, 19rem);
  }
  .hurdle__title {
    margin-top: 1.15rem;
  }
  .hurdle__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }

  /* Il limite dichiarato: bordo d'accento e corpo pieno, non una postilla in
     corpo 10. Dire cosa NON si può fare è ciò che rende credibile il blocco
     qui sopra — e su una promessa burocratica è anche l'unica versione che
     non fa arrivare lo studente con un fascicolo respinto. */
  .limit {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.35rem, 2.6vw, 1.9rem) clamp(1.35rem, 2.6vw, 2rem);
    border-left: 3px solid var(--color-teal-ink);
    border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
    background-color: var(--color-mist);
    max-width: 78rem;
  }
  .limit__title {
    font-family: var(--font-titling);
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .limit__body {
    margin: 0.7rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--surface-fg-soft);
    max-width: 88ch;
  }
  .limit__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-mist-line);
  }
  .limit__link:hover {
    color: var(--color-teal-ink);
    text-decoration-color: currentColor;
  }

  /* ── Il canale B2B ────────────────────────────────────────────────────── */
  .panel-dark {
    border-radius: var(--radius-2xl);
    padding: clamp(1.75rem, 4vw, 3.25rem);
  }
  .unis {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .unis {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .unis__head {
    margin-bottom: 0;
  }
  /* Scheda chiara dentro la fascia scura: il seminario è l'offerta, e deve
     staccarsi dall'argomento che la precede invece di continuarlo. */
  .seminar {
    background-color: var(--color-panel);
    border: 1px solid var(--color-panel-line);
    border-radius: var(--radius-xl);
    padding: clamp(1.5rem, 2.8vw, 2rem);
  }
  .seminar__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.7rem;
  }
  .seminar__list {
    margin-top: 1.2rem;
  }
  .seminar__cta {
    margin-top: 1.6rem;
  }

  /* ── I corsi di lingua ────────────────────────────────────────────────── */
  .langs {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: center;
  }
  @media (min-width: 60rem) {
    .langs {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
  }
  .langs__title {
    margin-top: 1.1rem;
    max-width: 20ch;
  }
  .langs__body {
    color: var(--surface-fg-muted);
    margin-top: 0.75rem;
  }
  .langs__cta {
    margin-top: 1.6rem;
  }
  .langs__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    padding: 0.5rem 0.95rem;
    background-color: var(--color-blank);
    border: 1px solid var(--color-mist-line);
    border-radius: var(--radius-pill);
    font-family: var(--font-titling);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  /* ── CTA finale ───────────────────────────────────────────────────────── */
  .finalcta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.15rem;
    border-radius: var(--radius-2xl);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .finalcta__title {
    max-width: 24ch;
  }
  .finalcta__body {
    color: var(--surface-fg-muted);
    max-width: 56ch;
  }
  .finalcta__actions {
    margin-top: 0.85rem;
  }
  .finalcta__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    max-width: 60ch;
  }
</style>
