---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getPath, BOOKING_FORM_URL } from '../../i18n/routes';
import { useTranslations, renderEmphasis } from '../../i18n/utils';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import RouteMap from '../../components/illustrations/RouteMap.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';

/**
 * Home ristilata sui riferimenti scelti dal cliente: fondo chiaro, fasce che
 * si separano per campitura invece che per filetto, schede bianche con raggi
 * generosi, pastiglie di sezione, titoli in grottesca geometrica.
 *
 * Due elementi dei riferimenti NON sono stati trasportati, ed è deliberato:
 * le griglie di testimonial e i contatori di clienti. Kimere è nata quest'anno
 * e non li ha; riempirli sarebbe l'invenzione che il progetto vieta e che
 * farebbe leggere il sito come agenzia fantasma (Rischio 1 dell'analisi).
 * Al loro posto, negli stessi punti del layout, stanno fatti verificabili.
 *
 * Questa pagina non usa <Section>: quel componente appartiene al sistema
 * originale (fasce a piena larghezza, superfici scure). Qui le fasce sono
 * blocchi arrotondati dentro il contenitore, e il markup lo dice.
 */
const locale = 'it';
const t = useTranslations(locale);
const { data: content } = await getEntry('homePage', locale)!;

const allPackages = await getCollection('packages', (entry) => entry.id.startsWith(`${locale}/`));
const packages = allPackages.sort((a, b) => a.data.order - b.data.order);

// I tre pilastri seguono le tre fasi reali del percorso, quindi le icone sono
// quelle: fascicolo → scadenza → alloggio. Non icone decorative intercambiabili.
const pillarIcons = ['document', 'calendar', 'house'] as const;
---

<PageLayout
  locale={locale}
  routeKey="home"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
>
  <div class="home surface-blank">
    {/* ── Hero ─────────────────────────────────────────────────────────── */}
    <section class="wrap hero">
      <div class="hero__intro">
        <Eyebrow class="animate-rise">{content.hero.eyebrow}</Eyebrow>
        <h1 class="heading-display hero__title animate-rise" style="animation-delay:60ms">
          {content.hero.headline}
        </h1>
        <p class="lead-soft hero__lead animate-rise" style="animation-delay:120ms">
          {content.hero.subhead}
        </p>
        <div class="hero__actions animate-rise" style="animation-delay:180ms">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" variant="pill" size="lg" arrow>
            {content.hero.ctaPrimary}
          </Button>
        </div>
        <p class="hero__note animate-rise" style="animation-delay:240ms">
          {t.cta.freeNoObligation}
        </p>
      </div>

      {
        /* Metà dell'hero è il percorso: il visitatore lo VEDE nei primi secondi
          invece di leggere che esiste. È il principio della direzione «Rotta»,
          e nei riferimenti occupa esattamente questo posto — con la differenza
          che lì è una fotografia, qui è l'informazione che vende. */
      }
      <div class="hero__media animate-rise" style="animation-delay:300ms">
        <RouteMap
          locale={locale}
          variant="modern"
          title={content.processPreview.heading}
          pivot={content.processPreview.pivot}
          stopsBefore={content.processPreview.stopsBefore}
          stopsAfter={content.processPreview.stopsAfter}
        />
      </div>
    </section>

    {/* ── Il labirinto ─────────────────────────────────────────────────── */}
    <section class="wrap band" aria-labelledby="scale-heading">
      <div class="panel-soft band__inner">
        <div class="band__head">
          <Eyebrow>{content.problemScale.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="scale-heading">{content.problemScale.heading}</h2>
          <p class="lead-soft">{content.problemScale.body}</p>
        </div>

        <ul class="stats">
          {
            content.problemScale.stats.map((stat) => (
              <li class="card-soft stat">
                <span class="stat__value">{stat.value}</span>
                <span class="stat__label">{stat.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ── Il perimetro, in tre blocchi ─────────────────────────────────── */}
    <section class="wrap block" aria-labelledby="whatwedo-heading">
      <div class="block__head">
        <Eyebrow>{content.whatWeDo.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="whatwedo-heading">{content.whatWeDo.heading}</h2>
        <p class="lead-soft">{content.whatWeDo.body}</p>
      </div>

      <ul class="pillars">
        {
          content.whatWeDo.pillars.map((pillar, index) => (
            <li class="card-soft pillar">
              <span class="icon-badge">
                <StepIcon name={pillarIcons[index] ?? 'compass'} size={26} />
              </span>
              <h3 class="heading-card pillar__title">{pillar.title}</h3>
              <p class="pillar__body">{pillar.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ── I tre livelli. Anticipa Services, non la duplica. ─────────────── */}
    <section class="wrap block" aria-labelledby="levels-heading">
      <div class="block__head">
        <Eyebrow>{content.packagesPreview.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="levels-heading">{content.packagesPreview.heading}</h2>
        <p class="lead-soft">{content.packagesPreview.body}</p>
      </div>

      <ul class="levels">
        {
          packages.map((pkg) => (
            <li class="card-soft level">
              <h3 class="heading-card level__name">{pkg.data.name}</h3>
              <p class="level__tagline">{pkg.data.tagline}</p>

              <p class="level__coverage">
                <span class="level__coverage-key">{t.packages.included}</span>
                {pkg.data.coverage}
              </p>
              {/* Il copy EN marca i termini burocratici italiani con *asterischi*
                  (docs/glossary.md): senza renderEmphasis finirebbero a video così. */}
              <ul class="checklist level__list">
                {pkg.data.includes.map((item) => (
                  <li set:html={renderEmphasis(item)} />
                ))}
              </ul>

              <p class="level__cta">
                <Button
                  href={BOOKING_FORM_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="pill-ghost"
                  size="sm"
                  arrow
                >
                  {t.cta.bookCall}
                </Button>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    {/* ── Che cosa succede dopo il bottone ─────────────────────────────── */}
    <section class="wrap band" aria-labelledby="how-heading">
      <div class="panel-soft band__inner">
        <div class="band__head">
          <Eyebrow>{content.howItWorks.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="how-heading">{content.howItWorks.heading}</h2>
          <p class="lead-soft">{content.howItWorks.body}</p>
        </div>

        {
          /* <ol> e non <ul>: qui l'ordine È l'informazione. Il numero è scritto
            nel markup e non generato da CSS, così chi usa uno screen reader lo
            sente come parte del passo invece di perderlo. */
        }
        <ol class="steps">
          {
            content.howItWorks.steps.map((step, index) => (
              <li class="card-soft step">
                <div class="step__top">
                  <span class="icon-badge">
                    <StepIcon name={step.icon} size={26} />
                  </span>
                  <span class="step__num">{String(index + 1).padStart(2, '0')}</span>
                </div>
                <h3 class="heading-card step__title">{step.title}</h3>
                <p class="step__body">{step.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {
      /* ── L'obiezione, disinnescata prima che si formi ────────────────────
        Nessun logo, per scelta: il marchio di un ministero su un sito
        commerciale comunica un accreditamento che non esiste, e per gli enti
        pubblici è uso non autorizzato di segni dello Stato. I nomi in chiaro
        con il link ufficiale dicono la stessa cosa — e reggono la verifica
        del genitore che finanzia, che è esattamente chi va a controllare. */
    }
    <section class="wrap block" aria-labelledby="trust-heading">
      <div class="block__head trust__head">
        <Eyebrow>{content.trustBuilding.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="trust-heading">{content.trustBuilding.heading}</h2>
        <p class="lead-soft">{content.trustBuilding.body}</p>
      </div>

      <ul class="institutions">
        {
          content.trustBuilding.institutions.map((org) => (
            <li class="card-soft institution">
              <p class="institution__name" translate="no">
                {org.name}
              </p>
              <p class="institution__authority">{org.authority}</p>
              <p class="institution__role">{org.role}</p>
              {/* rel="noopener": il link apre un dominio pubblico in una nuova
                  scheda e non deve poter toccare questa. */}
              <a class="institution__link" href={org.url} target="_blank" rel="noopener noreferrer">
                {t.process.officialSource}
                <svg
                  viewBox="0 0 14 14"
                  width="12"
                  height="12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M5 2h7v7M12 2 3 11" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>

      {
        /* Il disclaimer non è in fondo in corpo 10: sta in evidenza, perché
          dichiarare di NON essere accreditati è ciò che rende credibile tutto
          il blocco sopra — e perché nessuno può promettere l'esito di un visto. */
      }
      <p class="affiliation">{content.trustBuilding.affiliationNote}</p>

      <p class="trust__cta">
        <Button href={getPath('about', locale)} variant="pill" arrow>
          {content.trustBuilding.ctaLabel}
        </Button>
      </p>
    </section>

    {/* ── Conversione ──────────────────────────────────────────────────── */}
    <section class="wrap block" aria-labelledby="cta-heading">
      <div class="finalcta surface-panel">
        <Eyebrow tone="blank">{content.finalCta.eyebrow}</Eyebrow>
        <h2 class="heading-section finalcta__title" id="cta-heading">{content.finalCta.heading}</h2>
        <p class="finalcta__body">{content.finalCta.body}</p>
        <p class="finalcta__actions">
          <Button href={BOOKING_FORM_URL} target="_blank" rel="noopener noreferrer" size="lg" arrow>
            {content.finalCta.ctaLabel}
          </Button>
        </p>
        <p class="finalcta__note">{t.cta.freeNoObligation}</p>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  /* Il fondo bianco vale per tutta la pagina, non solo per le sezioni: il
     <body> del sistema originale è navy e si vedrebbe agli estremi. */
  .home {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) var(--spacing-section);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }
  .hero__title {
    margin-top: 1.4rem;
    max-width: 15ch;
  }
  .hero__lead {
    margin-top: 1.4rem;
    max-width: 48ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }
  .hero__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 1.15rem;
  }


  /* ── Fasce e blocchi ──────────────────────────────────────────────────── */
  .band,
  .block {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  .band__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .band__head,
  .block__head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }
  .block__head {
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  /* Il paragrafo non è più chiuso in un contenitore più stretto della griglia
     che gli sta sotto: usa la stessa larghezza disponibile. */
  .band__head .lead-soft,
  .block__head .lead-soft {
    max-width: none;
  }

  /* Un titolo grande (text-4xl) ha bisogno di più margine sotto di sé di
     quanto ne serva sopra — il `gap` uniforme del contenitore dava lo stesso
     spazio in entrambi i punti, e dopo il titolo si sentiva stretto. Questa
     regola vale per ogni paragrafo che segue un titolo di sezione, quindi
     copre allo stesso modo band__head, block__head, trust__main e finalcta. */
  .heading-section + p {
    margin-top: 0.75rem;
  }

  /* ── Dati ─────────────────────────────────────────────────────────────── */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stat {
    flex: 1 1 min(100%, 15rem);
    min-width: min(100%, 15rem);
    gap: 0.6rem;
  }
  .stat__value {
    font-family: var(--font-titling);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-teal-ink);
  }
  .stat__label {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
  }

  /* ── Pilastri ─────────────────────────────────────────────────────────── */
  .pillars,
  .levels {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pillar {
    flex: 1 1 min(100%, 17rem);
    min-width: min(100%, 17rem);
  }
  .pillar__title {
    margin-top: 1.15rem;
  }
  .pillar__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }

  /* ── Livelli ──────────────────────────────────────────────────────────── */
  .level {
    flex: 1 1 min(100%, 18rem);
    min-width: min(100%, 18rem);
  }
  .level__tagline {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }
  .level__coverage {
    display: grid;
    gap: 0.3rem;
    font-size: var(--text-sm);
    margin-top: 1.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--surface-rule);
  }
  .level__coverage-key {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--surface-accent);
  }
  .level__list {
    flex: 1;
    margin-top: 0.9rem;
  }
  .level__cta {
    margin-top: 1.5rem;
  }

  /* ── Come funziona ────────────────────────────────────────────────────── */
  .steps {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }
  .step {
    flex: 1 1 min(100%, 17rem);
    min-width: min(100%, 17rem);
  }
  .step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  /* Il numero è grande ma tenue: dà il ritmo della sequenza senza rubare la
     scena al titolo del passo, che è l'informazione vera. */
  .step__num {
    font-family: var(--font-titling);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-mist-deep);
  }
  .step__title {
    margin-top: 1.15rem;
  }
  .step__body {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin-top: 0.6rem;
  }

  /* ── Le istituzioni del percorso ──────────────────────────────────────── */
  .trust__head {
    max-width: 54rem;
  }
  .institutions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 1.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .institution {
    flex: 1 1 min(100%, 16rem);
    min-width: min(100%, 16rem);
  }
  /* Il nome dell'ente prende il trattamento che altrove avrebbe avuto il logo:
     grande, in grottesca, stretto di crenatura. È il sostituto tipografico. */
  .institution__name {
    font-family: var(--font-titling);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
    margin: 0;
  }
  .institution__authority {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--surface-accent);
    margin: 0.4rem 0 0;
  }
  .institution__role {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
    margin: 0.95rem 0 0;
    padding-top: 0.95rem;
    border-top: 1px solid var(--surface-rule);
  }
  .institution__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: start;
    margin-top: 1.15rem;
    font-family: var(--font-titling);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-mist-line);
  }
  .institution__link:hover {
    color: var(--color-teal-ink);
    text-decoration-color: currentColor;
  }

  /* Il disclaimer di non affiliazione: bordo d'accento e corpo pieno, non una
     nota a piè di pagina. È ciò che rende credibile l'elenco qui sopra. */
  .affiliation {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.2rem, 2.5vw, 1.75rem);
    border-left: 3px solid var(--color-teal-ink);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    background-color: var(--color-mist);
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--surface-fg-soft);
    max-width: 62rem;
  }
  .trust__cta {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  /* ── CTA finale ───────────────────────────────────────────────────────── */
  /* L'unico blocco scuro della pagina: chiude il percorso e riporta il navy
     del marchio esattamente dove si chiede l'azione. */
  .finalcta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.15rem;
    border-radius: var(--radius-2xl);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .finalcta__title {
    max-width: 26ch;
  }
  .finalcta__body {
    color: var(--surface-fg-muted);
    max-width: 46ch;
  }
  .finalcta__actions {
    margin-top: 0.85rem;
  }
  .finalcta__note {
    font-size: var(--text-sm);
    color: var(--surface-fg-muted);
  }
</style>
