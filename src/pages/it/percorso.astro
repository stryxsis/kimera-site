---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { getPath } from '../../i18n/routes';
import { useTranslations, renderEmphasis } from '../../i18n/utils';

const locale = 'it';
const t = useTranslations(locale);
const { data: content } = await getEntry('processPage', locale)!;

const allSteps = await getCollection('processSteps', (entry) => entry.id.startsWith(`${locale}/`));
const sortedSteps = allSteps.sort((a, b) => a.data.order - b.data.order);
const beforeDeparture = sortedSteps.filter((s) => s.data.phase === 'before-departure');
const afterArrival = sortedSteps.filter((s) => s.data.phase === 'after-arrival');
---

<PageLayout locale={locale} routeKey="process" title={content.intro.heading}>
  <p>{content.intro.body}</p>

  <section aria-labelledby="before-departure-heading">
    <h2 id="before-departure-heading">{content.beforeDeparturePhaseLabel}</h2>
    <ol>
      {
        beforeDeparture.map((step) => (
          <li>
            <h3>{step.data.title}</h3>
            <p set:html={renderEmphasis(step.data.whatHappens)} />
            <dl>
              <dt>{t.process.whoDecides}</dt>
              <dd>{step.data.whoDecides}</dd>
              <dt>{t.process.timing}</dt>
              <dd>{step.data.timing}</dd>
              {step.data.whatCanGoWrong && (
                <>
                  <dt>{t.process.whatCanGoWrong}</dt>
                  <dd>{step.data.whatCanGoWrong}</dd>
                </>
              )}
              <dt>{t.process.whatKimereDoes}</dt>
              <dd set:html={renderEmphasis(step.data.whatKimereDoes)} />
            </dl>
            {step.data.officialSource && (
              <p>
                <a href={step.data.officialSource} rel="noopener">
                  {t.process.officialSource}
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="after-arrival-heading">
    <h2 id="after-arrival-heading">{content.afterArrivalPhaseLabel}</h2>
    <ol>
      {
        afterArrival.map((step) => (
          <li>
            <h3>{step.data.title}</h3>
            <p set:html={renderEmphasis(step.data.whatHappens)} />
            <dl>
              <dt>{t.process.whoDecides}</dt>
              <dd>{step.data.whoDecides}</dd>
              <dt>{t.process.timing}</dt>
              <dd>{step.data.timing}</dd>
              {step.data.whatCanGoWrong && (
                <>
                  <dt>{t.process.whatCanGoWrong}</dt>
                  <dd>{step.data.whatCanGoWrong}</dd>
                </>
              )}
              <dt>{t.process.whatKimereDoes}</dt>
              <dd set:html={renderEmphasis(step.data.whatKimereDoes)} />
            </dl>
            {step.data.officialSource && (
              <p>
                <a href={step.data.officialSource} rel="noopener">
                  {t.process.officialSource}
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <p>
    <small>{content.disclaimer}</small>
  </p>

  <p>
    <a href={getPath('book', locale)}>{content.ctaLabel}</a>
  </p>
</PageLayout>
