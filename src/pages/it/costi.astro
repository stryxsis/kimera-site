---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { getPath } from '../../i18n/routes';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import Badge from '../../components/ui/Badge.astro';

const locale = 'it';
const { data: content } = await getEntry('costsPage', locale)!;
---

<PageLayout locale={locale} routeKey="costs" title={content.intro.heading}>
  <Section surface="light">
    <p class="block-lead">{content.intro.body}</p>
  </Section>

  <Section labelledby="tuition-heading">
    <h2 class="block-heading" id="tuition-heading">{content.tuition.heading}</h2>
    <p class="block-lead">{content.tuition.body}</p>
    <div class="figures">
      <Badge variant="solid">{content.tuition.publicRange}</Badge>
      <Badge variant="solid">{content.tuition.privateRange}</Badge>
    </div>
  </Section>

  <Section surface="light" labelledby="living-heading">
    <h2 class="block-heading" id="living-heading">{content.livingCosts.heading}</h2>
    <p class="block-lead">{content.livingCosts.body}</p>
    <div class="figures">
      <Badge variant="solid">{content.livingCosts.monthlyRange}</Badge>
    </div>
  </Section>

  <Section labelledby="visa-req-heading">
    <h2 class="block-heading" id="visa-req-heading">{content.visaRequirement.heading}</h2>
    <p class="block-lead">{content.visaRequirement.body}</p>
    <div class="figures">
      <Badge variant="solid">{content.visaRequirement.amount}</Badge>
    </div>
  </Section>

  <Section surface="light" labelledby="scholarships-heading">
    <h2 class="block-heading" id="scholarships-heading">{content.scholarships.heading}</h2>
    <p class="block-lead">{content.scholarships.body}</p>
  </Section>

  <Section labelledby="work-heading">
    <h2 class="block-heading" id="work-heading">{content.workWhileStudying.heading}</h2>
    <p class="block-lead">{content.workWhileStudying.body}</p>
    <div class="figures">
      <Badge>{content.workWhileStudying.hoursPerWeek}</Badge>
      <Badge>{content.workWhileStudying.maxHoursPerYear}</Badge>
    </div>
  </Section>

  <Section surface="light" labelledby="health-heading">
    <h2 class="block-heading" id="health-heading">{content.healthCoverage.heading}</h2>
    <p class="block-lead">{content.healthCoverage.body}</p>
    <div class="figures">
      <Badge variant="solid">{content.healthCoverage.annualCost}</Badge>
    </div>
  </Section>

  <Section labelledby="after-heading">
    <h2 class="block-heading" id="after-heading">{content.afterGraduation.heading}</h2>
    <p class="block-lead">{content.afterGraduation.body}</p>
  </Section>

  <Section surface="light" size="lg">
    <div class="closing-cta">
      <p class="closing-cta__note">{content.disclaimer}</p>
      <Button href={getPath('book', locale)}>{content.ctaLabel}</Button>
    </div>
  </Section>
</PageLayout>

<style>
  /* Le cifre indicative come badge, non come corsivo nel paragrafo: sono il
     dato che risponde davvero alla domanda "quanto mi costa" — devono
     fermare l'occhio. Oro (solid) per le cifre di spesa, accento di
     superficie per il tetto delle ore lavorabili (non è un costo). */
  .figures {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
</style>
