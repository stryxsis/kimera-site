---
import PageLayout from '../../layouts/PageLayout.astro';
import { getEntry } from 'astro:content';
import { getPath } from '../../i18n/routes';
import { useTranslations } from '../../i18n/utils';
import { sortedCountryOptions } from '../../lib/countries';
import { describedBy } from '../../lib/field';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Field from '../../components/ui/Field.astro';
import Input from '../../components/ui/Input.astro';
import ChoiceGroup from '../../components/ui/ChoiceGroup.astro';
import StepIcon from '../../components/illustrations/StepIcon.astro';
import CorridorFlow from '../../components/illustrations/CorridorFlow.astro';
import HandoverDiagram from '../../components/illustrations/HandoverDiagram.astro';
import MultiStepForm from '../../components/forms/MultiStepForm.astro';

/**
 * Partner B2B — l'unica pagina del sito che non parla allo studente. Il lettore
 * dirige un'agenzia di reclutamento estera o un ufficio international: legge
 * volumi, rischio e margine, e ha già respinto una dozzina di partner di
 * destinazione prima di arrivare qui. Qui Kimere smette di rassicurare.
 *
 * Cinque cose da non dimenticare quando si torna su questo file.
 *
 * PRIMA: il seminario gratuito è il blocco dominante, ed è l'unico su campo
 * navy insieme al modulo. È il lead magnet dichiarato dall'analisi (§5) e lo
 * strumento di chiusura migliore che l'azienda abbia: se un giorno smette di
 * essere la cosa più grande della pagina, la pagina ha perso il suo scopo.
 *
 * SECONDA: NESSUNA percentuale di conversione, da nessuna parte. L'analisi dice
 * che gli atenei privati sono attratti dalle «percentuali di conversione»:
 * quella è la loro motivazione, non un dato che Kimere possieda. L'azienda opera
 * da giugno 2026 e non ha storico — pubblicare un tasso, o anche solo «alte
 * percentuali», sarebbe un numero inventato su una pagina che si legge con il
 * contratto in mano. Si dice cosa si toglie di mezzo, mai quanto rende.
 *
 * TERZA: le due tariffe sono scoperte per decisione esplicita del cliente, e la
 * quota all-inclusive è dichiarata PER L'ITALIA. L'accompagnamento fisico sul
 * territorio non diventa replicabile altrove per decreto: una tariffa unica
 * «per qualsiasi destinazione» si romperebbe alla prima pratica fuori dai
 * confini. `pricing.limits` e `pricing.billingNote` sono obbligatorie.
 *
 * QUARTA: la due diligence sta PRIMA del modulo. Un'agenzia scopre comunque che
 * Kimere opera da giugno 2026 e non ha accreditamenti; scoprirlo da sé dopo tre
 * schermate di promesse ferma la trattativa, leggerlo qui la fa proseguire.
 *
 * QUINTA: nessun operatore terzo è nominato, da nessuna parte, e lo stato
 * d'animo di atenei reali non viene diagnosticato. L'analisi dice che «molte
 * università estere (es. argentine) temono l'Italia»: sul sito il fatto si
 * racconta dal lato di Kimere — la domanda che ci arriva più spesso.
 *
 * Ritmo delle superfici: bianco → bianco/nebbia (i due segmenti) → NAVY (il
 * seminario) → bianco (l'ostacolo) → nebbia (le tariffe) → NAVY (il modulo).
 */
const locale = 'it';
const t = useTranslations(locale);
const { data: content } = await getEntry('partnersPage', locale)!;
const { data: countryNames } = await getEntry('countries', locale)!;
const countries = sortedCountryOptions(countryNames, locale);

/**
 * Form B2B: a differenza di quello studente NON è multi-step — un solo schermo.
 * MultiStepForm riceve un solo `[data-step]` e disattiva da sé la progressione.
 */
const FIELDS = [
  'contact-name',
  'role',
  'agency',
  'country',
  'website',
  'work-email',
  'volume-bracket',
  'destinations-served',
  'interest',
  'notes',
  'privacy-consent',
];
---

<PageLayout
  locale={locale}
  routeKey="partners"
  title={content.hero.headline}
  description={content.hero.subhead}
  bare
  ground="blank"
>
  <div class="partners surface-blank">
    {/* ── Hero: la promessa commerciale ────────────────────────────────── */}
    <section class="wrap hero">
      <div class="hero__intro">
        <Eyebrow class="animate-rise">{content.hero.eyebrow}</Eyebrow>
        <h1 class="heading-display hero__title animate-rise" style="animation-delay:60ms">
          {content.hero.headline}
        </h1>
        <p class="lead-soft hero__lead animate-rise" style="animation-delay:120ms">
          {content.hero.subhead}
        </p>
        <div class="hero__actions animate-rise" style="animation-delay:180ms">
          <Button href="#partner-form" variant="pill" size="lg" arrow>
            {content.hero.ctaPrimary}
          </Button>
          <Button href="#pricing" variant="pill-ghost" size="lg">
            {content.hero.ctaSecondary}
          </Button>
        </div>
      </div>

      {/* ILL-09 — decorazione: sotto le 64rem sparisce invece di schiacciarsi,
          e non si perde nessuna informazione perché non ne porta. */}
      <div class="hero__art animate-rise" style="animation-delay:240ms">
        <CorridorFlow />
      </div>
    </section>

    {
      /* ── I due interlocutori ────────────────────────────────────────────
        Metà per gli atenei e metà per le agenzie, e volutamente asimmetriche:
        per l'ateneo l'approfondimento è il seminario qui sotto, quindi qui
        bastano tre argomenti e un rimando; per l'agenzia serve invece tutto
        il modello commerciale — il confine disegnato, gli impegni per
        iscritto e la sequenza con cui si comincia. */
    }
    <section class="wrap band" id="segments" aria-labelledby="segments-heading">
      <div class="head">
        <Eyebrow>{content.segments.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="segments-heading">{content.segments.heading}</h2>
        <p class="lead-soft">{content.segments.body}</p>
      </div>

      {/* Atenei */}
      <div class="segment" id="universities" aria-labelledby="universities-heading">
        <div class="segment__head">
          <Eyebrow tone="solid">{content.segments.universities.eyebrow}</Eyebrow>
          <h3 class="heading-section segment__title" id="universities-heading">
            {content.segments.universities.heading}
          </h3>
          <p class="segment__body">{content.segments.universities.body}</p>
        </div>

        <ul class="cards">
          {
            content.segments.universities.points.map((point) => (
              <li class="card-soft card">
                <span class="icon-badge">
                  <StepIcon name={point.icon} size={26} />
                </span>
                <h4 class="heading-card card__title">{point.title}</h4>
                <p class="card__body">{point.body}</p>
              </li>
            ))
          }
        </ul>

        <div class="segment__action">
          <Button href="#seminar" variant="pill" arrow>
            {content.segments.universities.ctaLabel}
          </Button>
        </div>
      </div>

      {/* Agenzie */}
      <div class="segment panel-soft" id="agencies" aria-labelledby="agencies-heading">
        <div class="segment__head">
          <Eyebrow tone="solid">{content.segments.agencies.eyebrow}</Eyebrow>
          <h3 class="heading-section segment__title" id="agencies-heading">
            {content.segments.agencies.heading}
          </h3>
          <p class="segment__body">{content.segments.agencies.body}</p>
        </div>

        <HandoverDiagram
          theirTitle={content.segments.agencies.handover.theirLabel}
          theirItems={content.segments.agencies.handover.theirItems}
          handover={content.segments.agencies.handover.handoverLabel}
          ourTitle={content.segments.agencies.handover.ourLabel}
          ourItems={content.segments.agencies.handover.ourItems}
        />

        {
          /* Gli impegni stanno attaccati al diagramma, non in fondo alla
            pagina: sono la risposta all'obiezione che il diagramma stesso
            solleva, cioè «che cosa impedisce che ci portiate via il cliente». */
        }
        <div class="commitments">
          <h4 class="heading-card commitments__title">
            {content.segments.agencies.commitmentsHeading}
          </h4>
          <ul class="checklist commitments__list">
            {content.segments.agencies.commitments.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        {
          /* `startstep` e non `step`: quest'ultima è una classe globale che
            azzera i <fieldset> del modulo più in basso nella stessa pagina, e
            lo scope di Astro non le terrebbe separate. */
        }
        <div class="start">
          <h4 class="heading-card start__title">{content.segments.agencies.startHeading}</h4>
          <ol class="startsteps">
            {
              content.segments.agencies.steps.map((step, index) => (
                <li class="startstep">
                  <div class="startstep__marker">
                    <span class="startstep__num">{String(index + 1).padStart(2, '0')}</span>
                    <h5 class="heading-card startstep__title">{step.title}</h5>
                  </div>
                  <p class="startstep__body">{step.body}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="segment__action">
          <Button href="#pricing" variant="pill" arrow>
            {content.segments.agencies.ctaLabel}
          </Button>
        </div>
      </div>
    </section>

    {
      /* ── Il seminario gratuito ──────────────────────────────────────────
        Il blocco più importante della pagina, e l'unico che deve pesare come
        pesa una hero. È il lead magnet dell'analisi (§5): campo navy pieno,
        titolo grande, la sequenza a numeri e una sola azione in fondo. */
    }
    <section class="wrap band" id="seminar" aria-labelledby="seminar-heading">
      <div class="lead-magnet surface-dark">
        <div class="lead-magnet__top">
          <div class="lead-magnet__intro">
            <Eyebrow tone="gold">{content.seminar.eyebrow}</Eyebrow>
            <h2 class="heading-display lead-magnet__title" id="seminar-heading">
              {content.seminar.heading}
            </h2>
            <p class="lead-soft lead-magnet__lead">{content.seminar.body}</p>
          </div>

          <ul class="checklist lead-magnet__points">
            {content.seminar.points.map((point) => <li>{point}</li>)}
          </ul>
        </div>

        <div class="lead-magnet__how">
          <h3 class="heading-card lead-magnet__how-title">{content.seminar.stepsHeading}</h3>
          <ol class="seminarsteps">
            {
              content.seminar.steps.map((step, index) => (
                <li class="seminarstep">
                  <span class="seminarstep__num">{String(index + 1).padStart(2, '0')}</span>
                  <h4 class="heading-card seminarstep__title">{step.title}</h4>
                  <p class="seminarstep__body">{step.body}</p>
                </li>
              ))
            }
          </ol>
        </div>

        <div class="lead-magnet__foot">
          <Button href="#partner-form" size="lg" arrow>{content.seminar.ctaLabel}</Button>
          <p class="lead-magnet__note">{content.seminar.note}</p>
        </div>
      </div>
    </section>

    {
      /* ── L'ostacolo Italia ──────────────────────────────────────────────
        Ogni cifra qui è una che «Perché l'Italia» già dichiara con la sua
        fonte. I conteggi di studenti internazionali e di corsi disponibili
        erano già stati esclusi da quella pagina perché non verificabili, e un
        dato che non regge su una pagina B2B non è un'imprecisione: è la fine
        della trattativa. Ogni paura porta accanto la risposta operativa —
        una paura da sola sarebbe soltanto un ostacolo in più. */
    }
    <section class="wrap band" id="obstacle" aria-labelledby="obstacle-heading">
      <div class="head">
        <Eyebrow>{content.obstacle.eyebrow}</Eyebrow>
        <h2 class="heading-section" id="obstacle-heading">{content.obstacle.heading}</h2>
        <p class="lead-soft">{content.obstacle.body}</p>
      </div>

      <ul class="metrics">
        {
          content.obstacle.metrics.map((metric) => (
            <li class="metric">
              <span class="metric__value">{metric.value}</span>
              <span class="metric__label">{metric.label}</span>
            </li>
          ))
        }
      </ul>

      <ul class="cards fears">
        {
          content.obstacle.fears.map((fear) => (
            <li class="card-soft card">
              <span class="icon-badge">
                <StepIcon name={fear.icon} size={26} />
              </span>
              <h3 class="heading-card card__title">{fear.title}</h3>
              <p class="card__body">{fear.body}</p>
              <p class="answer">
                <span class="answer__key">{content.obstacle.answerLabel}</span>
                {fear.answer}
              </p>
            </li>
          ))
        }
      </ul>

      <p class="links">
        <a class="link" href={getPath('studyInItaly', locale)}>{content.obstacle.linkLabel}</a>
        <a
          class="link"
          href={content.obstacle.officialSource}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.process.officialSource}
          <svg
            viewBox="0 0 14 14"
            width="12"
            height="12"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M5 2h7v7M12 2 3 11"></path>
          </svg>
        </a>
      </p>
    </section>

    {
      /* ── Le tariffe ─────────────────────────────────────────────────────
        Scoperte per decisione del cliente. La nota sulla fatturazione e i
        limiti stanno DENTRO questo blocco, non in fondo alla pagina: chi
        legge un listino decide qui, e quello che una tariffa non compra deve
        stare accanto alla tariffa. */
    }
    <section class="wrap band" id="pricing" aria-labelledby="pricing-heading">
      <div class="panel-soft">
        <div class="head">
          <Eyebrow>{content.pricing.eyebrow}</Eyebrow>
          <h2 class="heading-section" id="pricing-heading">{content.pricing.heading}</h2>
          <p class="lead-soft">{content.pricing.body}</p>
        </div>

        <ul class="plans">
          {
            content.pricing.plans.map((plan) => (
              <li class="card-soft plan">
                <p class="plan__name">{plan.name}</p>
                <p class="plan__price">{plan.price}</p>
                <p class="plan__unit">{plan.priceUnit}</p>
                <p class="plan__body">{plan.body}</p>

                <h3 class="plan__includes-title">{plan.includesHeading}</h3>
                <ul class="checklist plan__includes">
                  {plan.includes.map((item) => <li>{item}</li>)}
                </ul>

                <p class="plan__note">{plan.note}</p>
                {
                  /* Il rimando alla tariffa pubblica sta solo sotto il piano
                    dell'ateneo: è ciò che rende verificabile lo sconto invece
                    di lasciarlo come affermazione. */
                }
                {
                  plan.audience === 'university' && (
                    <a class="plan__compare" href={`${getPath('forStudents', locale)}#pricing`}>
                      {content.pricing.compareLabel}
                    </a>
                  )
                }
              </li>
            ))
          }
        </ul>

        <p class="billing">{content.pricing.billingNote}</p>

        <div class="limits">
          <h3 class="limits__title">{content.pricing.limitsHeading}</h3>
          <ul class="checklist checklist--negative limits__list">
            {content.pricing.limits.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {/* ── Due diligence, prima del modulo ───────────────────────────────── */}
    <section class="wrap band" aria-labelledby="diligence-heading">
      <div class="diligence">
        <h2 class="diligence__title" id="diligence-heading">{content.dueDiligence.heading}</h2>
        <ul class="checklist checklist--negative diligence__list">
          {content.dueDiligence.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    {
      /* ── Il modulo ──────────────────────────────────────────────────────
        Un professionista non compila lo stesso modulo di uno studente: questo
        chiede agenzia, paese, sito e volume annuo, cioè quanto basta a
        qualificare l'interlocutore prima di fissare una riunione. Il campo
        «cosa state cercando» ha il seminario gratuito come prima opzione:
        è la stessa porta per le due conversazioni, e la sceglie chi scrive. */
    }
    <section class="wrap band" id="partner-form" aria-labelledby="partner-form-heading">
      <div class="formband surface-panel">
        <div class="formband__head">
          <Eyebrow tone="blank">{content.form.eyebrow}</Eyebrow>
          <h2 class="heading-section formband__title" id="partner-form-heading">
            {content.form.heading}
          </h2>
          <p class="formband__body">{content.form.body}</p>
        </div>

        <div class="formband__form">
          <MultiStepForm
            name="partner-enquiry"
            action={getPath('thankYou', locale)}
            submitLabel={content.form.ctaLabel}
            fields={FIELDS}
            labels={t.form}
          >
            <fieldset class="step" data-step>
              <legend class="sr-only">{content.form.heading}</legend>

              <Field id="contact-name" label={t.partnerForm.contactName} required>
                <Input
                  id="contact-name"
                  name="contact-name"
                  required
                  describedBy={describedBy('contact-name', { error: true })}
                />
              </Field>

              <Field id="role" label={t.partnerForm.role} required>
                <Input
                  id="role"
                  name="role"
                  required
                  describedBy={describedBy('role', { error: true })}
                />
              </Field>

              <Field id="agency" label={t.partnerForm.agency} required>
                <Input
                  id="agency"
                  name="agency"
                  required
                  describedBy={describedBy('agency', { error: true })}
                />
              </Field>

              <Field id="country" label={t.partnerForm.country} required>
                <Input
                  as="select"
                  id="country"
                  name="country"
                  required
                  describedBy={describedBy('country', { error: true })}
                >
                  <option value=""></option>
                  {countries.map(([code, label]) => <option value={code}>{label}</option>)}
                </Input>
              </Field>

              {/* Il sito aziendale è il campo che qualifica più in fretta di
                  ogni altro: dieci secondi di verifica dicono se l'agenzia
                  esiste davvero e su che mercati lavora. */}
              <Field id="website" label={t.partnerForm.website} optionalLabel={t.form.optional}>
                <Input
                  id="website"
                  name="website"
                  type="url"
                  placeholder={t.partnerForm.websitePlaceholder}
                />
              </Field>

              <Field id="work-email" label={t.partnerForm.workEmail} required>
                <Input
                  id="work-email"
                  name="work-email"
                  type="email"
                  required
                  describedBy={describedBy('work-email', { error: true })}
                />
              </Field>

              <Field id="volume-bracket" label={t.partnerForm.volumeBracket} required>
                <Input
                  as="select"
                  id="volume-bracket"
                  name="volume-bracket"
                  required
                  describedBy={describedBy('volume-bracket', { error: true })}
                >
                  <option value=""></option>
                  <option value="under-10">{t.partnerForm.volumeBracketOptions.under10}</option>
                  <option value="10-50">{t.partnerForm.volumeBracketOptions.from10to50}</option>
                  <option value="50-200">{t.partnerForm.volumeBracketOptions.from50to200}</option>
                  <option value="over-200">{t.partnerForm.volumeBracketOptions.over200}</option>
                </Input>
              </Field>

              <Field
                id="destinations-served"
                label={t.partnerForm.destinationsServed}
                optionalLabel={t.form.optional}
              >
                <Input
                  id="destinations-served"
                  name="destinations-served"
                  placeholder={t.partnerForm.destinationsServedPlaceholder}
                />
              </Field>

              <ChoiceGroup
                id="interest"
                name="interest"
                legend={t.partnerForm.interest}
                required
                options={[
                  {
                    value: 'free-seminar',
                    label: t.partnerForm.interestOptions.freeSeminar,
                  },
                  {
                    value: 'students-to-italy',
                    label: t.partnerForm.interestOptions.studentsToItaly,
                  },
                  {
                    value: 'structured-partnership',
                    label: t.partnerForm.interestOptions.structuredPartnership,
                  },
                  { value: 'other', label: t.partnerForm.interestOptions.other },
                ]}
              />

              <Field id="notes" label={t.partnerForm.notes} optionalLabel={t.form.optional}>
                <Input
                  as="textarea"
                  id="notes"
                  name="notes"
                  placeholder={t.partnerForm.notesPlaceholder}
                />
              </Field>

              <label class="consent-field">
                <input type="checkbox" name="privacy-consent" required />
                <span>
                  {t.form.privacyConsentPrefix}
                  <a href={getPath('privacy', locale)}>{t.form.privacyConsentLink}</a>.
                </span>
              </label>
            </fieldset>
          </MultiStepForm>
        </div>
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .partners {
    padding-bottom: var(--spacing-section-lg);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 2.5vw, 2rem);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }
  .hero__title {
    margin-top: 1.4rem;
    max-width: 20ch;
  }
  .hero__lead {
    margin-top: 1.3rem;
    max-width: 58ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }
  /* Il corridoio è decorazione: sotto le 64rem non c'è la seconda colonna e
     sparisce, invece di aggiungere un blocco muto sopra il resto. */
  .hero__art {
    display: none;
  }
  @media (min-width: 64rem) {
    .hero__art {
      display: block;
    }
  }

  /* ── Fasce e intestazioni ─────────────────────────────────────────────── */
  .band {
    padding-block: clamp(1rem, 2.5vw, 2rem);
  }
  /* Le ancore interne: l'header è fisso e senza questo margine la fascia
     finirebbe sotto la barra. */
  #segments,
  #seminar,
  #pricing,
  #partner-form {
    scroll-margin-top: 6rem;
  }
  .head {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    margin-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }
  .head .lead-soft {
    max-width: none;
  }
  .heading-section + p {
    margin-top: 0.75rem;
  }

  /* ── I due segmenti ───────────────────────────────────────────────────
     Il secondo sta su campitura nebbia e il primo no: sono due conversazioni
     diverse e devono leggersi come due blocchi, non come un elenco unico. */
  .segment + .segment {
    margin-top: clamp(2rem, 4vw, 3.25rem);
  }
  .segment.panel-soft {
    padding: clamp(1.5rem, 3.2vw, 2.75rem);
  }
  .segment__head {
    display: grid;
    justify-items: start;
    gap: 1rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .segment__title {
    max-width: 26ch;
  }
  .segment__body {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--surface-fg-muted);
    max-width: 74ch;
    margin: 0;
  }
  .segment__action {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* ── Griglia di schede, condivisa da due sezioni ──────────────────────── */
