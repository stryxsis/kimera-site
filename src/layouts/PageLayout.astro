---
import BaseLayout from './BaseLayout.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { Locale, RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description?: string;
  noindex?: boolean;
  /**
   * `bare` toglie l'intestazione di pagina standard: la pagina disegna da sé il
   * proprio <h1>. Serve alla home, il cui hero è un blocco composito.
   * Resta comunque UN SOLO <h1> per pagina: chi passa `bare` deve fornirlo.
   */
  bare?: boolean;
  eyebrow?: string;
  /** Vedi BaseLayout: il colore sotto a tutto, per l'overscroll e i vuoti. */
  ground?: 'dark' | 'blank';
}

const {
  locale,
  routeKey,
  title,
  description,
  noindex,
  bare = false,
  eyebrow,
  ground,
} = Astro.props;
---

<BaseLayout
  locale={locale}
  routeKey={routeKey}
  title={title}
  description={description}
  noindex={noindex}
  ground={ground}
>
  <SkipLink locale={locale} />
  <Header locale={locale} routeKey={routeKey} />

  <main id="main-content">
    {
      !bare && (
        <div class="page-head surface-dark">
          <div class="wrap page-head__inner">
            {eyebrow && <p class="label">{eyebrow}</p>}
            <h1 class="page-head__title">{title}</h1>
          </div>
        </div>
      )
    }
    <slot />
  </main>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--spacing-section) var(--spacing-section);
  }
  .page-head__inner {
    display: grid;
    gap: 1rem;
  }
  .page-head__title {
    font-size: var(--text-4xl);
    max-width: 20ch;
  }
</style>
