---
import '../styles/global.css';
import { getAlternatePaths, getPath, locales, type Locale, type RouteKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description?: string;
  noindex?: boolean;
  /**
   * Colore di fondo della pagina, sotto a tutto. Non è ridondante rispetto alle
   * superfici delle sezioni: è ciò che si vede nell'overscroll e sotto il footer
   * quando il contenuto è più corto della finestra. Il default navy vale per le
   * pagine del sistema originale; le pagine ristilate passano `blank`.
   */
  ground?: 'dark' | 'blank';
}

const { locale, routeKey, title, description, noindex = false, ground = 'dark' } = Astro.props;

const alternates = getAlternatePaths(routeKey);
const canonicalPath = getPath(routeKey, locale);
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title translate="no">{title} — Kimere</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={new URL(canonicalPath, Astro.site)} />
    {
      locales.map((loc) => (
        <link rel="alternate" hreflang={loc} href={new URL(alternates[loc], Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />
  </head>
  <body class={ground === 'blank' ? 'ground-blank' : undefined}>
    <slot />
  </body>
</html>

<style is:global>
  body.ground-blank {
    background-color: var(--color-blank);
    color: var(--color-ink);
  }
</style>
